// src/ast.strata - the Strata AST. Part of the compiler CORE (no main; reused by every
// front-end). Follows D--'s "kind tag + fat struct + new_* constructor" style
// (ARCHITECTURE.md sec 4: the AST is the spine, traversed by switch on `kind`).
//
// Strata-specific vs D--'s AST:
//   * no ExNew (arena `.new(T)` and `alloc(v)` are calls resolved by the checker);
//   * StForIn replaces C-style StFor: `for name in iter { }`;
//   * `..` ranges are ExBinary with op "..";
//   * Program carries top-level statements (`main`) as well as decls, because
//     top-level code = the entry point (DESIGN sec 2).
//   * modules: every Decl records which module (file) it came from; Program lists the
//     modules and who imports whom, for the checker's visibility rules.

// ---- types -------------------------------------------------------------

export enum TypeKind { TyNamed, TyArray, TyFixedArray, TyPointer, TyDynArray }

export struct TypeNode {
    TypeKind  kind
    string       name// TyNamed: "int", "vec3", "Entity", ...
    TypeNode* elem// element type (Array / FixedArray / Pointer)
    string       size// TyFixedArray: N as written
    i32       line
    i32       col
}

export TypeNode* new_type(TypeKind k, int line, int col) {
    return alloc(TypeNode{ k, "", null, "", line, col })
}

// ---- expressions -------------------------------------------------------

export enum ExprKind {
    ExIntLit, ExFloatLit, ExStringLit, ExCharLit, ExBoolLit,
    ExName, ExUnary, ExBinary, ExCall, ExField, ExIndex,
    ExArrayLit, ExStructLit,
    ExCast, ExSizeof
}

// Field order matters for size: the small fields (kind, bval, line, col) share the first
// 16 bytes instead of each padding out to 8.
export struct Expr {
    ExprKind  kind
    bool      bval// ExBoolLit value
    i32       line
    i32       col
    string       text// Int/Float raw text; String/Char decoded; Name id; Unary/Binary op
    string       field// ExField: member name
    string       type_name// ExStructLit: struct name
    Expr*     a// Unary operand / Binary lhs / Call callee / Field obj / Index obj
    Expr*     b// Binary rhs / Index index
    Expr*[dynamic]   items// Call args / ArrayLit elems / StructLit args
    TypeNode* type// ExCast target type / ExSizeof operand type
    TypeNode* rtype// resolved type, filled by the checker (null until then)
}

export Expr* new_expr(ExprKind k, int line, int col) {
    Expr*[dynamic] items = []
    return alloc(Expr{ k, false, line, col, "", "", "", null, null, items, null, null })
}

// ---- statements --------------------------------------------------------

export enum StmtKind {
    StBlock, StVar, StReturn, StExprStmt, StAssign,
    StIf, StWhile, StForIn, StRegion, StSwitch, StBreak, StContinue
}

export struct SwitchCase {
    Expr*[dynamic] values// case values; empty => `default`
    Stmt*   body// a StBlock of the case's statements
    bool    is_default
    int     line
    int     col
}

export struct Stmt {
    StmtKind kind
    bool     is_const// StVar
    i32      line
    i32      col
    // StVar
    string        name// StVar name / StForIn loop var / StRegion region name ("" = anon)
    TypeNode*  type// StVar: null => inferred (`var`)
    Expr*      init// StVar initializer (optional)
    // StReturn value / StExprStmt expr
    Expr*      expr
    // StAssign
    Expr*      target
    string        op// "=", "+=", ...
    Expr*      value
    // StIf / StWhile condition
    Expr*      cond
    // StForIn iterable
    Expr*      iter
    // StIf
    Stmt*      then_block
    Stmt*      else_branch// Block or StIf, or null
    // StWhile / StForIn / StRegion body
    Stmt*      body
    // StBlock
    Stmt*[dynamic]    stmts
    // StSwitch
    Expr*        subject
    SwitchCase[dynamic] cases
}

export Stmt* new_stmt(StmtKind k, int line, int col) {
    Stmt*[dynamic]      stmts = []
    SwitchCase[dynamic] cases = []
    return alloc(Stmt{
        k, false, line, col,      // kind, is_const, line, col
        "", null, null,           // name, type, init
        null,                     // expr
        null, "", null,           // target, op, value
        null,                     // cond
        null,                     // iter
        null, null,               // then_block, else_branch
        null,                     // body
        stmts,                    // stmts
        null, cases               // subject, cases
    })
}

// ---- declarations ------------------------------------------------------

export enum DeclKind { DcFunc, DcStruct, DcEnum, DcInclude, DcLink, DcImport, DcGlobal, DcConst }

export struct Param    { string name; TypeNode* type; }
export struct FieldDef { string name; TypeNode* type; }

export struct Decl {
    DeclKind kind
    int      line
    int      col
    string      name// DcFunc / DcStruct / DcEnum
    // DcFunc
    Param[dynamic]    params
    TypeNode*  ret
    Stmt*      body
    // DcStruct
    FieldDef[dynamic] fields
    // DcEnum
    string[dynamic]      members
    // DcInclude (C interop: `import "header.h"` / `import <header.h>`)
    // DcImport  (Strata module: `import gfx.Renderer` -> path "gfx.Renderer")
    string        path
    bool       is_system
    // module system: was this decl `export`ed? (on a DcImport: a re-export)
    bool       is_exported
    int        module// index into Program.modules of the file it was declared in
    // from a `foreign { }` block: defined outside Strata, keeps its exact name. DcFunc: no
    // body; DcStruct / DcConst: `path` is the header that defines it ("": none)
    bool       is_foreign
    // DcGlobal (`global T name = init`): its type is `ret` (null: inferred), `init` its value
    // DcConst  (`const T NAME = init` in a foreign block): the same; uses are replaced by
    //          the value (or, on the C backend with a header, name the header's macro)
    Expr*      init
    // a foreign function's symbol, when it isn't its name (`u8* send(u8* o, u8* s) =
    // "objc_msgSend"`: one C function seen through several Strata signatures); "" = name
    string     link_name
}

export Decl* new_decl(DeclKind k, int line, int col) {
    Param[dynamic]    params  = []
    FieldDef[dynamic] fields  = []
    string[dynamic]      members = []
    return alloc(Decl{
        k, line, col,
        "",                      // name
        params, null, null,      // params, ret, body
        fields,                  // fields
        members,                 // members
        "", false,               // path, is_system
        false,                   // is_exported
        0,                       // module
        false, null,             // is_foreign, init
        ""                       // link_name
    })
}

// A module = one source file. `imports` are the modules it imports directly;
// `reexports` the subset it imports with `export import` (passed on to its importers);
// `visible` is filled in by the checker: every module whose exports this one can see.
export struct Module {
    string          name// module name as imported ("gfx.Renderer"); the root: its file stem
    string          path// file path
    string          file// file name, for diagnostics
    int[dynamic]    imports
    int[dynamic]    reexports
    int[dynamic]    visible
}

// Program = the top-level decls (struct/enum/func) of every module, the top-level
// statement sequence of the root file (the implicit `main`), and the module table.
export struct Program { Decl*[dynamic] decls; Stmt*[dynamic] main; Module[dynamic] modules; }

export Module new_module(string name, string path, string file) {
    int[dynamic] a = []
    int[dynamic] b = []
    int[dynamic] v = []
    return Module{ name, path, file, a, b, v }
}
