//
// src/os/windows.strata - everything about making Windows programs. CORE.
//
// linker.strata calls it for the target OS "windows":
//   1. COFF object files (.o): an assembled ObjFile (asm.strata) written the way Windows
//      tools read it - also what the linker below takes;
//   2. the linker: COFF objects -> a PE executable or dll, imports straight from the
//      DLLs' export tables;
//   3. import libraries for dlls (<name>.dll.a for GNU ld, <name>.lib for MSVC).

import asm      // ObjFile, assemble (the startup stub)
import hashidx
import host     // strata_read_bytes, strata_write_bytes, strata_getenv

// ======== COFF objects ========================================================================
// Writes an assembled ObjFile (asm.strata) as a Windows x64 COFF
// object file (.o / .obj), the format the linker takes.
//
// Layout:  file header (20 bytes) | 3 section headers (.text, .rdata, .data; 40 each) |
//          .text bytes | .rdata bytes | .data bytes | .text and .data relocations (10 each) |
//          symbol table (18 each) | string table (names longer than 8 bytes)
//
// Symbols: the two section symbols first (each with its auxiliary record), then the
// ObjFile's symbols (functions defined here, and those defined elsewhere). A relocation
// is IMAGE_REL_AMD64_REL32 (+ how many immediate bytes follow the field: REL32_1..5) in
// .text, IMAGE_REL_AMD64_ADDR64 in .data.

struct Out { u8[dynamic] b; u8[dynamic] strtab }

void u8put(Out* o, int v) { o.b.push(cast<u8>(v & 255)) }
void u16put(Out* o, int v) { u8put(o, v); u8put(o, v >> 8) }
void u32put(Out* o, int v) { u8put(o, v); u8put(o, v >> 8); u8put(o, v >> 16); u8put(o, v >> 24) }
void zeros(Out* o, int n) { for i in 0..n { u8put(o, 0) } }

// An 8-byte name field: the name itself if it fits, else 0 + its string-table offset.
void name8(Out* o, string name) {
    if name.len <= 8 {
        for i in 0..name.len { u8put(o, cast<int>(name[i])) }
        zeros(o, 8 - name.len)
    } else {
        int off = 4 + o.strtab.len
        for i in 0..name.len { o.strtab.push(cast<u8>(cast<int>(name[i]) & 255)) }
        o.strtab.push(cast<u8>(0))
        u32put(o, 0)
        u32put(o, off)
    }
}

void section_header(Out* o, string name, int size, int data_at, int relocs_at, int nrelocs, int flags) {
    name8(o, name)
    u32put(o, 0)            // virtual size
    u32put(o, 0)            // virtual address
    u32put(o, size)
    if size > 0 { u32put(o, data_at) } else { u32put(o, 0) }
    if nrelocs > 0 { u32put(o, relocs_at) } else { u32put(o, 0) }
    u32put(o, 0)            // line numbers
    if nrelocs > 65535 { u16put(o, 65535) } else { u16put(o, nrelocs) }
    u16put(o, 0)
    u32put(o, flags)
}

void symbol(Out* o, string name, int value, int section, int typ, int cls, int naux) {
    name8(o, name)
    u32put(o, value)
    u16put(o, section)
    u16put(o, typ)
    u8put(o, cls)
    u8put(o, naux)
}

// a section symbol's auxiliary record
void section_aux(Out* o, int size, int nrelocs) {
    u32put(o, size)
    if nrelocs > 65535 { u16put(o, 65535) } else { u16put(o, nrelocs) }
    u16put(o, 0)
    u32put(o, 0)
    u16put(o, 0)
    u8put(o, 0)
    zeros(o, 3)
}

export bool write_coff(string path, ObjFile* f) {
    u8[dynamic] bytes = coff_bytes(f)
    return strata_write_bytes(path, &bytes)
}

// The relocations of one section (1 .text, 3 .data), as COFF records.
void put_relocs(Out* o, ObjFile* f, int section, int count, bool overflow) {
    if overflow { u32put(o, count + 1); u32put(o, 0); u16put(o, 0) }
    for i in 0..f.relocs.len {
        ObjReloc r = f.relocs[i]
        if r.section == section {
            int sym = 6 + r.symbol
            if r.symbol == 0 - 1 { sym = 0 }
            if r.symbol == 0 - 2 { sym = 2 }
            if r.symbol == 0 - 3 { sym = 4 }
            u32put(o, r.offset)
            u32put(o, sym)
            if r.kind == 1 { u16put(o, 1) }           // IMAGE_REL_AMD64_ADDR64
            else { u16put(o, 4 + r.after) }           // IMAGE_REL_AMD64_REL32 (+ 1..5)
        }
    }
}

int count_relocs(ObjFile* f, int section) {
    int n = 0
    for i in 0..f.relocs.len { if f.relocs[i].section == section { n += 1 } }
    return n
}

// The object file's bytes.
export u8[dynamic] coff_bytes(ObjFile* f) {
    u8[dynamic] b = []
    u8[dynamic] st = []
    Out o = Out{ b, st }
    int text_size = f.text.len
    int rdata_size = f.rdata.len
    int data_size = f.data.len
    int text_at = 20 + 40 * 3
    int rdata_at = text_at + text_size
    int data_at = rdata_at + rdata_size
    int trel_at = data_at + data_size
    // more than 65535 relocations: the count moves into an extra first record
    int ntrel = count_relocs(f, 1)
    int ndrel = count_relocs(f, 3)
    bool tover = ntrel > 65535
    bool dover = ndrel > 65535
    int ntrec = ntrel
    if tover { ntrec = ntrel + 1 }
    int ndrec = ndrel
    if dover { ndrec = ndrel + 1 }
    int drel_at = trel_at + 10 * ntrec
    int symtab_at = drel_at + 10 * ndrec
    int nsyms = 6 + f.symbols.len

    // file header
    u16put(&o, 34404)       // 0x8664: x86-64
    u16put(&o, 3)
    u32put(&o, 0)           // timestamp
    u32put(&o, symtab_at)
    u32put(&o, nsyms)
    u16put(&o, 0)           // no optional header
    u16put(&o, 0)

    // .text: code, execute, read; .rdata: initialized data, read; .data: + write (16-aligned)
    int text_flags = 1615855648    // 0x60500020
    if tover { text_flags = text_flags | 16777216 }   // IMAGE_SCN_LNK_NRELOC_OVFL
    int data_flags = 3226468416    // 0xC0500040
    if dover { data_flags = data_flags | 16777216 }
    section_header(&o, ".text", text_size, text_at, trel_at, ntrec, text_flags)
    section_header(&o, ".rdata", rdata_size, rdata_at, 0, 0, 1079001152)   // 0x40500040
    section_header(&o, ".data", data_size, data_at, drel_at, ndrec, data_flags)

    for i in 0..text_size { o.b.push(f.text[i]) }
    for i in 0..rdata_size { o.b.push(f.rdata[i]) }
    for i in 0..data_size { o.b.push(f.data[i]) }
    put_relocs(&o, f, 1, ntrel, tover)
    put_relocs(&o, f, 3, ndrel, dover)

    // symbols: the sections (static, with aux records), then the program's
    symbol(&o, ".text", 0, 1, 0, 3, 1)
    section_aux(&o, text_size, ntrel)
    symbol(&o, ".rdata", 0, 2, 0, 3, 1)
    section_aux(&o, rdata_size, 0)
    symbol(&o, ".data", 0, 3, 0, 3, 1)
    section_aux(&o, data_size, ndrel)
    for i in 0..f.symbols.len {
        ObjSymbol s = f.symbols[i]
        int cls = 3
        if s.global { cls = 2 }
        int typ = 0
        if s.section == 1 || s.section == 0 { typ = 32 }   // a function
        symbol(&o, s.name, s.value, s.section, typ, cls, 0)
    }

    // the string table: its size (including these 4 bytes), then the names
    u32put(&o, 4 + o.strtab.len)
    for i in 0..o.strtab.len { o.b.push(o.strtab[i]) }
    return o.b
}

// ======== the linker ==========================================================================
// Strata's linker: COFF object files -> a Windows x64 executable or dll (PE).
//
// What it takes: x86-64 COFF objects (Strata's own, from the COFF writer above, and the runtime's
// lib/srt.o compiled ahead of time). What it does:
//   * merges their sections into .text / .rdata / .data / .bss (by name, `$` suffixes
//     grouped; .drectve, debug info and unwind tables are dropped);
//   * resolves their global symbols; whatever stays undefined is IMPORTED - looked up in
//     the export tables of the DLLs themselves: the system's (msvcrt.dll, kernel32.dll in
//     System32) and those of the libraries the program links (`link "x"`: x.dll or
//     libx.dll, see link_library), so no import libraries are needed. A call to an import
//     goes through a 6-byte jump stub; `__imp_name` is the import's address slot (IAT);
//   * applies the relocations (REL32 and its +1..5 forms, ADDR64, ADDR32NB, ADDR32);
//   * lays the image out at a fixed base (0x140000000: no relocation table) and writes
//     the PE file with its import directory.
// The entry point is `_strata_start` (see startup_asm): it gets argc / argv from
// msvcrt's __getmainargs, calls main and exits through msvcrt's exit (flushing stdio).

// ---- the inputs -----------------------------------------------------------------------------

struct LSec {
    int    obj
    string name
    int    flags
    int    size
    int    raw        // file offset of its bytes (0: none, e.g. .bss)
    int    nrel
    int    relat      // file offset of its relocations
    int    out        // output section: 0 .text, 1 .rdata, 2 .data, 3 .bss; -1 dropped
    int    at         // offset within the output section
}

// per symbol-table index (an auxiliary record is a slot with section -99)
struct LSym { string name; int value; int section; int cls }

struct LObj { string name; u8[dynamic] b; int first; int nsec; LSym[dynamic] syms }

export struct Linker {
    bool             ok
    string           err
    LObj[dynamic]    objs
    LSec[dynamic]    secs
    // global definitions: name -> section (index into secs) + value
    string[dynamic]  gname
    int[dynamic]     gsec
    int[dynamic]     gval
    NameIdx          gidx
    // imports
    string[dynamic]  imp          // function names
    int[dynamic]     imp_dll
    NameIdx          impidx
    // the DLLs (their file names, and where they were found) and their exports
    string[dynamic]  dlls
    string[dynamic]  dll_path
    string[dynamic]  exp_name
    int[dynamic]     exp_dll
    NameIdx          expidx
    bool             exports_loaded
    // layout: per output section
    int[dynamic]     osize
    int[dynamic]     orva
    int[dynamic]     ofile
    int[dynamic]     oraw
    u8[dynamic]      text
    u8[dynamic]      rdata
    u8[dynamic]      data
    int              thunks_at    // offset of the import stubs in .text
    int              imports_at   // offset of the import tables in .rdata
    int              iat_at       // offset of the IAT block in .rdata
    int              iat_size
    int              idt_at
    int              idt_size
    bool             dll          // linking a dll (relocatable: fix64 lists its absolute addresses)
    int[dynamic]     fix64
}

void lk_fail(Linker* l, string msg) {
    if l.ok { l.err = msg }
    l.ok = false
}

int rd16(u8[dynamic] b, int at) { return cast<int>(b[at]) | (cast<int>(b[at + 1]) << 8) }
int rd32(u8[dynamic] b, int at) { return rd16(b, at) | (rd16(b, at + 2) << 16) }
string rdstr(u8[dynamic] b, int at, int max) { return strata_bytes_cstr(&b, at, max) }

export Linker* new_linker() {
    LObj[dynamic] o = []
    LSec[dynamic] s = []
    string[dynamic] gn = []
    int[dynamic] gs = []
    int[dynamic] gv = []
    string[dynamic] im = []
    int[dynamic] id = []
    string[dynamic] dl = []
    string[dynamic] dp = []
    string[dynamic] en = []
    int[dynamic] ed = []
    int[dynamic] a = []
    int[dynamic] b = []
    int[dynamic] c = []
    int[dynamic] d = []
    u8[dynamic] t = []
    u8[dynamic] r = []
    u8[dynamic] dt = []
    int[dynamic] fx = []
    string sys = system_dir()
    dl.push("msvcrt.dll")
    dp.push(sys + "\\msvcrt.dll")
    dl.push("kernel32.dll")
    dp.push(sys + "\\kernel32.dll")
    return alloc(Linker{ true, "", o, s, gn, gs, gv, new_idx(4096), im, id, new_idx(1024), dl, dp, en, ed, new_idx(8192), false,
                         a, b, c, d, t, r, dt, 0, 0, 0, 0, 0, 0, false, fx })
}

// Which output section an input section goes to (-1: dropped).
int out_of(Linker* l, string name, int flags) {
    string base = name
    for i in 0..name.len { if name[i] == '$' && base == name { base = substr(name, 0, i) } }
    if (flags & 2048) != 0 { return 0 - 1 }                 // IMAGE_SCN_LNK_REMOVE
    if base == ".text" { return 0 }
    if base == ".rdata" || base == ".rodata" { return 1 }
    if base == ".data" { return 2 }
    if base == ".bss" { return 3 }
    if base == ".drectve" || base == ".pdata" || base == ".xdata" || base == ".comment" { return 0 - 1 }
    if base.len >= 6 && substr(base, 0, 6) == ".debug" { return 0 - 1 }
    lk_fail(l, "unsupported section " + name)
    return 0 - 1
}

// Add an object file (its bytes).
export void link_add(Linker* l, string name, u8[dynamic] b) {
    if b.len < 20 || rd16(b, 0) != 34404 { lk_fail(l, name + " is not an x86-64 COFF object"); return }
    int nsec = rd16(b, 2)
    int symat = rd32(b, 8)
    int nsym = rd32(b, 12)
    int shat = 20 + rd16(b, 16)
    int strat = symat + 18 * nsym
    int first = l.secs.len
    int oi = l.objs.len
    for k in 0..nsec {
        int h = shat + 40 * k
        string nm = rdstr(b, h, 8)
        if nm.len > 1 && nm[0] == '/' {
            int off = 0
            for q in 1..nm.len { off = off * 10 + (cast<int>(nm[q]) - cast<int>('0')) }
            nm = rdstr(b, strat + off, 4096)
        }
        int flags = rd32(b, h + 36)
        l.secs.push(LSec{ oi, nm, flags, rd32(b, h + 16), rd32(b, h + 20), rd16(b, h + 32), rd32(b, h + 24), out_of(l, nm, flags), 0 })
    }
    LSym[dynamic] syms = []
    int k = 0
    while k < nsym {
        int at = symat + 18 * k
        string nm = ""
        if rd32(b, at) == 0 { nm = rdstr(b, strat + rd32(b, at + 4), 4096) } else { nm = rdstr(b, at, 8) }
        int sec = rd16(b, at + 12)
        if sec >= 32768 { sec = sec - 65536 }
        int naux = cast<int>(b[at + 17])
        syms.push(LSym{ nm, rd32(b, at + 8), sec, cast<int>(b[at + 16]) })
        for q in 0..naux { syms.push(LSym{ "", 0, 0 - 99, 0 }) }
        k = k + 1 + naux
    }
    l.objs.push(LObj{ name, b, first, nsec, syms })
    // its global definitions
    for i in 0..syms.len {
        LSym s = syms[i]
        if s.cls == 2 && s.section > 0 {
            if find_global(l, s.name) >= 0 { lk_fail(l, "'" + s.name + "' is defined twice (" + name + ")") }
            idx_add(&l.gidx, s.name, l.gname.len)
            l.gname.push(s.name)
            l.gsec.push(first + s.section - 1)
            l.gval.push(s.value)
        } else if s.cls == 2 && s.section == 0 && s.value > 0 {
            lk_fail(l, "'" + s.name + "' is a common symbol (compile C with -fno-common)")
        }
    }
}

int find_global(Linker* l, string name) {
    int found = 0 - 1
    int k = idx_first(&l.gidx, name)
    while k >= 0 && found < 0 {
        if l.gname[k] == name { found = k }
        k = idx_next(&l.gidx, k)
    }
    return found
}

int find_import(Linker* l, string name) {
    int found = 0 - 1
    int k = idx_first(&l.impidx, name)
    while k >= 0 && found < 0 {
        if l.imp[k] == name { found = k }
        k = idx_next(&l.impidx, k)
    }
    return found
}

// ---- the DLLs and their exports ------------------------------------------------------------------

string system_dir() {
    string sys = strata_getenv("SystemRoot")
    if sys == "" { sys = "C:\\Windows" }
    return sys + "\\System32"
}

// Is the file at `path` an x86-64 DLL (a PE image for this machine)?
bool is_x64_dll(string path) {
    if !strata_file_exists(path) { return false }
    u8[dynamic] b = strata_read_bytes(path)
    if b.len < 64 || rd16(b, 0) != 23117 { return false }
    int pe = rd32(b, 60)
    return pe > 0 && pe + 6 < b.len && rd32(b, pe) == 17744 && rd16(b, pe + 4) == 34404
}

// The library `name` of a `link "name"`: the DLL it stands for - name.dll or libname.dll
// (MinGW's spelling), looked for in System32, then in `dirs` (a project's lib_dirs), then
// on PATH (where Windows will look for it when the program runs). False if there's none
// (a static library, say): then the C toolchain has to link the program.
export bool link_library(Linker* l, string name, string[dynamic] dirs) {
    string[dynamic] where = []
    where.push(system_dir())
    for i in 0..dirs.len { where.push(dirs[i]) }
    string path = strata_getenv("PATH")
    int start = 0
    for i in 0..path.len + 1 {
        if i == path.len || path[i] == ';' {
            if i > start { where.push(substr(path, start, i - start)) }
            start = i + 1
        }
    }
    string[dynamic] files = []
    files.push(name + ".dll")
    files.push("lib" + name + ".dll")
    for w in 0..where.len {
        for f in 0..files.len {
            string p = where[w] + "\\" + files[f]
            if is_x64_dll(p) {
                bool have = false
                for d in 0..l.dlls.len { if l.dlls[d] == files[f] { have = true } }
                if !have { l.dlls.push(files[f]); l.dll_path.push(p) }
                return true
            }
        }
    }
    return false
}

// RVA -> file offset in a PE file
int rva_to_file(u8[dynamic] b, int rva) {
    int pe = rd32(b, 60)
    int nsec = rd16(b, pe + 6)
    int sh = pe + 24 + rd16(b, pe + 20)
    int r = 0 - 1
    for k in 0..nsec {
        int h = sh + 40 * k
        int va = rd32(b, h + 12)
        int vs = rd32(b, h + 8)
        if vs < rd32(b, h + 16) { vs = rd32(b, h + 16) }
        if rva >= va && rva < va + vs { r = rva - va + rd32(b, h + 20) }
    }
    return r
}

void load_exports(Linker* l) {
    if l.exports_loaded { return }
    l.exports_loaded = true
    for d in 0..l.dlls.len {
        u8[dynamic] b = strata_read_bytes(l.dll_path[d])
        if b.len < 64 { lk_fail(l, "cannot read " + l.dlls[d]) }
        else {
            int pe = rd32(b, 60)
            int opt = pe + 24
            int expdir = rd32(b, opt + 112)   // data directory 0 (PE32+)
            int ed = rva_to_file(b, expdir)
            if ed >= 0 {
                int n = rd32(b, ed + 24)
                int names = rva_to_file(b, rd32(b, ed + 32))
                for i in 0..n {
                    string nm = rdstr(b, rva_to_file(b, rd32(b, names + 4 * i)), 512)
                    idx_add(&l.expidx, nm, l.exp_name.len)
                    l.exp_name.push(nm)
                    l.exp_dll.push(d)
                }
            }
        }
    }
}

// the DLL exporting `name` (-1: none)
int dll_of(Linker* l, string name) {
    load_exports(l)
    int found = 0 - 1
    int k = idx_first(&l.expidx, name)
    while k >= 0 {
        if l.exp_name[k] == name && (found < 0 || l.exp_dll[k] < found) { found = l.exp_dll[k] }
        k = idx_next(&l.expidx, k)
    }
    return found
}

string import_base(string name) {
    if name.len > 6 && substr(name, 0, 6) == "__imp_" { return substr(name, 6, name.len - 6) }
    return name
}

// ---- relocations -----------------------------------------------------------------------------------

int reloc_count(Linker* l, LSec s) {
    if (s.flags & 16777216) != 0 && s.nrel == 65535 { return rd32(l.objs[s.obj].b, s.relat) - 1 }
    return s.nrel
}
int reloc_first(LSec s) {
    if (s.flags & 16777216) != 0 && s.nrel == 65535 { return s.relat + 10 }
    return s.relat
}

// every undefined symbol a kept section refers to becomes an import
void find_imports(Linker* l) {
    for si in 0..l.secs.len {
        LSec s = l.secs[si]
        if s.out >= 0 {
            LObj o = l.objs[s.obj]
            int n = reloc_count(l, s)
            int at = reloc_first(s)
            for r in 0..n {
                int symi = rd32(o.b, at + 10 * r + 4)
                LSym y = o.syms[symi]
                if y.section == 0 && find_global(l, y.name) < 0 && y.name != "__ImageBase" {
                    string base = import_base(y.name)
                    if find_import(l, base) < 0 {
                        int d = dll_of(l, base)
                        if d < 0 { lk_fail(l, "undefined symbol '" + y.name + "' (in " + o.name + ")") }
                        idx_add(&l.impidx, base, l.imp.len)
                        l.imp.push(base)
                        l.imp_dll.push(d)
                    }
                }
            }
        }
    }
}

// ---- layout -----------------------------------------------------------------------------------------

int align_up(int n, int a) { return (n + a - 1) / a * a }

int sec_align(int flags) {
    int a = (flags >> 20) & 15
    if a == 0 { return 16 }
    int r = 1
    for i in 1..a { r = r * 2 }
    return r
}

// the import tables' parts, in .rdata order: IDT, ILTs, IATs (one block), hint/names, DLL names
struct ImpLayout { int idt; int ilt; int iat; int names; int dllnames; int end }

int imports_of(Linker* l, int d) {
    int n = 0
    for i in 0..l.imp.len { if l.imp_dll[i] == d { n += 1 } }
    return n
}

ImpLayout import_layout(Linker* l, int start) {
    int used = 0
    for d in 0..l.dlls.len { if imports_of(l, d) > 0 { used += 1 } }
    int idt = align_up(start, 8)
    int ilt = idt + 20 * (used + 1)
    int slots = 0
    for d in 0..l.dlls.len { int k = imports_of(l, d); if k > 0 { slots += k + 1 } }
    int iat = ilt + 8 * slots
    int names = iat + 8 * slots
    int p = names
    for i in 0..l.imp.len { p = align_up(p + 2 + l.imp[i].len + 1, 2) }
    int dn = p
    for d in 0..l.dlls.len { if imports_of(l, d) > 0 { p = p + l.dlls[d].len + 1 } }
    return ImpLayout{ idt, ilt, iat, names, dn, p }
}

// the RVA of import i's IAT slot, and of its jump stub
int iat_slot(Linker* l, ImpLayout il, int i) {
    int at = il.iat
    for d in 0..l.dlls.len {
        int k = imports_of(l, d)
        if k > 0 {
            int pos = 0
            for j in 0..l.imp.len {
                if l.imp_dll[j] == d {
                    if j == i { return l.orva[1] + at + 8 * pos }
                    pos += 1
                }
            }
            at = at + 8 * (k + 1)
        }
    }
    return 0
}

int symbol_rva(Linker* l, ImpLayout il, int oi, int symi) {
    LObj o = l.objs[oi]
    LSym y = o.syms[symi]
    if y.section > 0 {
        LSec s = l.secs[o.first + y.section - 1]
        if s.out < 0 { lk_fail(l, "a reference to the dropped section " + s.name + " (" + o.name + ")"); return 0 }
        return l.orva[s.out] + s.at + y.value
    }
    if y.section == 0 {
        int g = find_global(l, y.name)
        if g >= 0 {
            LSec s = l.secs[l.gsec[g]]
            return l.orva[s.out] + s.at + l.gval[g]
        }
        if y.name == "__ImageBase" { return 0 }    // the image's first byte (as MSVC / GNU ld define it)
        int i = find_import(l, import_base(y.name))
        if i < 0 { lk_fail(l, "undefined symbol '" + y.name + "'"); return 0 }
        if import_base(y.name) != y.name { return iat_slot(l, il, i) }
        return l.orva[0] + l.thunks_at + 8 * i
    }
    if y.section == 0 - 1 { return y.value }   // absolute
    lk_fail(l, "unsupported symbol " + y.name)
    return 0
}

// read / write little-endian in an output section's bytes
int get32(u8[dynamic] b, int at) { return rd32(b, at) }
void put32(u8[dynamic]* b, int at, int v) {
    for i in 0..4 { b[0][at + i] = cast<u8>((v >> (8 * i)) & 255) }
}
void put64(u8[dynamic]* b, int at, int v) {
    u64 x = cast<u64>(v)
    for i in 0..8 {
        b[0][at + i] = cast<u8>(cast<int>(x & cast<u64>(255)))
        x = x >> cast<u64>(8)
    }
}
int get64(u8[dynamic] b, int at) {
    u64 lo = cast<u64>(rd32(b, at)) & cast<u64>(4294967295)
    u64 hi = cast<u64>(rd32(b, at + 4)) & cast<u64>(4294967295)
    return cast<int>(lo | (hi << cast<u64>(32)))
}

// where the image wants to load: an exe at a fixed 0x140000000 (no relocations), a dll
// at 0x180000000, relocatable (the loader moves it if that's taken: see `fix64`)
int image_base(Linker* l) {
    if l.dll { return 6442450944 }
    return 5368709120
}

void apply_relocs(Linker* l, ImpLayout il, int si, u8[dynamic]* out) {
    LSec s = l.secs[si]
    LObj o = l.objs[s.obj]
    int n = reloc_count(l, s)
    int at = reloc_first(s)
    for r in 0..n {
        int va = rd32(o.b, at + 10 * r)
        int symi = rd32(o.b, at + 10 * r + 4)
        int typ = rd16(o.b, at + 10 * r + 8)
        int p = s.at + va
        int prva = l.orva[s.out] + p
        int sv = symbol_rva(l, il, s.obj, symi)
        if typ >= 4 && typ <= 9 {
            put32(out, p, rd32(out[0], p) + sv - (prva + 4 + (typ - 4)))
        } else if typ == 1 {
            put64(out, p, get64(out[0], p) + image_base(l) + sv)
            if l.dll { l.fix64.push(prva) }      // an absolute address: the loader adjusts it
        } else if typ == 3 {
            put32(out, p, rd32(out[0], p) + sv)
        } else if typ == 2 {
            if l.dll { lk_fail(l, "a 32-bit absolute address in " + o.name + " (a dll can't be relocated with it)") }
            put32(out, p, rd32(out[0], p) + image_base(l) + sv)
        } else if typ != 0 {
            lk_fail(l, "unsupported relocation type " + int_to_str(typ) + " in " + o.name)
        }
    }
}

// ---- writing the executable -----------------------------------------------------------------------

struct PeOut { u8[dynamic] b }
void p8(PeOut* o, int v) { o.b.push(cast<u8>(v & 255)) }
void p16(PeOut* o, int v) { p8(o, v); p8(o, v >> 8) }
void p32(PeOut* o, int v) { p8(o, v); p8(o, v >> 8); p8(o, v >> 16); p8(o, v >> 24) }
void pzero(PeOut* o, int n) { for i in 0..n { p8(o, 0) } }
void pname(PeOut* o, string s) { for i in 0..8 { if i < s.len { p8(o, cast<int>(s[i])) } else { p8(o, 0) } } }

// The startup code: argc / argv from msvcrt, then main, then exit (which flushes stdio).
string startup_asm() {
    string[dynamic] p = []
    p.push("\t.text\n\t.globl _strata_start\n_strata_start:\n")
    p.push("\tsubq $72, %rsp\n")
    p.push("\tmovl $0, 44(%rsp)\n\tleaq 44(%rsp), %rax\n\tmovq %rax, 32(%rsp)\n")      // _startupinfo
    p.push("\tleaq 64(%rsp), %rcx\n\tleaq 56(%rsp), %rdx\n\tleaq 48(%rsp), %r8\n")      // &argc, &argv, &env
    p.push("\txorl %r9d, %r9d\n\tcall __getmainargs\n")
    p.push("\tmovl 64(%rsp), %ecx\n\tmovq 56(%rsp), %rdx\n\tcall main\n")
    p.push("\tmovl %eax, %ecx\n\tcall exit\n")
    return strata_join(&p)
}

// Link everything added so far into the executable `path`. False (with l.err) on failure.
export bool link_exe(Linker* l, string path) {
    string[dynamic] none = []
    return link_image(l, path, false, none)
}

// Link everything added so far into the dll `path`, exporting the functions `exports`
// (by name). False (with l.err) on failure.
export bool link_dll(Linker* l, string path, string[dynamic] exports) {
    return link_image(l, path, true, exports)
}

// "a" < "b" by bytes (the order a dll's export names must be in)
bool name_less(string a, string b) {
    int n = a.len
    if b.len < n { n = b.len }
    for i in 0..n { if a[i] != b[i] { return cast<int>(a[i]) < cast<int>(b[i]) } }
    return a.len < b.len
}

// the 4,096-byte pages of the fixups, as a .reloc section's blocks
u8[dynamic] reloc_blocks(int[dynamic] fix) {
    // sort (insertion: fixups mostly arrive in order)
    int[dynamic] f = []
    for i in 0..fix.len {
        f.push(fix[i])
        int k = f.len - 1
        while k > 0 && f[k - 1] > f[k] { int t = f[k]; f[k] = f[k - 1]; f[k - 1] = t; k -= 1 }
    }
    u8[dynamic] ob = []
    PeOut o = PeOut{ ob }
    int i = 0
    while i < f.len {
        int page = f[i] - (f[i] % 4096)
        int j = i
        while j < f.len && f[j] - (f[j] % 4096) == page { j += 1 }
        int count = j - i
        int pad = count % 2                       // blocks are 4-byte multiples
        p32(&o, page)
        p32(&o, 8 + 2 * (count + pad))
        for k in i..j { p16(&o, 40960 | (f[k] - page)) }   // IMAGE_REL_BASED_DIR64 (10) << 12
        if pad == 1 { p16(&o, 0) }
        i = j
    }
    return o.b
}

bool link_image(Linker* l, string path, bool dll, string[dynamic] exports) {
    l.dll = dll
    if !dll {
        // the startup code is just another object
        ObjFile st = assemble(startup_asm(), "x64")
        if !st.ok { lk_fail(l, "startup: " + st.err); return false }
        link_add(l, "startup", coff_bytes(&st))
        if !l.ok { return false }
        if find_global(l, "main") < 0 { lk_fail(l, "no main"); return false }
    }
    if !l.ok { return false }
    // exports: each must be defined; sorted by name
    string[dynamic] ex = []
    for i in 0..exports.len {
        if find_global(l, exports[i]) < 0 { lk_fail(l, "exported function '" + exports[i] + "' isn't defined") }
        ex.push(exports[i])
        int k = ex.len - 1
        while k > 0 && name_less(ex[k], ex[k - 1]) { string t = ex[k]; ex[k] = ex[k - 1]; ex[k - 1] = t; k -= 1 }
    }
    find_imports(l)
    if !l.ok { return false }

    // place the input sections
    for o in 0..5 { l.osize.push(0); l.orva.push(0); l.ofile.push(0); l.oraw.push(0) }
    for si in 0..l.secs.len {
        int out = l.secs[si].out
        if out >= 0 {
            int at = align_up(l.osize[out], sec_align(l.secs[si].flags))
            l.secs[si].at = at
            l.osize[out] = at + l.secs[si].size
        }
    }
    // import stubs after the code, import tables after the read-only data, then (a dll)
    // the export directory
    l.thunks_at = align_up(l.osize[0], 16)
    l.osize[0] = l.thunks_at + 8 * l.imp.len
    l.imports_at = align_up(l.osize[1], 16)
    ImpLayout il = import_layout(l, l.imports_at)
    if l.imp.len > 0 { l.osize[1] = il.end }
    string dllname = path
    for i in 0..path.len { if path[i] == '/' || path[i] == '\\' { dllname = substr(path, i + 1, path.len - i - 1) } }
    int exp_at = align_up(l.osize[1], 4)
    int exp_funcs = exp_at + 40
    int exp_names = exp_funcs + 4 * ex.len
    int exp_ords = exp_names + 4 * ex.len
    int exp_strs = exp_ords + 2 * ex.len
    int exp_end = exp_strs + dllname.len + 1
    for i in 0..ex.len { exp_end = exp_end + ex[i].len + 1 }
    if dll { l.osize[1] = exp_end }
    // a dll's base relocations (one per 64-bit absolute address) go in a .reloc section,
    // last; count them now (the section count fixes the header size)
    bool has_reloc = false
    if dll {
        for si in 0..l.secs.len {
            LSec s = l.secs[si]
            if s.out >= 0 && s.out != 3 {
                int n = reloc_count(l, s)
                int at = reloc_first(s)
                for r in 0..n { if rd16(l.objs[s.obj].b, at + 10 * r + 8) == 1 { has_reloc = true } }
            }
        }
    }

    // addresses: headers, then each section page-aligned in memory, 512-aligned in the file
    int nout = 0
    for o in 0..4 { if l.osize[o] > 0 { nout += 1 } }
    if has_reloc { nout += 1 }
    int headers = align_up(64 + 4 + 20 + 240 + 40 * nout, 512)
    int rva = 4096
    int fp = headers
    for o in 0..4 {
        if l.osize[o] > 0 {
            l.orva[o] = rva
            rva = align_up(rva + l.osize[o], 4096)
            if o != 3 {
                l.ofile[o] = fp
                l.oraw[o] = align_up(l.osize[o], 512)
                fp = fp + l.oraw[o]
            }
        }
    }

    // the section contents
    u8[dynamic] text = []
    u8[dynamic] rdata = []
    u8[dynamic] data = []
    for i in 0..l.osize[0] { text.push(cast<u8>(204)) }   // int3 between functions
    for i in 0..l.osize[1] { rdata.push(cast<u8>(0)) }
    for i in 0..l.osize[2] { data.push(cast<u8>(0)) }
    for si in 0..l.secs.len {
        LSec s = l.secs[si]
        if s.out >= 0 && s.out != 3 && s.raw > 0 {
            u8[dynamic] src = l.objs[s.obj].b
            for i in 0..s.size {
                if s.out == 0 { text[s.at + i] = src[s.raw + i] }
                else if s.out == 1 { rdata[s.at + i] = src[s.raw + i] }
                else { data[s.at + i] = src[s.raw + i] }
            }
        }
    }
    for si in 0..l.secs.len {
        int out = l.secs[si].out
        if out == 0 { apply_relocs(l, il, si, &text) }
        else if out == 1 { apply_relocs(l, il, si, &rdata) }
        else if out == 2 { apply_relocs(l, il, si, &data) }
        else if out == 3 && reloc_count(l, l.secs[si]) > 0 { lk_fail(l, "relocations in .bss") }
    }
    if !l.ok { return false }
    u8[dynamic] reloc = []
    if has_reloc {
        reloc = reloc_blocks(l.fix64)
        l.osize[4] = reloc.len
        l.orva[4] = rva
        rva = align_up(rva + reloc.len, 4096)
        l.ofile[4] = fp
        l.oraw[4] = align_up(reloc.len, 512)
        fp = fp + l.oraw[4]
    }
    int image_size = rva

    // import stubs: jmp *slot(%rip)
    for i in 0..l.imp.len {
        int at = l.thunks_at + 8 * i
        text[at] = cast<u8>(255)
        text[at + 1] = cast<u8>(37)
        put32(&text, at + 2, iat_slot(l, il, i) - (l.orva[0] + at + 6))
    }
    // import tables
    int idt_rva = 0
    int idt_size = 0
    int iat_rva = 0
    int iat_size = 0
    if l.imp.len > 0 {
        int base = l.orva[1]
        int ilt = il.ilt
        int iat = il.iat
        int dn = il.dllnames
        int k = 0
        // hint/name entries
        int[dynamic] hn = []
        int p = il.names
        for i in 0..l.imp.len {
            hn.push(p)
            for c in 0..l.imp[i].len { rdata[p + 2 + c] = cast<u8>(cast<int>(l.imp[i][c])) }
            p = align_up(p + 2 + l.imp[i].len + 1, 2)
        }
        for d in 0..l.dlls.len {
            int cnt = imports_of(l, d)
            if cnt > 0 {
                for c in 0..l.dlls[d].len { rdata[dn + c] = cast<u8>(cast<int>(l.dlls[d][c])) }
                int e = il.idt + 20 * k
                put32(&rdata, e, base + ilt)          // import lookup table
                put32(&rdata, e + 12, base + dn)      // DLL name
                put32(&rdata, e + 16, base + iat)     // import address table
                for i in 0..l.imp.len {
                    if l.imp_dll[i] == d {
                        put64(&rdata, ilt, base + hn[i])
                        put64(&rdata, iat, base + hn[i])
                        ilt += 8
                        iat += 8
                    }
                }
                ilt += 8
                iat += 8
                dn = dn + l.dlls[d].len + 1
                k += 1
            }
        }
        idt_rva = base + il.idt
        idt_size = 20 * (k + 1)
        iat_rva = base + il.iat
        iat_size = il.names - il.iat
    }
    // the export directory: the dll's name, then each export's address, name and ordinal
    int edir_rva = 0
    int edir_size = 0
    if dll {
        int base = l.orva[1]
        int sp = exp_strs
        for c in 0..dllname.len { rdata[sp + c] = cast<u8>(cast<int>(dllname[c])) }
        put32(&rdata, exp_at + 12, base + sp)            // Name
        sp = sp + dllname.len + 1
        put32(&rdata, exp_at + 16, 1)                    // ordinal base
        put32(&rdata, exp_at + 20, ex.len)               // functions
        put32(&rdata, exp_at + 24, ex.len)               // names
        put32(&rdata, exp_at + 28, base + exp_funcs)
        put32(&rdata, exp_at + 32, base + exp_names)
        put32(&rdata, exp_at + 36, base + exp_ords)
        for i in 0..ex.len {
            int g = find_global(l, ex[i])
            LSec gs = l.secs[l.gsec[g]]
            put32(&rdata, exp_funcs + 4 * i, l.orva[gs.out] + gs.at + l.gval[g])
            put32(&rdata, exp_names + 4 * i, base + sp)
            rdata[exp_ords + 2 * i] = cast<u8>(i & 255)
            rdata[exp_ords + 2 * i + 1] = cast<u8>((i >> 8) & 255)
            for c in 0..ex[i].len { rdata[sp + c] = cast<u8>(cast<int>(ex[i][c])) }
            sp = sp + ex[i].len + 1
        }
        edir_rva = base + exp_at
        edir_size = exp_end - exp_at
    }

    // the entry point (a dll: none)
    int entry = 0
    if !dll {
        int g = find_global(l, "_strata_start")
        LSec es = l.secs[l.gsec[g]]
        entry = l.orva[es.out] + es.at + l.gval[g]
    }

    // the file
    u8[dynamic] ob = []
    PeOut o = PeOut{ ob }
    p16(&o, 23117)                 // "MZ"
    pzero(&o, 58)
    p32(&o, 64)                    // e_lfanew
    p32(&o, 17744)                 // "PE\0\0"
    p16(&o, 34404)                 // x86-64
    p16(&o, nout)
    p32(&o, 0)
    p32(&o, 0)
    p32(&o, 0)
    p16(&o, 240)                   // optional header size
    if dll { p16(&o, 8226) }       // dll | executable | large address aware
    else { p16(&o, 35) }           // relocs stripped | executable | large address aware
    p16(&o, 523)                   // PE32+
    p8(&o, 2)
    p8(&o, 0)
    p32(&o, l.oraw[0])             // size of code
    p32(&o, l.oraw[1] + l.oraw[2] + l.oraw[4]) // initialized data
    p32(&o, align_up(l.osize[3], 512))
    p32(&o, entry)
    p32(&o, l.orva[0])             // base of code
    p32(&o, image_base(l) & 4294967295)   // image base (low, high)
    p32(&o, image_base(l) >> 32)
    p32(&o, 4096)                  // section alignment
    p32(&o, 512)                   // file alignment
    p16(&o, 6)
    p16(&o, 0)
    p16(&o, 0)
    p16(&o, 0)
    p16(&o, 6)
    p16(&o, 0)
    p32(&o, 0)
    p32(&o, image_size)
    p32(&o, headers)
    p32(&o, 0)                     // checksum
    p16(&o, 3)                     // console subsystem
    if dll { p16(&o, 352) }        // NX compatible, relocatable (high-entropy ASLR)
    else { p16(&o, 33024) }        // NX compatible, terminal-server aware (no ASLR: a fixed base)
    p32(&o, 8388608)               // stack reserve 8 MB (committed as it grows)
    p32(&o, 0)
    p32(&o, 4096)                  // stack commit
    p32(&o, 0)
    p32(&o, 1048576)               // heap reserve
    p32(&o, 0)
    p32(&o, 4096)
    p32(&o, 0)
    p32(&o, 0)                     // loader flags
    p32(&o, 16)
    for d in 0..16 {
        if d == 0 { p32(&o, edir_rva); p32(&o, edir_size) }
        else if d == 1 { p32(&o, idt_rva); p32(&o, idt_size) }
        else if d == 5 && has_reloc { p32(&o, l.orva[4]); p32(&o, l.osize[4]) }
        else if d == 12 { p32(&o, iat_rva); p32(&o, iat_size) }
        else { p32(&o, 0); p32(&o, 0) }
    }
    string[dynamic] names = [".text", ".rdata", ".data", ".bss", ".reloc"]
    int[dynamic] flags = [1610612768, 1073741888, 3221225536, 3221225600, 1107296320]   // code / rdata / data / bss / reloc (discardable)
    for s in 0..5 {
        if l.osize[s] > 0 {
            pname(&o, names[s])
            p32(&o, l.osize[s])
            p32(&o, l.orva[s])
            p32(&o, l.oraw[s])
            p32(&o, l.ofile[s])
            p32(&o, 0)
            p32(&o, 0)
            p16(&o, 0)
            p16(&o, 0)
            p32(&o, flags[s])
        }
    }
    while o.b.len < headers { p8(&o, 0) }
    for s in 0..5 {
        if l.osize[s] > 0 && s != 3 {
            u8[dynamic] src = text
            if s == 1 { src = rdata } else if s == 2 { src = data } else if s == 4 { src = reloc }
            for i in 0..src.len { o.b.push(src[i]) }
            while o.b.len < l.ofile[s] + l.oraw[s] { p8(&o, 0) }
        }
    }
    if !strata_write_bytes(path, &o.b) { lk_fail(l, "cannot write " + path); return false }
    return true
}

// ======== import libraries ====================================================================
// An import library for a dll: what a C / C++ toolchain links against
// to call the dll's functions.
//
// The Microsoft format, which GNU ld reads too: an `ar` archive of
//   * an import descriptor object (the dll's entry in a program's import table),
//   * the null import descriptor and the dll's null thunk (the tables' terminators),
//   * one "short import" member per function (the linker makes `name` and `__imp_name`).
// build.strata writes it as <name>.dll.a (GNU ld, `-l<name>`) and <name>.lib (MSVC).

struct Bytes { u8[dynamic] b }

void ib8(Bytes* o, int v) { o.b.push(cast<u8>(v & 255)) }
void ib16(Bytes* o, int v) { ib8(o, v); ib8(o, v >> 8) }
void ib32(Bytes* o, int v) { ib16(o, v); ib16(o, v >> 16) }
void ib32be(Bytes* o, int v) { ib8(o, v >> 24); ib8(o, v >> 16); ib8(o, v >> 8); ib8(o, v) }
void ibstr(Bytes* o, string s) { for i in 0..s.len { ib8(o, cast<int>(s[i])) } }
void ibzero(Bytes* o, int n) { for i in 0..n { ib8(o, 0) } }
void ibpad(Bytes* o, string s, int width) {       // s, then spaces to `width`
    ibstr(o, s)
    for i in s.len..width { ib8(o, 32) }
}
void ibcat(Bytes* o, u8[dynamic] more) { for i in 0..more.len { o.b.push(more[i]) } }

// ---- small COFF objects ------------------------------------------------------------------

struct CSym { string name; int value; int section; int cls }
struct CSec { string name; u8[dynamic] data; int flags; int[dynamic] rel_at; int[dynamic] rel_sym }

// a symbol or section name: inline (8 bytes at most) or in the string table
void coff_name(Bytes* o, Bytes* strtab, string name) {
    if name.len <= 8 { ibstr(o, name); ibzero(o, 8 - name.len) }
    else {
        ib32(o, 0)
        ib32(o, 4 + strtab.b.len)
        ibstr(strtab, name)
        ib8(strtab, 0)
    }
}

u8[dynamic] coff_object(CSec[dynamic] secs, CSym[dynamic] syms) {
    u8[dynamic] ob = []
    Bytes o = Bytes{ ob }
    u8[dynamic] sb = []
    Bytes strtab = Bytes{ sb }
    int at = 20 + 40 * secs.len
    int[dynamic] raw = []
    int[dynamic] rel = []
    for s in 0..secs.len {
        raw.push(at)
        at = at + secs[s].data.len
        rel.push(at)
        at = at + 10 * secs[s].rel_at.len
    }
    ib16(&o, 34404)                // x86-64
    ib16(&o, secs.len)
    ib32(&o, 0)
    ib32(&o, at)                   // the symbol table
    ib32(&o, syms.len)
    ib16(&o, 0)
    ib16(&o, 0)
    for s in 0..secs.len {
        coff_name(&o, &strtab, secs[s].name)
        ib32(&o, 0)
        ib32(&o, 0)
        ib32(&o, secs[s].data.len)
        ib32(&o, raw[s])
        if secs[s].rel_at.len > 0 { ib32(&o, rel[s]) } else { ib32(&o, 0) }
        ib32(&o, 0)
        ib16(&o, secs[s].rel_at.len)
        ib16(&o, 0)
        ib32(&o, secs[s].flags)
    }
    for s in 0..secs.len {
        ibcat(&o, secs[s].data)
        for r in 0..secs[s].rel_at.len {
            ib32(&o, secs[s].rel_at[r])
            ib32(&o, secs[s].rel_sym[r])
            ib16(&o, 3)            // IMAGE_REL_AMD64_ADDR32NB: an RVA
        }
    }
    for k in 0..syms.len {
        coff_name(&o, &strtab, syms[k].name)
        ib32(&o, syms[k].value)
        ib16(&o, syms[k].section)
        ib16(&o, 0)
        ib8(&o, syms[k].cls)
        ib8(&o, 0)
    }
    ib32(&o, 4 + strtab.b.len)
    ibcat(&o, strtab.b)
    return o.b
}

int ext() { return 2 }             // IMAGE_SYM_CLASS_EXTERNAL
int sect() { return 104 }          // IMAGE_SYM_CLASS_SECTION
int idata_flags(int align_code) { return 3221225536 | (align_code << 20) }   // data, read / write

CSec csec(string name, int size, int align_code) {
    u8[dynamic] d = []
    for i in 0..size { d.push(cast<u8>(0)) }
    int[dynamic] ra = []
    int[dynamic] rs = []
    return CSec{ name, d, idata_flags(align_code), ra, rs }
}

// ---- the archive -------------------------------------------------------------------------

struct Member { string name; u8[dynamic] data }

void ar_header(Bytes* o, string name, int size) {
    ibpad(o, name, 16)
    ibpad(o, "0", 12)
    ibpad(o, "0", 6)
    ibpad(o, "0", 6)
    ibpad(o, "0", 8)
    ibpad(o, int_to_str(size), 10)
    ib8(o, 96)                     // "`\n"
    ib8(o, 10)
}

int even(int n) { return n + (n % 2) }

// The import library for `dll` (its file name, e.g. "mathlib.dll") exporting `names`.
export u8[dynamic] import_library(string dll, string[dynamic] names) {
    string lib = dll
    if lib.len > 4 && substr(lib, lib.len - 4, 4) == ".dll" { lib = substr(lib, 0, lib.len - 4) }
    Member[dynamic] mem = []
    string[dynamic] sym_name = []
    int[dynamic] sym_member = []

    // 1. the import descriptor: .idata$2 (filled in through relocations), .idata$6 (the name)
    CSec[dynamic] s1 = []
    CSec d2 = csec(".idata$2", 20, 3)
    d2.rel_at.push(12)
    d2.rel_sym.push(2)             // Name -> .idata$6
    d2.rel_at.push(0)
    d2.rel_sym.push(3)             // the lookup table -> this dll's .idata$4
    d2.rel_at.push(16)
    d2.rel_sym.push(4)             // the address table -> this dll's .idata$5
    s1.push(d2)
    CSec d6 = csec(".idata$6", 0, 2)
    for i in 0..dll.len { d6.data.push(cast<u8>(cast<int>(dll[i]))) }
    d6.data.push(cast<u8>(0))
    if d6.data.len % 2 == 1 { d6.data.push(cast<u8>(0)) }
    s1.push(d6)
    CSym[dynamic] y1 = []
    y1.push(CSym{ "__IMPORT_DESCRIPTOR_" + lib, 0, 1, ext() })
    y1.push(CSym{ ".idata$2", 3221225536, 1, sect() })
    y1.push(CSym{ ".idata$6", 0, 2, 3 })
    y1.push(CSym{ ".idata$4", 3221225536, 0, sect() })
    y1.push(CSym{ ".idata$5", 3221225536, 0, sect() })
    y1.push(CSym{ "__NULL_IMPORT_DESCRIPTOR", 0, 0, ext() })
    y1.push(CSym{ lib + "_NULL_THUNK_DATA", 0, 0, ext() })
    mem.push(Member{ dll, coff_object(s1, y1) })
    sym_name.push("__IMPORT_DESCRIPTOR_" + lib)
    sym_member.push(0)

    // 2. the null import descriptor (ends the import table)
    CSec[dynamic] s2 = []
    s2.push(csec(".idata$3", 20, 3))
    CSym[dynamic] y2 = []
    y2.push(CSym{ "__NULL_IMPORT_DESCRIPTOR", 0, 1, ext() })
    mem.push(Member{ dll, coff_object(s2, y2) })
    sym_name.push("__NULL_IMPORT_DESCRIPTOR")
    sym_member.push(1)

    // 3. the null thunk (ends this dll's lookup and address tables)
    CSec[dynamic] s3 = []
    s3.push(csec(".idata$5", 8, 4))
    s3.push(csec(".idata$4", 8, 4))
    CSym[dynamic] y3 = []
    y3.push(CSym{ lib + "_NULL_THUNK_DATA", 0, 1, ext() })
    mem.push(Member{ dll, coff_object(s3, y3) })
    sym_name.push(lib + "_NULL_THUNK_DATA")
    sym_member.push(2)

    // 4. a short import per function: code, imported by name
    for i in 0..names.len {
        u8[dynamic] sb = []
        Bytes s = Bytes{ sb }
        ib16(&s, 0)
        ib16(&s, 65535)
        ib16(&s, 0)
        ib16(&s, 34404)
        ib32(&s, 0)
        ib32(&s, names[i].len + 1 + dll.len + 1)
        ib16(&s, i)                // hint
        ib16(&s, 4)                // IMPORT_CODE, IMPORT_NAME
        ibstr(&s, names[i])
        ib8(&s, 0)
        ibstr(&s, dll)
        ib8(&s, 0)
        mem.push(Member{ dll, s.b })
        sym_name.push("__imp_" + names[i])
        sym_member.push(3 + i)
        sym_name.push(names[i])
        sym_member.push(3 + i)
    }

    // member names: "<dll>/" if it fits in 16 bytes, else "/<offset>" into a longnames member
    u8[dynamic] lb = []
    Bytes longnames = Bytes{ lb }
    string mname = dll + "/"
    if mname.len > 16 {
        ibstr(&longnames, dll + "/")
        ib8(&longnames, 10)
        mname = "/0"
    }

    // the two linker members (symbol -> member) come first; lay everything out to know
    // the members' offsets
    int nsym = sym_name.len
    int strs = 0
    for k in 0..nsym { strs = strs + sym_name[k].len + 1 }
    int first_size = 4 + 4 * nsym + strs
    int second_size = 4 + 4 * mem.len + 4 + 2 * nsym + strs
    int at = 8 + 60 + even(first_size) + 60 + even(second_size)
    if longnames.b.len > 0 { at = at + 60 + even(longnames.b.len) }
    int[dynamic] off = []
    for m in 0..mem.len {
        off.push(at)
        at = at + 60 + even(mem[m].data.len)
    }
    // the second linker member lists the symbols sorted
    int[dynamic] order = []
    for k in 0..nsym {
        order.push(k)
        int q = order.len - 1
        while q > 0 && name_before(sym_name[order[q]], sym_name[order[q - 1]]) {
            int t = order[q]; order[q] = order[q - 1]; order[q - 1] = t
            q -= 1
        }
    }

    u8[dynamic] ob = []
    Bytes o = Bytes{ ob }
    ibstr(&o, "!<arch>")
    ib8(&o, 10)
    ar_header(&o, "/", first_size)
    ib32be(&o, nsym)
    for k in 0..nsym { ib32be(&o, off[sym_member[k]]) }
    for k in 0..nsym { ibstr(&o, sym_name[k]); ib8(&o, 0) }
    if first_size % 2 == 1 { ib8(&o, 10) }
    ar_header(&o, "/", second_size)
    ib32(&o, mem.len)
    for m in 0..mem.len { ib32(&o, off[m]) }
    ib32(&o, nsym)
    for k in 0..nsym { ib16(&o, sym_member[order[k]] + 1) }
    for k in 0..nsym { ibstr(&o, sym_name[order[k]]); ib8(&o, 0) }
    if second_size % 2 == 1 { ib8(&o, 10) }
    if longnames.b.len > 0 {
        ar_header(&o, "//", longnames.b.len)
        ibcat(&o, longnames.b)
        if longnames.b.len % 2 == 1 { ib8(&o, 10) }
    }
    for m in 0..mem.len {
        ar_header(&o, mname, mem[m].data.len)
        ibcat(&o, mem[m].data)
        if mem[m].data.len % 2 == 1 { ib8(&o, 10) }
    }
    return o.b
}

// "a" before "b" by bytes
bool name_before(string a, string b) {
    int n = a.len
    if b.len < n { n = b.len }
    for i in 0..n { if a[i] != b[i] { return cast<int>(a[i]) < cast<int>(b[i]) } }
    return a.len < b.len
}
