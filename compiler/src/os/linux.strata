//
// src/os/linux.strata - everything about making Linux programs. CORE.
//
// linker.strata calls it for the target OS "linux":
//   1. ELF object files (.o): an assembled ObjFile (asm.strata) as an x86-64 ELF
//      relocatable - also what the linker below takes;
//   2. the linker: ELF objects -> an x86-64 ELF executable: static (no C library, no
//      dynamic loader - the runtime, lib/srt/linux.strata, talks to the kernel with system
//      calls), or, when the program calls functions of shared libraries, dynamic.
//      Two small stubs come with every program: `_start` (the entry: argc / argv off the
//      stack, main, then srt_os_exit) and `srt_syscall` (a Strata call -> a system call).
//
// Making shared libraries (.so) comes later.

import asm      // ObjFile, assemble (the stubs)
import hashidx
import host     // strata_read_bytes, strata_write_bytes, strata_host_os, strata_run_argv

// ======== ELF objects =========================================================================
// Layout: ELF header | .text | .rodata | .data | .rela.text | .rela.data | .symtab |
//         .strtab | .shstrtab | section headers
// Symbols: null, the three section symbols, the object's local symbols, then its globals.
// A relocation in .text is R_X86_64_PC32 (R_X86_64_PLT32 to a function defined elsewhere)
// with addend = the field's value - 4 - the instruction bytes after it; in .data,
// R_X86_64_64 with addend = the field's value. (RELA: the fields themselves are zeroed.)

struct EOut { u8[dynamic] b }

void e8(EOut* o, int v) { o.b.push(cast<u8>(v & 255)) }
void e16(EOut* o, int v) { e8(o, v); e8(o, v >> 8) }
void e32(EOut* o, int v) { e16(o, v); e16(o, v >> 16) }
void e64(EOut* o, int v) { e32(o, v); e32(o, v >> 32) }
void ezero(EOut* o, int n) { for i in 0..n { e8(o, 0) } }
void ebytes(EOut* o, u8[dynamic] b) { for i in 0..b.len { o.b.push(b[i]) } }
void epad(EOut* o, int align) { while o.b.len % align != 0 { e8(o, 0) } }

int rd8(u8[dynamic] b, int at) { return cast<int>(b[at]) }
int rd16le(u8[dynamic] b, int at) { return rd8(b, at) | (rd8(b, at + 1) << 8) }
int rd32le(u8[dynamic] b, int at) { return rd16le(b, at) | (rd16le(b, at + 2) << 16) }
int rd64le(u8[dynamic] b, int at) {
    u64 lo = cast<u64>(rd32le(b, at)) & cast<u64>(4294967295)
    u64 hi = cast<u64>(rd32le(b, at + 4)) & cast<u64>(4294967295)
    return cast<int>(lo | (hi << cast<u64>(32)))
}
// a 32-bit field, sign-extended
int rd32s(u8[dynamic] b, int at) {
    int v = rd32le(b, at) & 4294967295
    if v >= 2147483648 { return v - 4294967296 }
    return v
}

// a string table: names, NUL-terminated, the first byte empty
struct StrTab { u8[dynamic] b }
int strtab_add(StrTab* t, string s) {
    int at = t.b.len
    for i in 0..s.len { t.b.push(cast<u8>(cast<int>(s[i]))) }
    t.b.push(cast<u8>(0))
    return at
}

void elf_header(EOut* o, int type, int entry, int phoff, int phnum, int shoff, int shnum, int shstrndx) {
    e8(o, 127); e8(o, 69); e8(o, 76); e8(o, 70)     // \x7fELF
    e8(o, 2)                                        // 64-bit
    e8(o, 1)                                        // little-endian
    e8(o, 1)                                        // ELF version 1
    e8(o, 0)                                        // System V ABI
    ezero(o, 8)
    e16(o, type)                                    // 1: relocatable, 2: executable
    e16(o, 62)                                      // x86-64
    e32(o, 1)
    e64(o, entry)
    e64(o, phoff)
    e64(o, shoff)
    e32(o, 0)                                       // flags
    e16(o, 64)                                      // header size
    e16(o, 56)                                      // program header size
    e16(o, phnum)
    e16(o, 64)                                      // section header size
    e16(o, shnum)
    e16(o, shstrndx)
}

void sec_header(EOut* o, int name, int type, int flags, int offset, int size, int linked, int info, int align, int entsize) {
    e32(o, name)
    e32(o, type)
    e64(o, flags)
    e64(o, 0)                                       // address (none in an object)
    e64(o, offset)
    e64(o, size)
    e32(o, linked)
    e32(o, info)
    e64(o, align)
    e64(o, entsize)
}

// The ObjFile as the bytes of an ELF relocatable object.
export u8[dynamic] elf_bytes(ObjFile* f) {
    // symbols: null, 3 section symbols, locals, globals
    u8[dynamic] stb = []
    StrTab strtab = StrTab{ stb }
    strtab.b.push(cast<u8>(0))
    int[dynamic] map = []                          // ObjFile symbol -> ELF symbol index
    for i in 0..f.symbols.len { map.push(0) }
    u8[dynamic] sb = []
    EOut sym = EOut{ sb }
    ezero(&sym, 24)                                 // the null symbol
    for s in 1..4 {                                 // section symbols: .text, .rodata, .data
        e32(&sym, 0); e8(&sym, 3); e8(&sym, 0); e16(&sym, s); e64(&sym, 0); e64(&sym, 0)
    }
    int n = 4
    for pass in 0..2 {                              // locals first, then globals
        for i in 0..f.symbols.len {
            ObjSymbol s = f.symbols[i]
            if (pass == 0 && !s.global) || (pass == 1 && s.global) {
                int typ = 0
                if s.section == 1 { typ = 2 } else if s.section == 2 || s.section == 3 { typ = 1 }
                int bind = 0
                if s.global { bind = 1 }
                e32(&sym, strtab_add(&strtab, s.name))
                e8(&sym, bind * 16 + typ)
                e8(&sym, 0)
                e16(&sym, s.section)                // 0 undefined, 1 .text, 2 .rodata, 3 .data
                e64(&sym, s.value)
                e64(&sym, 0)
                map[i] = n
                n += 1
            }
        }
    }
    int first_global = 4
    for i in 0..f.symbols.len { if !f.symbols[i].global { first_global += 1 } }

    // relocations (and the sections with their fields zeroed)
    u8[dynamic] text = []
    for i in 0..f.text.len { text.push(f.text[i]) }
    u8[dynamic] data = []
    for i in 0..f.data.len { data.push(f.data[i]) }
    u8[dynamic] rtb = []
    EOut rt = EOut{ rtb }
    u8[dynamic] rdb = []
    EOut rd = EOut{ rdb }
    for i in 0..f.relocs.len {
        ObjReloc r = f.relocs[i]
        int esym = 0
        bool external = false
        if r.symbol >= 0 {
            esym = map[r.symbol]
            external = f.symbols[r.symbol].section == 0
        } else { esym = 0 - r.symbol }              // -1 / -2 / -3: the section symbols 1 / 2 / 3
        if r.section == 1 {
            int addend = rd32s(text, r.offset) - 4 - r.after
            for k in 0..4 { text[r.offset + k] = cast<u8>(0) }
            int typ = 2                             // R_X86_64_PC32
            if external && r.after == 0 { typ = 4 } // R_X86_64_PLT32: a call / jump to elsewhere
            e64(&rt, r.offset)
            e64(&rt, esym * 4294967296 + typ)
            e64(&rt, addend)
        } else {
            int addend = rd64le(data, r.offset)
            for k in 0..8 { data[r.offset + k] = cast<u8>(0) }
            e64(&rd, r.offset)
            e64(&rd, esym * 4294967296 + 1)        // R_X86_64_64
            e64(&rd, addend)
        }
    }

    u8[dynamic] shb = []
    StrTab shstr = StrTab{ shb }
    shstr.b.push(cast<u8>(0))
    int n_text = strtab_add(&shstr, ".text")
    int n_rodata = strtab_add(&shstr, ".rodata")
    int n_data = strtab_add(&shstr, ".data")
    int n_rtext = strtab_add(&shstr, ".rela.text")
    int n_rdata = strtab_add(&shstr, ".rela.data")
    int n_symtab = strtab_add(&shstr, ".symtab")
    int n_strtab = strtab_add(&shstr, ".strtab")
    int n_shstr = strtab_add(&shstr, ".shstrtab")
    int n_stack = strtab_add(&shstr, ".note.GNU-stack")   // (a non-executable stack)

    u8[dynamic] ob = []
    EOut o = EOut{ ob }
    ezero(&o, 64)                                   // the header, written at the end
    epad(&o, 16)
    int off_text = o.b.len
    ebytes(&o, text)
    epad(&o, 16)
    int off_rodata = o.b.len
    ebytes(&o, f.rdata)
    epad(&o, 16)
    int off_data = o.b.len
    ebytes(&o, data)
    epad(&o, 8)
    int off_rtext = o.b.len
    ebytes(&o, rt.b)
    int off_rdata = o.b.len
    ebytes(&o, rd.b)
    int off_sym = o.b.len
    ebytes(&o, sym.b)
    int off_str = o.b.len
    ebytes(&o, strtab.b)
    int off_shstr = o.b.len
    ebytes(&o, shstr.b)
    epad(&o, 8)
    int shoff = o.b.len
    ezero(&o, 64)                                                                  // 0: null
    sec_header(&o, n_text, 1, 6, off_text, text.len, 0, 0, 16, 0)                  // 1: .text
    sec_header(&o, n_rodata, 1, 2, off_rodata, f.rdata.len, 0, 0, 16, 0)           // 2: .rodata
    sec_header(&o, n_data, 1, 3, off_data, data.len, 0, 0, 16, 0)                  // 3: .data
    sec_header(&o, n_rtext, 4, 64, off_rtext, rt.b.len, 6, 1, 8, 24)               // 4: .rela.text
    sec_header(&o, n_rdata, 4, 64, off_rdata, rd.b.len, 6, 3, 8, 24)               // 5: .rela.data
    sec_header(&o, n_symtab, 2, 0, off_sym, sym.b.len, 7, first_global, 8, 24)     // 6: .symtab
    sec_header(&o, n_strtab, 3, 0, off_str, strtab.b.len, 0, 0, 1, 0)              // 7: .strtab
    sec_header(&o, n_shstr, 3, 0, off_shstr, shstr.b.len, 0, 0, 1, 0)              // 8: .shstrtab
    sec_header(&o, n_stack, 1, 0, off_shstr, 0, 0, 0, 1, 0)                        // 9: .note.GNU-stack
    u8[dynamic] hb = []
    EOut h = EOut{ hb }
    elf_header(&h, 1, 0, 0, 0, shoff, 10, 8)
    for i in 0..64 { o.b[i] = h.b[i] }
    return o.b
}

export bool write_elf(string path, ObjFile* f) {
    u8[dynamic] b = elf_bytes(f)
    return strata_write_bytes(path, &b)
}

// ======== the linker ==========================================================================
// ELF objects (the program's, the runtime's lib/srt-linux-x64.o, the stubs) -> a static
// executable: their sections merged into .text / .rodata / .data / .bss, symbols resolved,
// relocations applied (R_X86_64_64, PC32, PLT32, 32, 32S), laid out at 0x400000 in three
// PT_LOAD segments (r-x, r--, rw-), entry `_start`.

struct ESec {
    int    obj
    string name
    int    out          // 0 .text, 1 .rodata, 2 .data, 3 .bss; -1 dropped
    int    raw          // file offset of its bytes in the object
    int    size
    int    align
    int    at           // offset within its output section
}

struct ESym { string name; int value; int shndx; int bind }

struct EObj {
    string         name
    u8[dynamic]    b
    int            first      // its sections: secs[first .. first + nsec)
    int            nsec
    ESym[dynamic]  syms
    int[dynamic]   rela_at    // per relocation section: file offset, entry count, the section it applies to
    int[dynamic]   rela_n
    int[dynamic]   rela_to
}

export struct ElfLinker {
    bool            ok
    string          err
    EObj[dynamic]   objs
    ESec[dynamic]   secs
    string[dynamic] gname     // global definitions: name -> section (index into secs) + value
    int[dynamic]    gsec
    int[dynamic]    gval
    NameIdx         gidx
    int[dynamic]    osize     // per output section
    int[dynamic]    oaddr
    string[dynamic] needed    // the shared libraries (SONAMEs)
    string[dynamic] imports   // the functions they provide this program
}

export ElfLinker* new_elf_linker() {
    EObj[dynamic] o = []
    ESec[dynamic] s = []
    string[dynamic] gn = []
    int[dynamic] gs = []
    int[dynamic] gv = []
    int[dynamic] a = []
    int[dynamic] b = []
    string[dynamic] nd = []
    string[dynamic] im = []
    return alloc(ElfLinker{ true, "", o, s, gn, gs, gv, new_idx(4096), a, b, nd, im })
}

void ek_fail(ElfLinker* l, string msg) {
    if l.ok { l.err = msg }
    l.ok = false
}

string cstr_at(u8[dynamic] b, int at) { return strata_bytes_cstr(&b, at, 4096) }

int out_class(string name, int type, int flags) {
    if (flags & 2) == 0 { return 0 - 1 }                      // not loaded (symbols, notes, ...)
    if type == 8 { return 3 }                                 // NOBITS: .bss
    if (flags & 4) != 0 { return 0 }                          // code
    if (flags & 1) != 0 { return 2 }                          // writable data
    return 1                                                  // read-only data
}

int find_eglobal(ElfLinker* l, string name) {
    int found = 0 - 1
    int k = idx_first(&l.gidx, name)
    while k >= 0 && found < 0 {
        if l.gname[k] == name { found = k }
        k = idx_next(&l.gidx, k)
    }
    return found
}

// Add an ELF relocatable object (its bytes).
export void elf_add(ElfLinker* l, string name, u8[dynamic] b) {
    if b.len < 64 || rd32le(b, 0) != 1179403647 || rd16le(b, 18) != 62 || rd16le(b, 16) != 1 {
        ek_fail(l, name + " is not an x86-64 ELF object")
        return
    }
    int shoff = rd64le(b, 40)
    int shnum = rd16le(b, 60)
    int shstrndx = rd16le(b, 62)
    int strsec_off = rd64le(b, shoff + 64 * shstrndx + 24)
    int first = l.secs.len
    int oi = l.objs.len
    int symtab = 0 - 1
    ESym[dynamic] syms = []
    int[dynamic] ra = []
    int[dynamic] rn = []
    int[dynamic] rt = []
    for k in 0..shnum {
        int h = shoff + 64 * k
        string nm = cstr_at(b, strsec_off + rd32le(b, h))
        int type = rd32le(b, h + 4)
        int flags = rd64le(b, h + 8)
        int off = rd64le(b, h + 24)
        int size = rd64le(b, h + 32)
        int al = rd64le(b, h + 48)
        if al < 1 { al = 1 }
        int cls = 0 - 1
        if k > 0 { cls = out_class(nm, type, flags) }
        l.secs.push(ESec{ oi, nm, cls, off, size, al, 0 })
        if type == 2 { symtab = k }
        if type == 4 { ra.push(off); rn.push(size / 24); rt.push(rd32le(b, h + 44)) }
    }
    if symtab >= 0 {
        int h = shoff + 64 * symtab
        int off = rd64le(b, h + 24)
        int n = rd64le(b, h + 32) / 24
        int stroff = rd64le(b, shoff + 64 * rd32le(b, h + 40) + 24)
        for i in 0..n {
            int at = off + 24 * i
            string nm = cstr_at(b, stroff + rd32le(b, at))
            int info = rd8(b, at + 4)
            syms.push(ESym{ nm, rd64le(b, at + 8), rd16le(b, at + 6), info / 16 })
        }
    }
    l.objs.push(EObj{ name, b, first, shnum, syms, ra, rn, rt })
    for i in 0..syms.len {
        ESym s = syms[i]
        if s.bind == 1 && s.shndx != 0 && s.shndx < 65280 {
            if find_eglobal(l, s.name) >= 0 { ek_fail(l, "'" + s.name + "' is defined twice (" + name + ")") }
            idx_add(&l.gidx, s.name, l.gname.len)
            l.gname.push(s.name)
            l.gsec.push(first + s.shndx)
            l.gval.push(s.value)
        }
    }
}

// the address of symbol `si` of object `oi`
int esym_addr(ElfLinker* l, int oi, int si) {
    EObj o = l.objs[oi]
    ESym s = o.syms[si]
    if s.shndx == 65521 { return s.value }                    // SHN_ABS
    if s.shndx != 0 {
        ESec sec = l.secs[o.first + s.shndx]
        if sec.out < 0 { ek_fail(l, "a reference to the dropped section " + sec.name + " (" + o.name + ")"); return 0 }
        return l.oaddr[sec.out] + sec.at + s.value
    }
    int g = find_eglobal(l, s.name)
    if g < 0 { ek_fail(l, "undefined symbol '" + s.name + "' (in " + o.name + ")"); return 0 }
    if l.gsec[g] < 0 { return l.gval[g] }                      // an import: its stub
    ESec gs = l.secs[l.gsec[g]]
    return l.oaddr[gs.out] + gs.at + l.gval[g]
}

void put32le(u8[dynamic]* b, int at, int v) { for i in 0..4 { b[0][at + i] = cast<u8>((v >> (8 * i)) & 255) } }
void put64le(u8[dynamic]* b, int at, int v) {
    u64 x = cast<u64>(v)
    for i in 0..8 {
        b[0][at + i] = cast<u8>(cast<int>(x & cast<u64>(255)))
        x = x >> cast<u64>(8)
    }
}

int ealign(int n, int a) { return (n + a - 1) / a * a }

// ---- shared libraries (dynamic linking) --------------------------------------------------------
// A program that calls functions it doesn't define (foreign functions, `link "x"`) gets
// them from shared libraries at startup: the executable names the dynamic loader
// (PT_INTERP) and its libraries (DT_NEEDED), each call goes through an 8-byte stub
// `jmp *slot(%rip)`, and the loader fills the slots (R_X86_64_GLOB_DAT, all at startup:
// BIND_NOW). The C library is always among them then; and the program exits through its
// `exit` (flushing C's buffers too).

// the file a `link "name"` stands for, as the loader knows it (its SONAME)
string known_soname(string name) {
    if name == "c" { return "libc.so.6" }
    if name == "m" { return "libm.so.6" }
    if name == "dl" { return "libdl.so.2" }
    if name == "pthread" { return "libpthread.so.0" }
    if name == "rt" { return "librt.so.1" }
    if name == "X11" { return "libX11.so.6" }
    if name == "Xext" { return "libXext.so.6" }
    if name == "Xrandr" { return "libXrandr.so.2" }
    if name == "Xi" { return "libXi.so.6" }
    if name == "Xcursor" { return "libXcursor.so.1" }
    if name == "GL" { return "libGL.so.1" }
    if name == "EGL" { return "libEGL.so.1" }
    if name == "asound" { return "libasound.so.2" }
    if name == "raylib" { return "libraylib.so.550" }
    return ""
}

// DT_SONAME of the ELF shared library in b ("" if it isn't one / has none)
string soname_of(u8[dynamic] b) {
    if b.len < 64 || rd32le(b, 0) != 1179403647 { return "" }
    int shoff = rd64le(b, 40)
    int shnum = rd16le(b, 60)
    for k in 0..shnum {
        int h = shoff + 64 * k
        if rd32le(b, h + 4) == 6 {                                // SHT_DYNAMIC
            int off = rd64le(b, h + 24)
            int size = rd64le(b, h + 32)
            int stroff = rd64le(b, shoff + 64 * rd32le(b, h + 40) + 24)
            int e = 0
            while e + 16 <= size {
                if rd64le(b, off + e) == 14 { return cstr_at(b, stroff + rd64le(b, off + e + 8)) }   // DT_SONAME
                e += 16
            }
        }
    }
    return ""
}

// Note the shared library `name` (`link "name"`): libname.so in `dirs` or the system's
// library folders gives its SONAME; else a well-known one; else "libname.so".
export bool elf_library(ElfLinker* l, string name, string[dynamic] dirs) {
    string[dynamic] where = []
    for i in 0..dirs.len { where.push(dirs[i]) }
    where.push("/lib/x86_64-linux-gnu")
    where.push("/usr/lib/x86_64-linux-gnu")
    where.push("/lib64")
    where.push("/usr/lib64")
    where.push("/usr/local/lib")
    where.push("/usr/lib")
    where.push("/lib")
    string so = ""
    if strata_host_os() == "linux" {
        int w = 0
        while so == "" && w < where.len {
            string p = where[w] + "/lib" + name + ".so"
            if strata_file_exists(p) { so = soname_of(strata_read_bytes(p)) }
            w += 1
        }
    }
    if so == "" { so = known_soname(name) }
    if so == "" { so = "lib" + name + ".so" }
    bool have = false
    for i in 0..l.needed.len { if l.needed[i] == so { have = true } }
    if !have { l.needed.push(so) }
    return true
}

// the System V hash of a symbol name (DT_HASH)
int elf_hash(string s) {
    int h = 0
    for i in 0..s.len {
        h = (h << 4) + cast<int>(s[i])
        int g = h & 4026531840
        if g != 0 { h = h ^ (g >> 24) }
        h = h & 268435455
    }
    return h
}

// The program's entry: argc and argv from the stack, main (System V: rdi, rsi; the stack
// 16-byte aligned), then out: srt_os_exit (a static program) or, with shared libraries,
// srt_os_flush and the C library's exit.
string start_stub(bool dynamic) {
    string[dynamic] p = []
    p.push("\t.text\n\t.globl _start\n_start:\n")
    p.push("\tmovq 0(%rsp), %rdi\n\tleaq 8(%rsp), %rsi\n")
    p.push("\tandq $-16, %rsp\n")
    p.push("\tcall main\n\tmovl %eax, %edi\n")
    if dynamic { p.push("\tpushq %rdi\n\tpushq %rdi\n\tcall srt_os_flush\n\tpopq %rdi\n\tpopq %rdi\n\tcall exit\n") }
    else { p.push("\tcall srt_os_exit\n") }
    return strata_join(&p)
}

// srt_syscall(n, a1 .. a6): System V (rdi, rsi, rdx, rcx, r8, r9, then the stack) -> the
// kernel's (rax; rdi, rsi, rdx, r10, r8, r9).
string syscall_stub() {
    string[dynamic] p = []
    p.push("\t.text\n\t.globl srt_syscall\nsrt_syscall:\n")
    p.push("\tmovq %rdi, %rax\n\tmovq %rsi, %rdi\n\tmovq %rdx, %rsi\n\tmovq %rcx, %rdx\n")
    p.push("\tmovq %r8, %r10\n\tmovq %r9, %r8\n\tmovq 8(%rsp), %r9\n")
    p.push("\tsyscall\n\tret\n")
    return strata_join(&p)
}

// every symbol a kept section refers to that no object defines: imports
void find_elf_imports(ElfLinker* l) {
    for oi in 0..l.objs.len {
        EObj o = l.objs[oi]
        for r in 0..o.rela_at.len {
            ESec tgt = l.secs[o.first + o.rela_to[r]]
            if tgt.out >= 0 {
                for k in 0..o.rela_n[r] {
                    int info = rd64le(o.b, o.rela_at[r] + 24 * k + 8)
                    int si = cast<int>(cast<u64>(info) >> cast<u64>(32))
                    ESym s = o.syms[si]
                    if s.shndx == 0 && s.name != "" && find_eglobal(l, s.name) < 0 {
                        bool have = false
                        for i in 0..l.imports.len { if l.imports[i] == s.name { have = true } }
                        if !have { l.imports.push(s.name) }
                    }
                }
            }
        }
    }
}

// Link everything added so far into the executable `path`. False (with l.err) on failure.
export bool elf_link_exe(ElfLinker* l, string path) {
    if find_eglobal(l, "main") < 0 { ek_fail(l, "no main"); return false }
    // imports from shared libraries? (then: dynamic, with the C library)
    for k in 0..4 { l.osize.push(0); l.oaddr.push(0) }
    ObjFile sc = assemble(syscall_stub(), "x64")
    if !sc.ok { ek_fail(l, "syscall: " + sc.err); return false }
    elf_add(l, "syscall", elf_bytes(&sc))
    find_elf_imports(l)
    bool dynamic = l.imports.len > 0
    ObjFile st = assemble(start_stub(dynamic), "x64")
    if !st.ok { ek_fail(l, "start: " + st.err); return false }
    elf_add(l, "start", elf_bytes(&st))
    if !l.ok { return false }
    if dynamic {
        string[dynamic] none = []
        elf_library(l, "c", none)
        l.imports = []
        find_elf_imports(l)                      // (now with the stub's `exit`)
    }
    int ni = l.imports.len

    // place the input sections
    for si in 0..l.secs.len {
        int out = l.secs[si].out
        if out >= 0 {
            int at = ealign(l.osize[out], l.secs[si].align)
            l.secs[si].at = at
            l.osize[out] = at + l.secs[si].size
        }
    }
    int stubs_at = ealign(l.osize[0], 16)        // the import stubs, after the code
    l.osize[0] = stubs_at + 8 * ni

    // the dynamic linking tables (in the first segment, before the code): the loader's
    // name, .hash, .dynsym, .dynstr, .rela.dyn; in the data segment: the slots, .dynamic
    string interp = "/lib64/ld-linux-x86-64.so.2"
    u8[dynamic] dsb = []
    StrTab dynstr = StrTab{ dsb }
    dynstr.b.push(cast<u8>(0))
    int[dynamic] need_off = []
    for i in 0..l.needed.len { need_off.push(strtab_add(&dynstr, l.needed[i])) }
    int[dynamic] name_off = []
    for i in 0..ni { name_off.push(strtab_add(&dynstr, l.imports[i])) }
    int nsym = ni + 1
    int base = 4194304                                      // 0x400000
    int nph = 4                                             // 3 PT_LOAD + PT_GNU_STACK
    if dynamic { nph = 7 }                                  // + PT_PHDR, PT_INTERP, PT_DYNAMIC
    int at = 64 + 56 * nph
    int interp_off = at
    int hash_off = 0
    int dynsym_off = 0
    int dynstr_off = 0
    int rela_off = 0
    if dynamic {
        at = ealign(interp_off + interp.len + 1, 8)
        hash_off = at
        at = hash_off + 4 * (2 + 1 + nsym)                  // nbucket, nchain, 1 bucket, the chains
        at = ealign(at, 8)
        dynsym_off = at
        at = dynsym_off + 24 * nsym
        dynstr_off = at
        at = dynstr_off + dynstr.b.len
        at = ealign(at, 8)
        rela_off = at
        at = rela_off + 24 * ni
    }
    int text_off = ealign(at, 16)
    int ro_off = ealign(text_off + l.osize[0], 4096)
    int data_off = ealign(ro_off + l.osize[1], 4096)
    int got_at = ealign(l.osize[2], 8)                      // the slots, after the data
    int dyn_at = got_at + 8 * ni                            // then .dynamic
    int ndyn = l.needed.len + 13
    int data_size = l.osize[2]
    if dynamic { data_size = dyn_at + 16 * ndyn }
    int bss_at = ealign(data_size, 16)
    l.oaddr[0] = base + text_off
    l.oaddr[1] = base + ro_off
    l.oaddr[2] = base + data_off
    l.oaddr[3] = base + data_off + bss_at
    int got_addr = base + data_off + got_at
    int stubs_addr = l.oaddr[0] + stubs_at
    // the imports, as symbols: their stubs
    for i in 0..ni {
        idx_add(&l.gidx, l.imports[i], l.gname.len)
        l.gname.push(l.imports[i])
        l.gsec.push(0 - 1)                                  // (marks an import)
        l.gval.push(stubs_addr + 8 * i)
    }

    u8[dynamic] text = []
    u8[dynamic] ro = []
    u8[dynamic] data = []
    for i in 0..l.osize[0] { text.push(cast<u8>(204)) }    // int3 between functions
    for i in 0..l.osize[1] { ro.push(cast<u8>(0)) }
    for i in 0..data_size { data.push(cast<u8>(0)) }
    for si in 0..l.secs.len {
        ESec s = l.secs[si]
        if s.out >= 0 && s.out != 3 {
            u8[dynamic] src = l.objs[s.obj].b
            for i in 0..s.size {
                if s.out == 0 { text[s.at + i] = src[s.raw + i] }
                else if s.out == 1 { ro[s.at + i] = src[s.raw + i] }
                else { data[s.at + i] = src[s.raw + i] }
            }
        }
    }
    // import stubs: jmp *slot(%rip)
    for i in 0..ni {
        int p = stubs_at + 8 * i
        text[p] = cast<u8>(255)
        text[p + 1] = cast<u8>(37)
        put32le(&text, p + 2, (got_addr + 8 * i) - (l.oaddr[0] + p + 6))
    }
    // relocations
    for oi in 0..l.objs.len {
        EObj o = l.objs[oi]
        for r in 0..o.rela_at.len {
            ESec tgt = l.secs[o.first + o.rela_to[r]]
            if tgt.out >= 0 {
                for k in 0..o.rela_n[r] {
                    int ra = o.rela_at[r] + 24 * k
                    int off = rd64le(o.b, ra)
                    int info = rd64le(o.b, ra + 8)
                    int addend = rd64le(o.b, ra + 16)
                    int typ = info & 4294967295
                    int si = cast<int>(cast<u64>(info) >> cast<u64>(32))
                    int sv = esym_addr(l, oi, si)
                    int p = tgt.at + off
                    int pa = l.oaddr[tgt.out] + p
                    if tgt.out == 3 { ek_fail(l, "relocations in .bss") }
                    else if typ == 1 {
                        if tgt.out == 0 { put64le(&text, p, sv + addend) } else if tgt.out == 1 { put64le(&ro, p, sv + addend) } else { put64le(&data, p, sv + addend) }
                    } else if typ == 2 || typ == 4 || typ == 10 || typ == 11 {
                        int v = sv + addend
                        if typ == 2 || typ == 4 { v = v - pa }
                        if tgt.out == 0 { put32le(&text, p, v) } else if tgt.out == 1 { put32le(&ro, p, v) } else { put32le(&data, p, v) }
                    } else if typ != 0 {
                        ek_fail(l, "unsupported relocation type " + int_to_str(typ) + " in " + o.name)
                    }
                }
            }
        }
    }
    if !l.ok { return false }
    // .dynamic: the libraries, then where the tables are
    if dynamic {
        int d = dyn_at
        for i in 0..l.needed.len { put64le(&data, d, 1); put64le(&data, d + 8, need_off[i]); d += 16 }   // DT_NEEDED
        put64le(&data, d, 4); put64le(&data, d + 8, base + hash_off); d += 16           // DT_HASH
        put64le(&data, d, 5); put64le(&data, d + 8, base + dynstr_off); d += 16         // DT_STRTAB
        put64le(&data, d, 6); put64le(&data, d + 8, base + dynsym_off); d += 16         // DT_SYMTAB
        put64le(&data, d, 10); put64le(&data, d + 8, dynstr.b.len); d += 16             // DT_STRSZ
        put64le(&data, d, 11); put64le(&data, d + 8, 24); d += 16                       // DT_SYMENT
        put64le(&data, d, 7); put64le(&data, d + 8, base + rela_off); d += 16           // DT_RELA
        put64le(&data, d, 8); put64le(&data, d + 8, 24 * ni); d += 16                   // DT_RELASZ
        put64le(&data, d, 9); put64le(&data, d + 8, 24); d += 16                        // DT_RELAENT
        put64le(&data, d, 30); put64le(&data, d + 8, 8); d += 16                        // DT_FLAGS: BIND_NOW
        put64le(&data, d, 1879048187); put64le(&data, d + 8, 1); d += 16                // DT_FLAGS_1: NOW
        put64le(&data, d, 21); put64le(&data, d + 8, 0); d += 16                        // DT_DEBUG
        put64le(&data, d, 0); put64le(&data, d + 8, 0)                                  // DT_NULL
    }
    int g = find_eglobal(l, "_start")
    ESec es = l.secs[l.gsec[g]]
    int entry = l.oaddr[es.out] + es.at + l.gval[g]

    // the file
    u8[dynamic] fb = []
    EOut o = EOut{ fb }
    elf_header(&o, 2, entry, 64, nph, 0, 0, 0)
    // program headers: type, flags, offset, vaddr, paddr, filesz, memsz, align
    if dynamic {
        e32(&o, 6); e32(&o, 4); e64(&o, 64); e64(&o, base + 64); e64(&o, base + 64)                                   // PT_PHDR
        e64(&o, 56 * nph); e64(&o, 56 * nph); e64(&o, 8)
        e32(&o, 3); e32(&o, 4); e64(&o, interp_off); e64(&o, base + interp_off); e64(&o, base + interp_off)          // PT_INTERP
        e64(&o, interp.len + 1); e64(&o, interp.len + 1); e64(&o, 1)
    }
    e32(&o, 1); e32(&o, 5); e64(&o, 0); e64(&o, base); e64(&o, base)
    e64(&o, text_off + l.osize[0]); e64(&o, text_off + l.osize[0]); e64(&o, 4096)
    e32(&o, 1); e32(&o, 4); e64(&o, ro_off); e64(&o, base + ro_off); e64(&o, base + ro_off)
    e64(&o, l.osize[1]); e64(&o, l.osize[1]); e64(&o, 4096)
    e32(&o, 1); e32(&o, 6); e64(&o, data_off); e64(&o, base + data_off); e64(&o, base + data_off)
    e64(&o, data_size); e64(&o, bss_at + l.osize[3]); e64(&o, 4096)
    if dynamic {
        e32(&o, 2); e32(&o, 6); e64(&o, data_off + dyn_at); e64(&o, base + data_off + dyn_at); e64(&o, base + data_off + dyn_at)   // PT_DYNAMIC
        e64(&o, 16 * ndyn); e64(&o, 16 * ndyn); e64(&o, 8)
    }
    e32(&o, 1685382481); e32(&o, 6); e64(&o, 0); e64(&o, 0); e64(&o, 0); e64(&o, 0); e64(&o, 0); e64(&o, 16)   // PT_GNU_STACK: not executable
    if dynamic {
        // the loader's name; .hash (one bucket); .dynsym (the imports: undefined functions);
        // .dynstr; .rela.dyn (fill each slot with its symbol's address)
        for i in 0..interp.len { e8(&o, cast<int>(interp[i])) }
        e8(&o, 0)
        while o.b.len < hash_off { e8(&o, 0) }
        e32(&o, 1)
        e32(&o, nsym)
        int[dynamic] chain = []
        for i in 0..nsym { chain.push(0) }
        int head = 0
        for i in 1..nsym { chain[i] = head; head = i }
        e32(&o, head)
        for i in 0..nsym { e32(&o, chain[i]) }
        while o.b.len < dynsym_off { e8(&o, 0) }
        ezero(&o, 24)
        for i in 0..ni { e32(&o, name_off[i]); e8(&o, 18); e8(&o, 0); e16(&o, 0); e64(&o, 0); e64(&o, 0) }   // GLOBAL FUNC, undefined
        ebytes(&o, dynstr.b)
        while o.b.len < rela_off { e8(&o, 0) }
        for i in 0..ni { e64(&o, got_addr + 8 * i); e64(&o, (i + 1) * 4294967296 + 6); e64(&o, 0) }        // R_X86_64_GLOB_DAT
    }
    while o.b.len < text_off { e8(&o, 0) }
    ebytes(&o, text)
    while o.b.len < ro_off { e8(&o, 0) }
    ebytes(&o, ro)
    while o.b.len < data_off { e8(&o, 0) }
    ebytes(&o, data)
    if !strata_write_bytes(path, &o.b) { ek_fail(l, "cannot write " + path); return false }
    // runnable (on a Linux / macOS machine: building on Windows, it's copied there)
    if strata_host_os() != "windows" {
        string[dynamic] chmod = ["chmod", "+x", path]
        strata_run_argv(&chmod)
    }
    return true
}
