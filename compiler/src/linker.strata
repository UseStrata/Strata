//
// src/linker.strata - from the native backend's objects to a program, for any OS. CORE.
//
// The one place the rest of the compiler goes to write object files and link: each call
// hands the work to the target OS's file in os/ (os/windows.strata: COFF objects, the PE
// linker, import libraries; os/linux.strata: ELF objects and linker; os/macos.strata:
// Mach-O objects and linker, code signing). A Link collects the objects and libraries of
// one program.

import asm          // ObjFile
import host         // strata_write_bytes
import os.windows
import os.linux
import os.macos

export struct Link {
    string      os          // "windows", "linux", "macos"
    Linker*     win
    ElfLinker*  lin
    MachLinker* mac
}

export Link new_link(string os) { return Link{ os, new_linker(), new_elf_linker(), new_mach_linker() } }

// can we link programs for this OS? ("" if yes, else why not)
export string link_target_why(string os) {
    if os == "windows" || os == "linux" || os == "macos" { return "" }
    return "Strata's linker makes Windows, Linux and macOS programs (this is " + os + ")"
}

// an assembled object, as the OS's object file
export u8[dynamic] object_bytes(string os, ObjFile* o) {
    if os == "linux" { return elf_bytes(o) }
    if os == "macos" { return macho_bytes(o) }
    return coff_bytes(o)
}

export bool write_object(string os, string path, ObjFile* o) {
    if os == "linux" { return write_elf(path, o) }
    if os == "macos" { return write_macho(path, o) }
    return write_coff(path, o)
}

// add an object file (its bytes) to the program
export void link_object(Link* k, string name, u8[dynamic] bytes) {
    if k.os == "linux" { elf_add(k.lin, name, bytes) }
    else if k.os == "macos" { mach_add(k.mac, name, bytes) }
    else { link_add(k.win, name, bytes) }
}

// the library `name` of a `link "name"` (a shared library the program will load); false
// if the OS's linker can't use it (then a C toolchain must link, on Windows)
export bool link_lib(Link* k, string name, string[dynamic] dirs) {
    if k.os == "linux" { return elf_library(k.lin, name, dirs) }
    if k.os == "macos" { return mach_library(k.mac, name, dirs) }
    return link_library(k.win, name, dirs)
}

// where the libraries added so far were found (Linux: their names)
export string[dynamic] link_lib_paths(Link* k) {
    if k.os == "linux" { return k.lin.needed }
    if k.os == "macos" { return k.mac.dylibs }
    return k.win.dll_path
}

export bool link_failed(Link* k) {
    if k.os == "linux" { return !k.lin.ok }
    if k.os == "macos" { return !k.mac.ok }
    return !k.win.ok
}
export string link_error(Link* k) {
    if k.os == "linux" { return k.lin.err }
    if k.os == "macos" { return k.mac.err }
    return k.win.err
}

// Link everything into `out`: an executable, or a shared library exporting `exports`
// (then also its import libraries beside it). False (see link_error) on failure.
export bool link_program(Link* k, string out, bool dll, string[dynamic] exports) {
    if k.os == "linux" {
        if !k.lin.ok { return false }
        if dll { return elf_link_so(k.lin, out, exports) }
        return elf_link_exe(k.lin, out)
    }
    if k.os == "macos" {
        if !k.mac.ok { return false }
        if dll { return mach_link_dylib(k.mac, out, exports) }
        return mach_link_exe(k.mac, out)
    }
    if !k.win.ok { return false }
    if !dll { return link_exe(k.win, out) }
    if !link_dll(k.win, out, exports) { return false }
    string stem = out
    if stem.len > 4 && substr(stem, stem.len - 4, 4) == ".dll" { stem = substr(stem, 0, stem.len - 4) }
    string base = out
    for i in 0..out.len { if out[i] == '/' || out[i] == '\\' { base = substr(out, i + 1, out.len - i - 1) } }
    u8[dynamic] implib = import_library(base, exports)
    strata_write_bytes(stem + ".dll.a", &implib)
    strata_write_bytes(stem + ".lib", &implib)
    return true
}
