//
// src/dump.strata - human-readable rendering of the core's data (tokens + AST).
//
// A shared FRONT-END utility, not part of the compiler core: it consumes core data and
// turns it into text. Both the `strata` CLI and the `console` include this, so the
// rendering lives in one place (ARCHITECTURE.md: one core, many faces).

import core

// ============================ token printing ============================

bool is_text_kind(TokKind k) {
    switch (k) {
        case TkIdent, TkInt, TkFloat, TkString, TkChar: return true
        default: return false
    }
    return false
}

string pad_left(string s, int w)  { string r = s; while (r.len < w) { r = " " + r; } return r; }
string pad_right(string s, int w) { string r = s; while (r.len < w) { r = r + " "; } return r; }

void print_token(Token t) {
    string loc  = pad_left(int_to_str(t.line), 3) + ":" + pad_right(int_to_str(t.col), 3)
    string name = kind_name(t.kind)
    if (is_text_kind(t.kind)) { print(loc + "  " + pad_right(name, 8) + "  " + t.text); }
    else                      { print(loc + "  " + name); }
}

export void print_tokens(Token[dynamic] toks) {
    for i in 0..toks.len { print_token(toks[i]); }
}

// ============================ AST printing ==============================

string repeat2(int n) { string r = ""; for i in 0..n { r = r + "  "; } return r; }
void pr(int ind, string s) { print(repeat2(ind) + s); }

string ast_type_str(TypeNode* t) {
    if (t == null) { return "<none>"; }
    switch (t.kind) {
        case TyNamed:      return t.name
        case TyArray:      return ast_type_str(t.elem) + "[]"
        case TyFixedArray: return ast_type_str(t.elem) + "[" + t.size + "]"
        case TyDynArray:   return ast_type_str(t.elem) + "[dynamic]"
        case TyPointer:    return ast_type_str(t.elem) + "*"
    }
    return "?"
}

void pr_expr(int ind, Expr* e) {
    if (e == null) { pr(ind, "<null>"); return; }
    // a very long operator chain nests this deep (the parser allows any length): stop
    // printing there instead of recursing (and indenting) without bound
    if ind > 400 { pr(ind, "... (nested more than 400 levels deep)"); return }
    switch (e.kind) {
        case ExIntLit:    pr(ind, "Int " + e.text)
        case ExFloatLit:  pr(ind, "Float " + e.text)
        case ExStringLit: pr(ind, "String \"" + e.text + "\"")
        case ExCharLit:   pr(ind, "Char '" + e.text + "'")
        case ExBoolLit:   if (e.bval) { pr(ind, "Bool true"); } else { pr(ind, "Bool false"); }
        case ExName:      pr(ind, "Name " + e.text)
        case ExUnary:     pr(ind, "Unary " + e.text); pr_expr(ind + 1, e.a)
        case ExBinary:    pr(ind, "Binary " + e.text); pr_expr(ind + 1, e.a); pr_expr(ind + 1, e.b)
        case ExCall:
            pr(ind, "Call")
            pr(ind + 1, "callee:")
            pr_expr(ind + 2, e.a)
            if (e.items.len > 0) {
                pr(ind + 1, "args:")
                for i in 0..e.items.len { pr_expr(ind + 2, e.items[i]); }
            }
        case ExField:     pr(ind, "Field ." + e.field); pr_expr(ind + 1, e.a)
        case ExIndex:     pr(ind, "Index"); pr_expr(ind + 1, e.a); pr_expr(ind + 1, e.b)
        case ExArrayLit:  pr(ind, "ArrayLit"); for i in 0..e.items.len { pr_expr(ind + 1, e.items[i]); }
        case ExStructLit: pr(ind, "StructLit " + e.type_name); for i in 0..e.items.len { pr_expr(ind + 1, e.items[i]); }
        case ExCast:      pr(ind, "Cast " + ast_type_str(e.type)); pr_expr(ind + 1, e.a)
        case ExSizeof:    pr(ind, "Sizeof " + ast_type_str(e.type))
        default:          pr(ind, "?expr")
    }
}

void pr_stmt(int ind, Stmt* s) {
    if (s == null) { pr(ind, "<null>"); return; }
    switch (s.kind) {
        case StBlock:
            pr(ind, "Block")
            for i in 0..s.stmts.len { pr_stmt(ind + 1, s.stmts[i]); }
        case StVar:
            {
                string head = "Var "
                if (s.is_const) { head = head + "const "; }
                if (s.type == null) { head = head + "var"; } else { head = head + ast_type_str(s.type); }
                head = head + " " + s.name
                pr(ind, head)
                if (s.init != null) { pr(ind + 1, "="); pr_expr(ind + 2, s.init); }
            }
        case StReturn:   pr(ind, "Return"); if (s.expr != null) { pr_expr(ind + 1, s.expr); }
        case StExprStmt: pr(ind, "ExprStmt"); pr_expr(ind + 1, s.expr)
        case StBreak:    pr(ind, "Break")
        case StContinue: pr(ind, "Continue")
        case StAssign:
            pr(ind, "Assign " + s.op)
            pr(ind + 1, "target:"); pr_expr(ind + 2, s.target)
            pr(ind + 1, "value:");  pr_expr(ind + 2, s.value)
        case StIf:
            pr(ind, "If")
            pr(ind + 1, "cond:"); pr_expr(ind + 2, s.cond)
            pr(ind + 1, "then:"); pr_stmt(ind + 2, s.then_block)
            if (s.else_branch != null) { pr(ind + 1, "else:"); pr_stmt(ind + 2, s.else_branch); }
        case StWhile:
            pr(ind, "While")
            pr(ind + 1, "cond:"); pr_expr(ind + 2, s.cond)
            pr_stmt(ind + 1, s.body)
        case StForIn:
            pr(ind, "ForIn " + s.name)
            pr(ind + 1, "iter:"); pr_expr(ind + 2, s.iter)
            pr_stmt(ind + 1, s.body)
        case StRegion:
            if (s.name.len > 0) { pr(ind, "Region " + s.name); } else { pr(ind, "Region"); }
            pr_stmt(ind + 1, s.body)
        case StSwitch:
            pr(ind, "Switch")
            pr(ind + 1, "subject:"); pr_expr(ind + 2, s.subject)
            for i in 0..s.cases.len {
                SwitchCase c = s.cases[i]
                if (c.is_default) { pr(ind + 1, "default:"); }
                else { pr(ind + 1, "case:"); for j in 0..c.values.len { pr_expr(ind + 2, c.values[j]); } }
                pr_stmt(ind + 2, c.body)
            }
        default:
            pr(ind, "?stmt")
    }
}

void pr_decl(Decl* d) {
    string ex = ""
    if (d.is_exported) { ex = "export "; }
    switch (d.kind) {
        case DcFunc:
            {
                string head = ex + "Func " + ast_type_str(d.ret) + " " + d.name + "("
                for i in 0..d.params.len {
                    if (i > 0) { head = head + ", "; }
                    head = head + ast_type_str(d.params[i].type) + " " + d.params[i].name
                }
                head = head + ")"
                if d.is_foreign { pr(0, "Foreign " + head) }
                else { pr(0, head); pr_stmt(1, d.body) }
            }
        case DcGlobal:
            pr(0, ex + "Global " + ast_type_str(d.ret) + " " + d.name)
            if d.init != null { pr_expr(1, d.init) }
        case DcEnum:
            pr(0, ex + "Enum " + d.name)
            for i in 0..d.members.len { pr(1, d.members[i]); }
        case DcStruct:
            pr(0, ex + "Struct " + d.name)
            for i in 0..d.fields.len { pr(1, ast_type_str(d.fields[i].type) + " " + d.fields[i].name); }
        case DcInclude:
            if (d.is_system) { pr(0, "Import <" + d.path + ">"); } else { pr(0, "Import \"" + d.path + "\""); }
        case DcLink:
            pr(0, "Link \"" + d.path + "\"")
        case DcImport:
            if (d.is_exported) { pr(0, "Import module " + d.path + " (re-exported)"); } else { pr(0, "Import module " + d.path); }
        default:
            pr(0, "?decl")
    }
}

export void print_program(Program prog) {
    for i in 0..prog.decls.len { pr_decl(prog.decls[i]); }
    if (prog.main.len > 0) {
        pr(0, "Main")
        for i in 0..prog.main.len { pr_stmt(1, prog.main[i]); }
    }
}
