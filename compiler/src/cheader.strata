// src/cheader.strata - the C header a Strata dll ships (<name>.h beside <name>.dll /
// .so / .dylib): its exported enums, structs and functions as C declarations, so C and
// C++ hosts (engines, tools) can call it. Part of the build system.
//
// Strata types as C: int -> int64_t, float -> float, string -> const char*, a struct by
// its name, T* -> T*, T[dynamic] -> Array, vec2/3/4 / mat4 / quat -> structs of floats,
// a function type -> a typedef of a C function pointer (strata_fn<N>).

import ast
import host   // strata_join

string join_with(string[dynamic] pieces, string sep) {
    string[dynamic] out = []
    for i in 0..pieces.len {
        if i > 0 { out.push(sep) }
        out.push(pieces[i])
    }
    return strata_join(&out)
}

// Map a Strata type NAME to its C spelling (struct/user names pass through unchanged).
string cname(string n) {
    if (n == "int")    { return "int64_t"; }
    if (n == "float")  { return "float"; }
    if (n == "bool")   { return "bool"; }
    if (n == "void")   { return "void"; }
    if (n == "string") { return "const char*"; }
    if (n == "char")   { return "char"; }
    // sized numerics
    if (n == "i8")  { return "int8_t"; }
    if (n == "i16") { return "int16_t"; }
    if (n == "i32") { return "int32_t"; }
    if (n == "i64") { return "int64_t"; }
    if (n == "u8")  { return "uint8_t"; }
    if (n == "u16") { return "uint16_t"; }
    if (n == "u32") { return "uint32_t"; }
    if (n == "u64" || n == "uint") { return "uint64_t"; }
    if (n == "f32") { return "float"; }
    if (n == "f64") { return "double"; }
    return n
}

string ty_to_c(TypeNode* t) {
    if (t == null) { return "void"; }
    switch (t.kind) {
        case TyNamed:      return cname(t.name)
        case TyPointer:    return ty_to_c(t.elem) + "*"
        case TyArray:      return ty_to_c(t.elem) + "*"// minimal: decay to pointer
        case TyFixedArray: return ty_to_c(t.elem) + "*"
        case TyDynArray:   return "Array"// the type-erased dynamic array
        case TyFunc:       return fn_typedef(t)
    }
    return "void"
}

// Function types: C's declarator syntax won't do as a type name, so each signature gets a
// typedef (strata_fn<N>), collected as types are written and put before the structs.
global string[dynamic] fn_keys
global string[dynamic] fn_defs

void fn_reset() {
    string[dynamic] k = []
    string[dynamic] d = []
    fn_keys = k
    fn_defs = d
}

string fn_typedef(TypeNode* t) {
    string ret = "void"
    if t.elem != null { ret = ty_to_c(t.elem) }
    string[dynamic] ps = []
    TypeNode* a = t.args
    while a != null { ps.push(ty_to_c(a)); a = a.next }
    string params = "void"
    if ps.len > 0 { params = join_with(ps, ", ") }
    string key = ret + "(" + params + ")"
    for i in 0..fn_keys.len { if fn_keys[i] == key { return "strata_fn" + int_to_str(i) } }
    string name = "strata_fn" + int_to_str(fn_keys.len)
    fn_keys.push(key)
    fn_defs.push("typedef " + ret + " (*" + name + ")(" + params + ");\n")
    return name
}

string fn_typedefs() {
    string[dynamic] all = []
    for i in 0..fn_defs.len { all.push(fn_defs[i]) }
    return strata_join(&all)
}

string func_sig(Decl* d) {
    string s = ty_to_c(d.ret) + " " + d.name + "("
    if (d.params.len == 0) { s = s + "void"; }
    else {
        string[dynamic] ps = []
        for i in 0..d.params.len { ps.push(ty_to_c(d.params[i].type) + " " + d.params[i].name) }
        s = s + join_with(ps, ", ")
    }
    return s + ")"
}

// ---- a dll's C header ------------------------------------------------------------

bool header_uses_math(TypeNode* t) {
    if t == null { return false }
    if t.kind != TyNamed { return header_uses_math(t.elem) }
    return t.name == "vec2" || t.name == "vec3" || t.name == "vec4" || t.name == "mat4" || t.name == "quat"
}
bool header_uses_array(TypeNode* t) {
    if t == null { return false }
    if t.kind == TyDynArray { return true }
    return header_uses_array(t.elem)
}

// The C header for a dll: the entry module's exported enums, structs and functions,
// which is everything a host (e.g. an engine) needs to call it. `guard` names the
// include guard; `source` goes in the comment.
export string generate_header(Program prog, string guard, string source) {
    fn_reset()
    string[dynamic] out = []
    out.push("/* Generated by stratac from " + source + ". Do not edit. */\n")
    out.push("#ifndef " + guard + "\n#define " + guard + "\n\n#include <stdint.h>\n#include <stdbool.h>\n")

    // types from the Strata runtime, only if an exported signature uses them
    bool math = false
    bool arrays = false
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported {
            if d.kind == DcFunc {
                math = math || header_uses_math(d.ret)
                arrays = arrays || header_uses_array(d.ret)
                for p in 0..d.params.len {
                    math = math || header_uses_math(d.params[p].type)
                    arrays = arrays || header_uses_array(d.params[p].type)
                }
            }
            if d.kind == DcStruct {
                for f in 0..d.fields.len {
                    math = math || header_uses_math(d.fields[f].type)
                    arrays = arrays || header_uses_array(d.fields[f].type)
                }
            }
        }
    }
    if math {
        out.push("#ifndef STRATA_MATH_TYPES\n#define STRATA_MATH_TYPES\n")
        out.push("typedef struct { float x, y; } vec2;\ntypedef struct { float x, y, z; } vec3;\ntypedef struct { float x, y, z, w; } vec4;\n")
        out.push("typedef struct { float m[16]; } mat4;\ntypedef struct { float x, y, z, w; } quat;\n#endif\n")
    }
    if arrays {
        out.push("#ifndef STRATA_ARRAY_TYPE\n#define STRATA_ARRAY_TYPE\n")
        out.push("typedef struct { void* data; long long len; long long cap; long long elem; } Array;   /* T[dynamic] */\n#endif\n")
    }
    out.push("\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n")

    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcEnum {
            string[dynamic] ms = []
            for m in 0..d.members.len { ms.push(" " + d.members[m]) }
            out.push("typedef enum {" + join_with(ms, ",") + " } " + d.name + ";\n")
        }
    }
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcStruct { out.push("typedef struct " + d.name + " " + d.name + ";\n") }
    }
    int fn_at = out.len
    out.push("")                                     // (the function types' typedefs)
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcStruct {
            out.push("struct " + d.name + " {\n")
            for f in 0..d.fields.len { out.push("    " + ty_to_c(d.fields[f].type) + " " + d.fields[f].name + ";\n") }
            out.push("};\n")
        }
    }
    out.push("\n")
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.module == 0 && d.is_exported && d.kind == DcFunc { out.push(func_sig(d) + ";\n") }
    }
    out.push("\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* " + guard + " */\n")
    out[fn_at] = fn_typedefs()
    return strata_join(&out)
}
