//
// src/checker.strata - the Strata type checker (a.k.a. sema), written in Strata (originally ported from D--; a MODULE,
// no main). CORE. Milestone 1, step 4.
//
// AST -> validated + inferred AST. Does name resolution (scopes), type checking, arity,
// assignability, `var` inference, and condition/return checks. Reports located errors,
// recovering so it can report many at once (ARCHITECTURE.md sec 3). Runs BEFORE codegen.
//
// Structure mirrors D--'s checker within D--'s constraints (no maps; append-only arrays):
//   - the scope stack is a linked list of Scope nodes (push = child, pop = parent);
//   - structs/funcs/enums are global append-only arrays, searched linearly.
// Strata specifics: StVar (not StLet), StForIn with `..` ranges, top-level `main`, and
// `var` inference writes the resolved type back onto the AST node for codegen to use.

import ast
import hashidx   // NameIdx: hash indexes for the name tables
import "strata_host.h"   // strata_report: where messages go (see strata_host.h)

// ---- checker types -----------------------------------------------------

enum TCat { TcInt, TcFloat, TcBool, TcChar, TcStr, TcVoid, TcStruct, TcArray, TcPointer, TcVec, TcMat, TcQuat, TcDynArray, TcUnknown }

struct Type {
    TCat  cat
    string   name// display name; struct name for TcStruct
    Type* elem// element (Array) / pointee (Pointer)
}

Type* ty(TCat c, string n)  { return alloc(Type{ c, n, null }); }
Type* ty_arr(Type* e)    { return alloc(Type{ TcArray, "array", e }); }
Type* ty_dynarr(Type* e) { return alloc(Type{ TcDynArray, "array", e }); }
Type* ty_ptr(Type* e)    { return alloc(Type{ TcPointer, "pointer", e }); }

bool t_is_numeric(Type* t) { return t.cat == TcInt || t.cat == TcFloat; }
bool t_is_integer(Type* t) { return t.cat == TcInt; }
bool t_is_unknown(Type* t) { return t.cat == TcUnknown; }
bool t_ordered(Type* t)    { return t_is_numeric(t) || t.cat == TcChar; }

string t_str(Type* t) {
    switch (t.cat) {
        case TcInt:     return t.name
        case TcFloat:   return t.name
        case TcStruct:  return t.name
        case TcBool:    return "bool"
        case TcChar:    return "char"
        case TcStr:     return "string"
        case TcVoid:    return "void"
        case TcVec:     return t.name
        case TcMat:     return t.name
        case TcQuat:    return t.name
        case TcArray:   if (t.elem != null) { return t_str(t.elem) + "[]"; } return "?[]"
        case TcDynArray: if (t.elem != null) { return t_str(t.elem) + "[dynamic]"; } return "?[dynamic]"
        case TcPointer: if (t.elem != null) { return t_str(t.elem) + "*"; } return "?*"
        default:        return "?"
    }
    return "?"
}

// Convert a checker Type back to an AST TypeNode, so `var` inference can annotate the
// AST for codegen (canonical names so codegen's ty_to_c maps them).
TypeNode* named_node(string n) { TypeNode* t = new_type(TyNamed, 0, 0); t.name = n; return t; }
TypeNode* type_to_node(Type* t) {
    if (t == null) { return null; }
    switch (t.cat) {
        case TcInt:     return named_node(t.name)// "int", a sized int, or an enum name
        case TcFloat:   return named_node(t.name)
        case TcBool:    return named_node("bool")
        case TcChar:    return named_node("char")
        case TcStr:     return named_node("string")
        case TcVec:     return named_node(t.name)
        case TcMat:     return named_node(t.name)
        case TcQuat:    return named_node(t.name)
        case TcStruct:  return named_node(t.name)
        case TcPointer:  { TypeNode* n = new_type(TyPointer, 0, 0);  n.elem = type_to_node(t.elem); return n; }
        case TcArray:    { TypeNode* n = new_type(TyArray, 0, 0);    n.elem = type_to_node(t.elem); return n; }
        case TcDynArray: { TypeNode* n = new_type(TyDynArray, 0, 0); n.elem = type_to_node(t.elem); return n; }
        default:        return null// unknown -> leave codegen's __auto_type fallback
    }
    return null
}

// ---- symbol tables -----------------------------------------------------

struct VarInfo   { string name; Type* type; bool is_const; }
struct Scope     { VarInfo[dynamic] vars; Scope* parent; }
struct FieldInfo { string name; Type* type; }
// Top-level declarations. Each records its module, whether it is exported, and its
// C name: the source name, unless a private name is declared in more than one module,
// in which case the private ones become `<module>__<name>` so they can't collide in C.
struct StructInfo{ string name; FieldInfo[dynamic] fields; int module; bool exported; string cname; }
struct FuncInfo  { string name; Type*[dynamic] params; Type* ret; int module; bool exported; string cname; }
struct EnumInfo  { string name; int module; bool exported; string cname; }
struct EnumMember{ string member; string enum_name; int module; bool exported; string cname; }   // enum_name: the enum's C name
struct GlobalInfo{ string name; Type* type; int module; bool exported; string cname; }
// One entry per top-level name (all kinds), for the module-level name checks.
struct NameEntry { string name; int module; bool exported; int line; int col; }


export struct Checker {
    string          file
    bool         had_error
    bool         has_foreign// did the program `import` a C header? (enables external calls)
    StructInfo[dynamic] structs
    FuncInfo[dynamic]   funcs
    EnumInfo[dynamic]   enums
    EnumMember[dynamic] enum_members
    GlobalInfo[dynamic] globals
    NameIdx      global_idx
    Scope*       scope
    Type*        cur_ret
    Module[dynamic]    mods// the program's modules (see modules.strata)
    int          cur// module whose code is being checked
    NameEntry[dynamic] names
    // hash indexes over the tables above (chains are newest-first, so a lookup that
    // wants the earliest match keeps the last one it sees)
    NameIdx      struct_idx
    NameIdx      cname_idx// structs by C name
    NameIdx      func_idx
    NameIdx      enum_idx
    NameIdx      member_idx
    NameIdx      name_idx
    // shared result-type nodes for named types (see ck_node)
    TypeNode*[dynamic] nodes
    NameIdx      node_idx
    int          loop_depth// loops around the statement being checked (break/continue)
    // shared Types for the primitives (Types are never modified, so one of each will do)
    Type*        t_int
    Type*        t_bool
    Type*        t_float
    Type*        t_str_
    Type*        t_void
    Type*        t_unknown
    Type*        t_char
}

struct LookupResult { bool found; Type* type; bool is_const; }
struct LvalueResult { bool ok; bool is_const; }

void ck_error(Checker* c, int line, int col, string msg) {
    c.had_error = true
    string file = c.file
    if c.cur >= 0 && c.cur < c.mods.len { file = c.mods[c.cur].file }
    strata_report(file + ":" + int_to_str(line) + ":" + int_to_str(col) + ": error: " + msg)
}

// ---- modules + visibility ------------------------------------------------

// Can the module being checked see a declaration from module `owner`?
// Its own, always; another module's, only if exported and that module is visible.
bool ck_sees(Checker* c, int owner, bool exported) {
    if owner == c.cur { return true }
    if !exported { return false }
    Module m = c.mods[c.cur]
    for i in 0..m.visible.len { if m.visible[i] == owner { return true } }
    return false
}

// Module m can see v's exports, and (through `export import`) whatever v re-exports.
void ck_add_visible(Checker* c, int m, int v) {
    if v == m { return }
    for i in 0..c.mods[m].visible.len { if c.mods[m].visible[i] == v { return } }
    c.mods[m].visible.push(v)
    for i in 0..c.mods[v].reexports.len { ck_add_visible(c, m, c.mods[v].reexports[i]) }
}

void ck_visibility(Checker* c) {
    for m in 0..c.mods.len {
        for i in 0..c.mods[m].imports.len { ck_add_visible(c, m, c.mods[m].imports[i]) }
    }
}

// If `name` is a top-level declaration the current module can't see, explain why;
// "" if no module declares it (so the caller reports its usual "unknown ..." error).
string ck_hidden(Checker* c, string name) {
    // several modules may declare it; explain the most likely intended one:
    // private in a module this file imports > exported by one it doesn't > anything else
    int owner = 0 - 1
    bool exported = false
    int best = 0
    int k = idx_first(&c.name_idx, name)
    while k >= 0 {
        NameEntry n = c.names[k]
        if n.name == name && n.module != c.cur {
            int score = 1
            if !n.exported && ck_sees(c, n.module, true) { score = 3 }
            else if n.exported { score = 2 }
            if score >= best { best = score; owner = n.module; exported = n.exported }   // >=: prefer the earliest
        }
        k = idx_next(&c.name_idx, k)
    }
    if owner < 0 { return "" }
    string f = c.mods[owner].file
    if !exported { return "'" + name + "' is private to " + f + " (mark it 'export' to use it from another file)" }
    return "'" + name + "' is declared in " + f + ", which this file doesn't import (add 'import " + c.mods[owner].name + "')"
}

// ---- table helpers -----------------------------------------------------
// Lookups by SOURCE name respect visibility; lookups by C name (from a resolved Type)
// don't need to.

int ck_struct_index(Checker* c, string name) {
    int found = 0 - 1
    int k = idx_first(&c.struct_idx, name)
    while k >= 0 {
        if c.structs[k].name == name && ck_sees(c, c.structs[k].module, c.structs[k].exported) { found = k }
        k = idx_next(&c.struct_idx, k)
    }
    return found
}
int ck_struct_by_cname(Checker* c, string cname) {
    int found = 0 - 1
    int k = idx_first(&c.cname_idx, cname)
    while k >= 0 {
        if c.structs[k].cname == cname { found = k }
        k = idx_next(&c.cname_idx, k)
    }
    return found
}
int ck_func_index(Checker* c, string name) {
    int found = 0 - 1
    int k = idx_first(&c.func_idx, name)
    while k >= 0 {
        if c.funcs[k].name == name && ck_sees(c, c.funcs[k].module, c.funcs[k].exported) { found = k }
        k = idx_next(&c.func_idx, k)
    }
    return found
}
int ck_enum_index(Checker* c, string name) {
    int found = 0 - 1
    int k = idx_first(&c.enum_idx, name)
    while k >= 0 {
        if c.enums[k].name == name && ck_sees(c, c.enums[k].module, c.enums[k].exported) { found = k }
        k = idx_next(&c.enum_idx, k)
    }
    return found
}
int ck_global_index(Checker* c, string name) {
    int found = 0 - 1
    int k = idx_first(&c.global_idx, name)
    while k >= 0 {
        GlobalInfo g = c.globals[k]
        if g.name == name && ck_sees(c, g.module, g.exported) { found = k }
        k = idx_next(&c.global_idx, k)
    }
    return found
}
int ck_own_global(Checker* c, string name, int module) {
    int found = 0 - 1
    int k = idx_first(&c.global_idx, name)
    while k >= 0 {
        if c.globals[k].name == name && c.globals[k].module == module { found = k }
        k = idx_next(&c.global_idx, k)
    }
    return found
}
int ck_member_index(Checker* c, string name) {
    int found = 0 - 1
    int k = idx_first(&c.member_idx, name)
    while k >= 0 {
        EnumMember m = c.enum_members[k]
        if m.member == name && ck_sees(c, m.module, m.exported) { found = k }
        k = idx_next(&c.member_idx, k)
    }
    return found
}

// ---- types -------------------------------------------------------------

Type* ck_prim(string n) {
    if (n == "int" || n == "i64" || n == "i32" || n == "i16" || n == "i8"
        || n == "uint" || n == "u64" || n == "u32" || n == "u16" || n == "u8") { return ty(TcInt, n); }
    if (n == "float" || n == "f64" || n == "f32") { return ty(TcFloat, n); }
    if (n == "bool")   { return ty(TcBool, n); }
    if (n == "char")   { return ty(TcChar, n); }
    if (n == "string") { return ty(TcStr, n); }
    if (n == "void")   { return ty(TcVoid, n); }
    if (n == "vec2" || n == "vec3" || n == "vec4") { return ty(TcVec, n); }
    if (n == "mat4") { return ty(TcMat, n); }
    if (n == "quat") { return ty(TcQuat, n); }
    return null
}

// How many components does a vector type have?
int vec_dim(string vname) {
    if (vname == "vec2") { return 2; }
    if (vname == "vec3") { return 3; }
    if (vname == "vec4") { return 4; }
    return 0
}
// Is char c a valid component (x/y/z/w) within a vector of `dim` components?
bool vec_comp_ok(char c, int dim) {
    if (c == 'x' || c == 'y') { return true; }
    if (c == 'z') { return dim >= 3; }
    if (c == 'w') { return dim >= 4; }
    return false
}
// A swizzle `field` on a vector `vname` selects 1-4 components. Returns how many it
// selects (1 => a float, 2..4 => a vecN), or 0 if invalid.
int vec_swizzle_size(string vname, string field) {
    int dim = vec_dim(vname)
    if (dim == 0) { return 0; }
    if (field.len < 1 || field.len > 4) { return 0; }
    for i in 0..field.len { if (!vec_comp_ok(field[i], dim)) { return 0; } }
    return field.len
}

Type* ck_type(Checker* c, TypeNode* t) {
    if (t == null) { return c.t_void; }
    if (t.kind == TyDynArray) { return ty_dynarr(ck_type(c, t.elem)); }
    if (t.kind == TyArray || t.kind == TyFixedArray) { return ty_arr(ck_type(c, t.elem)); }
    if (t.kind == TyPointer) { return ty_ptr(ck_type(c, t.elem)); }
    Type* p = ck_prim(t.name)
    if (p != null) { return p; }
    // a user type: resolve it, and give the node its C name for codegen
    int si = ck_struct_index(c, t.name)
    if si >= 0 { t.name = c.structs[si].cname; return ty(TcStruct, t.name) }
    int ei = ck_enum_index(c, t.name)
    if ei >= 0 { t.name = c.enums[ei].cname; return ty(TcInt, t.name) }
    string why = ck_hidden(c, t.name)
    if why != "" { ck_error(c, t.line, t.col, why) }
    else { ck_error(c, t.line, t.col, "unknown type '" + t.name + "'") }
    return c.t_unknown
}

// A global's initializer: a literal (a negative number too) or null.
bool ck_is_constant(Expr* e) {
    if e.kind == ExIntLit || e.kind == ExFloatLit || e.kind == ExBoolLit || e.kind == ExCharLit || e.kind == ExStringLit { return true }
    if e.kind == ExName && e.text == "null" { return true }
    if e.kind == ExUnary && e.text == "-" && (e.a.kind == ExIntLit || e.a.kind == ExFloatLit) { return true }
    return false
}

bool ck_assignable(Type* target, Type* value) {
    if (target.cat == TcUnknown || value.cat == TcUnknown) { return true; }
    switch (target.cat) {
        case TcInt:    return value.cat == TcInt
        case TcFloat:  return value.cat == TcFloat || value.cat == TcInt
        case TcBool:   return value.cat == TcBool
        case TcChar:   return value.cat == TcChar
        case TcStr:    return value.cat == TcStr
        case TcVec:    return value.cat == TcVec && value.name == target.name
        case TcMat:    return value.cat == TcMat
        case TcQuat:   return value.cat == TcQuat
        case TcStruct: return value.cat == TcStruct && value.name == target.name
        case TcArray:
            if (value.cat != TcArray) { return false; }
            if (value.elem != null && value.elem.cat == TcUnknown) { return true; }
            return target.elem != null && value.elem != null && ck_assignable(target.elem, value.elem)
        case TcDynArray:
            if (value.cat != TcDynArray) { return false; }
            if (value.elem != null && value.elem.cat == TcUnknown) { return true; }
            return target.elem != null && value.elem != null && ck_assignable(target.elem, value.elem)
        case TcPointer:
            if (value.cat != TcPointer) { return false; }
            if (value.elem != null && value.elem.cat == TcUnknown) { return true; }
            return target.elem != null && value.elem != null && ck_assignable(target.elem, value.elem)
        default: return false
    }
    return false
}

// Can a value of type `from` be converted with cast<to>(...)? Same types always; any
// scalar to any scalar; pointer to pointer; pointer <-> integer.
bool t_is_scalar(Type* t) { return t.cat == TcInt || t.cat == TcFloat || t.cat == TcChar || t.cat == TcBool; }
bool ck_castable(Type* from, Type* to) {
    if (t_is_unknown(from) || t_is_unknown(to)) { return true; }
    if (ck_assignable(to, from)) { return true; }
    if (t_is_scalar(from) && t_is_scalar(to)) { return true; }
    if (from.cat == TcPointer && (to.cat == TcPointer || to.cat == TcInt)) { return true; }
    if (to.cat == TcPointer && from.cat == TcInt) { return true; }
    // a string is a C `const char*`: it converts to / from a pointer (e.g. a byte buffer)
    if (from.cat == TcStr && to.cat == TcPointer) || (from.cat == TcPointer && to.cat == TcStr) { return true }
    return false
}

// ---- scopes ------------------------------------------------------------

void ck_push(Checker* c) { VarInfo[dynamic] v = []; c.scope = alloc(Scope{ v, c.scope }); }
void ck_pop(Checker* c)  { c.scope = c.scope.parent; }

bool ck_declare(Checker* c, string name, Type* t, bool is_const, int line, int col) {
    for i in 0..c.scope.vars.len {
        if (c.scope.vars[i].name == name) {
            ck_error(c, line, col, "'" + name + "' is already declared in this scope")
            return false
        }
    }
    c.scope.vars.push(VarInfo{ name, t, is_const })
    return true
}

LookupResult ck_lookup(Checker* c, string name) {
    Scope* s = c.scope
    while (s != null) {
        for i in 0..s.vars.len {
            if (s.vars[i].name == name) { return LookupResult{ true, s.vars[i].type, s.vars[i].is_const }; }
        }
        s = s.parent
    }
    return LookupResult{ false, null, false }
}

// ---- lvalues -----------------------------------------------------------

LvalueResult ck_lvalue(Checker* c, Expr* e) {
    switch (e.kind) {
        case ExName:
            {
                LookupResult v = ck_lookup(c, e.text)
                bool cst = false
                if (v.found) { cst = v.is_const; }
                return LvalueResult{ true, cst }
            }
        case ExField: return ck_lvalue(c, e.a)
        case ExIndex: return ck_lvalue(c, e.a)
        case ExUnary: if (e.text == "*") { return LvalueResult{ true, false }; } return LvalueResult{ false, false }
        default:      return LvalueResult{ false, false }
    }
    return LvalueResult{ false, false }
}

// ---- expressions -------------------------------------------------------

// Wrapper: check an expression, then annotate the AST node with its resolved type so
// codegen can consult it (e.g. `.` vs `->`). All sub-expressions go through here too.
// The node recorded as an expression's result type. Codegen only reads these, so every
// expression of a NAMED type (int, vec3, Entity, ...) shares one node per name instead of
// allocating its own; pointer/array types are built fresh as before.
TypeNode* ck_node(Checker* c, Type* t) {
    if t == null { return null }
    string n = t.name
    if t.cat == TcBool { n = "bool" }
    else if t.cat == TcChar { n = "char" }
    else if t.cat == TcStr { n = "string" }
    else if !(t.cat == TcInt || t.cat == TcFloat || t.cat == TcVec || t.cat == TcMat || t.cat == TcQuat || t.cat == TcStruct) {
        return type_to_node(t)
    }
    int k = idx_first(&c.node_idx, n)
    while k >= 0 {
        if c.nodes[k].name == n { return c.nodes[k] }
        k = idx_next(&c.node_idx, k)
    }
    TypeNode* node = named_node(n)
    idx_add(&c.node_idx, n, c.nodes.len)
    c.nodes.push(node)
    return node
}

Type* ck_expr(Checker* c, Expr* e) {
    Type* t = ck_expr_i(c, e)
    e.rtype = ck_node(c, t)
    return t
}

// Check `e` where a value of type `target` is expected. An array literal takes its
// element type from the target (so `Token[dynamic] ts = []` and `u8[dynamic] b = [1, 2]`
// allocate Token- / u8-sized elements, not the literal's guess).
Type* ck_expr_as(Checker* c, Expr* e, Type* target) {
    Type* t = ck_expr(c, e)
    if (e.kind == ExArrayLit && target.cat == TcDynArray && t.cat == TcDynArray && ck_assignable(target, t)) {
        e.rtype = ck_node(c, target)
        return target
    }
    return t
}

// The type of binary expression `e`, given its operand types.
Type* ck_binary(Checker* c, Expr* e, Type* lt, Type* rt) {
    string op = e.text
    if (lt.cat == TcMat || rt.cat == TcMat || lt.cat == TcQuat || rt.cat == TcQuat) {
        if (op == "*") {
            if (lt.cat == TcMat && rt.cat == TcMat) { return lt; }                               // mat4 * mat4
            if (lt.cat == TcMat && rt.cat == TcVec && rt.name == "vec4") { return rt; }           // mat4 * vec4 -> vec4
            if (lt.cat == TcQuat && rt.cat == TcQuat) { return lt; }                              // quat * quat
            ck_error(c, e.line, e.col, "'*' is not defined between " + t_str(lt) + " and " + t_str(rt))
            return c.t_unknown
        }
        ck_error(c, e.line, e.col, "only '*' is defined for matrices/quaternions")
        return c.t_unknown
    }
    if (lt.cat == TcVec || rt.cat == TcVec) {
        if (op == "+" || op == "-") {
            if (lt.cat == TcVec && rt.cat == TcVec && lt.name == rt.name) { return lt; }
            ck_error(c, e.line, e.col, "'" + op + "' requires two vectors of the same size, got " + t_str(lt) + " and " + t_str(rt))
            return c.t_unknown
        }
        if (op == "*") {
            if (lt.cat == TcVec && rt.cat == TcVec && lt.name == rt.name) { return lt; }
            if (lt.cat == TcVec && t_is_numeric(rt)) { return lt; }
            if (rt.cat == TcVec && t_is_numeric(lt)) { return rt; }
            ck_error(c, e.line, e.col, "'*' on a vector needs a matching vector or a scalar, got " + t_str(lt) + " and " + t_str(rt))
            return c.t_unknown
        }
        ck_error(c, e.line, e.col, "'" + op + "' is not defined for vectors")
        return c.t_unknown
    }
    if (op == "&&" || op == "||") {
        if ((lt.cat != TcBool && !t_is_unknown(lt)) || (rt.cat != TcBool && !t_is_unknown(rt))) {
            ck_error(c, e.line, e.col, "'" + op + "' requires bool operands")
        }
        return c.t_bool
    }
    if (op == "==" || op == "!=") {
        if (!t_is_unknown(lt) && !t_is_unknown(rt) && lt.cat != rt.cat && !(t_ordered(lt) && t_ordered(rt))) {
            ck_error(c, e.line, e.col, "cannot compare " + t_str(lt) + " and " + t_str(rt))
        }
        return c.t_bool
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        if ((!t_ordered(lt) && !t_is_unknown(lt)) || (!t_ordered(rt) && !t_is_unknown(rt))) {
            ck_error(c, e.line, e.col, "'" + op + "' requires numeric operands")
        }
        return c.t_bool
    }
    if (op == "+" && (lt.cat == TcStr || rt.cat == TcStr)) {
        if (!t_is_unknown(lt) && !t_is_unknown(rt) && !(lt.cat == TcStr && rt.cat == TcStr)) {
            ck_error(c, e.line, e.col, "cannot concatenate " + t_str(lt) + " and " + t_str(rt))
        }
        return c.t_str_
    }
    if (op == "|" || op == "&" || op == "^" || op == "<<" || op == ">>") {
        if ((!t_is_integer(lt) && lt.cat != TcChar && !t_is_unknown(lt))
            || (!t_is_integer(rt) && rt.cat != TcChar && !t_is_unknown(rt))) {
            ck_error(c, e.line, e.col, "'" + op + "' requires integer operands, got " + t_str(lt) + " and " + t_str(rt))
        }
        return c.t_int
    }
    if ((!t_ordered(lt) && !t_is_unknown(lt)) || (!t_ordered(rt) && !t_is_unknown(rt))) {
        ck_error(c, e.line, e.col, "'" + op + "' requires numeric operands, got " + t_str(lt) + " and " + t_str(rt))
        return c.t_unknown
    }
    if (op == "%" && (lt.cat == TcFloat || rt.cat == TcFloat)) { ck_error(c, e.line, e.col, "'%' requires integer operands"); }
    if (lt.cat == TcFloat || rt.cat == TcFloat) { return c.t_float; }
    return c.t_int
}

Type* ck_expr_i(Checker* c, Expr* e) {
    switch (e.kind) {
        case ExIntLit:    return c.t_int
        case ExFloatLit:  return c.t_float
        case ExBoolLit:   return c.t_bool
        case ExStringLit: return c.t_str_
        case ExCharLit:   return c.t_char

        case ExName:
            {
                LookupResult v = ck_lookup(c, e.text)
                if (v.found) { return v.type; }
                int gi = ck_global_index(c, e.text)
                if gi >= 0 {
                    e.text = c.globals[gi].cname
                    return c.globals[gi].type
                }
                int mi = ck_member_index(c, e.text)
                if mi >= 0 {
                    e.text = c.enum_members[mi].cname
                    return ty(TcInt, c.enum_members[mi].enum_name)
                }
                if (e.text == "PI") { return c.t_float; }        // prelude constant
                if (e.text == "null") { return ty_ptr(c.t_unknown); }  // null pointer
                string why = ck_hidden(c, e.text)
                if why != "" { ck_error(c, e.line, e.col, why); return c.t_unknown }
                // unknown name: an external C symbol (e.g. a raylib constant) if a header
                // was imported; otherwise a real error.
                if (!c.has_foreign) { ck_error(c, e.line, e.col, "use of undeclared name '" + e.text + "'"); }
                return c.t_unknown
            }

        case ExUnary:
            {
                if (e.text == "&") {
                    LvalueResult lv = ck_lvalue(c, e.a)
                    if (!lv.ok) { ck_error(c, e.line, e.col, "cannot take the address of a non-lvalue"); }
                    return ty_ptr(ck_expr(c, e.a))
                }
                Type* t = ck_expr(c, e.a)
                if (e.text == "*") {
                    if (t.cat == TcPointer) { if (t.elem != null) { return t.elem; } return c.t_unknown; }
                    if (!t_is_unknown(t)) { ck_error(c, e.line, e.col, "cannot dereference a value of type " + t_str(t)); }
                    return c.t_unknown
                }
                if (e.text == "!") {
                    if (t.cat != TcBool && !t_is_unknown(t)) { ck_error(c, e.line, e.col, "'!' requires bool, got " + t_str(t)); }
                    return c.t_bool
                }
                if (e.text == "~") {
                    if (!t_is_integer(t) && t.cat != TcChar && !t_is_unknown(t)) { ck_error(c, e.line, e.col, "'~' requires an integer operand, got " + t_str(t)); }
                    return t
                }
                if (!t_is_numeric(t) && !t_is_unknown(t)) { ck_error(c, e.line, e.col, "'-' requires a numeric operand, got " + t_str(t)); }
                return t
            }

        case ExBinary:
            {
                if (e.text == "..") {
                    ck_error(c, e.line, e.col, "range '..' is only valid as a for-in loop range")
                    ck_expr(c, e.a); ck_expr(c, e.b)
                    return c.t_unknown
                }
                // A chain like a + b + c + ... nests down its LEFT side, so walk that side in
                // a loop: recursing would overflow the stack on a long chain.
                Expr*[dynamic] spine = []
                Expr* x = e
                while x.kind == ExBinary && x.text != ".." {
                    spine.push(x)
                    x = x.a
                }
                Type* lt = ck_expr(c, x)
                int k = spine.len - 1
                while k >= 0 {
                    Expr* node = spine[k]
                    Type* rt = ck_expr(c, node.b)
                    Type* t = ck_binary(c, node, lt, rt)
                    if k > 0 { node.rtype = ck_node(c, t) }   // (ck_expr records the outermost's)
                    lt = t
                    k -= 1
                }
                return lt
            }

        case ExCall: return ck_call(c, e)

        case ExField:
            {
                Type* ot = ck_expr(c, e.a)
                if (t_is_unknown(ot)) { return c.t_unknown; }
                // `.` auto-derefs a pointer to a vector or quaternion too
                if ot.cat == TcPointer && ot.elem != null && (ot.elem.cat == TcVec || ot.elem.cat == TcQuat) {
                    ot = ot.elem
                    if ot.cat == TcVec && e.field.len > 1 { ck_error(c, e.line, e.col, "a swizzle needs the vector itself, not a pointer to it (use (*p)." + e.field + ")") }
                }
                // a quaternion's components
                if ot.cat == TcQuat {
                    if e.field == "x" || e.field == "y" || e.field == "z" || e.field == "w" { return c.t_float }
                    ck_error(c, e.line, e.col, "quat has components x, y, z and w (no '" + e.field + "')")
                    return c.t_unknown
                }
                if (ot.cat == TcVec) {
                    int sw = vec_swizzle_size(ot.name, e.field)
                    if (sw == 1) { return c.t_float; }
                    if (sw == 2) { return ty(TcVec, "vec2"); }
                    if (sw == 3) { return ty(TcVec, "vec3"); }
                    if (sw == 4) { return ty(TcVec, "vec4"); }
                    ck_error(c, e.line, e.col, "vector " + ot.name + " has no component/swizzle '" + e.field + "'")
                    return c.t_unknown
                }
                if (ot.cat == TcStr || ot.cat == TcArray || ot.cat == TcDynArray) {
                    if (e.field == "len") { return c.t_int; }
                    ck_error(c, e.line, e.col, t_str(ot) + " has no field '" + e.field + "' (did you mean 'len'?)")
                    return c.t_unknown
                }
                string sname = ""
                if (ot.cat == TcStruct) { sname = ot.name; }
                else if (ot.cat == TcPointer && ot.elem != null && ot.elem.cat == TcStruct) { sname = ot.elem.name; }
                else { ck_error(c, e.line, e.col, "type " + t_str(ot) + " has no fields"); return c.t_unknown; }
                int si = ck_struct_by_cname(c, sname)
                if (si >= 0) {
                    for i in 0..c.structs[si].fields.len {
                        if (c.structs[si].fields[i].name == e.field) { return c.structs[si].fields[i].type; }
                    }
                }
                ck_error(c, e.line, e.col, "struct " + sname + " has no field '" + e.field + "'")
                return c.t_unknown
            }

        case ExIndex:
            {
                Type* ot = ck_expr(c, e.a)
                Type* it = ck_expr(c, e.b)
                if (!t_is_integer(it) && !t_is_unknown(it)) { ck_error(c, e.line, e.col, "index must be an integer, got " + t_str(it)); }
                if (ot.cat == TcStr) { return c.t_char; }
                if (ot.cat == TcArray)    { if (ot.elem != null) { return ot.elem; } return c.t_unknown; }
                if (ot.cat == TcDynArray) { if (ot.elem != null) { return ot.elem; } return c.t_unknown; }
                if (ot.cat == TcPointer) { if (ot.elem != null) { return ot.elem; } return c.t_unknown; }
                if (!t_is_unknown(ot)) { ck_error(c, e.line, e.col, "cannot index a value of type " + t_str(ot)); }
                return c.t_unknown
            }

        case ExArrayLit:
            {
                if (e.items.len == 0) { return ty_dynarr(c.t_unknown); }
                Type* first = ck_expr(c, e.items[0])
                for i in 1..e.items.len {
                    Type* et = ck_expr(c, e.items[i])
                    if (!ck_assignable(first, et) && !ck_assignable(et, first)) {
                        ck_error(c, e.items[i].line, e.items[i].col, "array element " + int_to_str(i + 1) + " has type " + t_str(et) + ", expected " + t_str(first))
                    }
                }
                return ty_dynarr(first)
            }

        case ExStructLit:
            {
                int si = ck_struct_index(c, e.type_name)
                if (si < 0) {
                    string why = ck_hidden(c, e.type_name)
                    if why != "" { ck_error(c, e.line, e.col, why) }
                    else { ck_error(c, e.line, e.col, "unknown struct '" + e.type_name + "'") }
                    for i in 0..e.items.len { ck_expr(c, e.items[i]); }
                    return c.t_unknown
                }
                int nf = c.structs[si].fields.len
                if (e.items.len != nf) { ck_error(c, e.line, e.col, "struct " + e.type_name + " has " + int_to_str(nf) + " field(s), but " + int_to_str(e.items.len) + " given"); }
                int k = e.items.len
                if (nf < k) { k = nf; }
                for i in 0..k {
                    Type* at = ck_expr(c, e.items[i])
                    if (!ck_assignable(c.structs[si].fields[i].type, at)) {
                        ck_error(c, e.items[i].line, e.items[i].col, "field '" + c.structs[si].fields[i].name + "' of " + e.type_name + " expects " + t_str(c.structs[si].fields[i].type) + ", got " + t_str(at))
                    }
                }
                for i in k..e.items.len { ck_expr(c, e.items[i]); }
                e.type_name = c.structs[si].cname   // codegen emits the C name
                return ty(TcStruct, e.type_name)
            }

        case ExCast:
            {
                // cast<T>(x): an explicit conversion between scalars (int/float/char/bool/
                // enum) or involving a pointer (ptr<->ptr, ptr<->int). The escape hatch.
                Type* from = ck_expr(c, e.a)
                Type* to   = ck_type(c, e.type)
                if (!ck_castable(from, to)) {
                    ck_error(c, e.line, e.col, "cannot cast " + t_str(from) + " to " + t_str(to))
                }
                return to
            }

        case ExSizeof:
            {
                ck_type(c, e.type)// validates the type; error if unknown
                return c.t_int
            }

        default:
            return c.t_unknown
    }
    return c.t_unknown
}

Type* ck_call(Checker* c, Expr* e) {
    Expr* callee = e.a

    if (callee.kind == ExField) {
        // arena allocation: `<arena>.new(T)` -> T* , allocated in the arena.
        if (callee.field == "new") {
            Type* recv = ck_expr(c, callee.a)
            if (recv.cat != TcStruct || recv.name != "Arena") {
                if (!t_is_unknown(recv)) { ck_error(c, e.line, e.col, ".new is only valid on an arena, got " + t_str(recv)); }
            }
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "new(T) takes exactly one type argument"); return c.t_unknown; }
            Expr* arg = e.items[0]
            if (arg.kind != ExName) { ck_error(c, arg.line, arg.col, "new() expects a type name"); return c.t_unknown; }
            Type* elem = ck_prim(arg.text)
            if (elem == null) {
                int si = ck_struct_index(c, arg.text)
                if si >= 0 { arg.text = c.structs[si].cname; elem = ty(TcStruct, arg.text) }
                else {
                    string why = ck_hidden(c, arg.text)
                    if why != "" { ck_error(c, arg.line, arg.col, why) }
                    else { ck_error(c, arg.line, arg.col, "unknown type '" + arg.text + "'") }
                    elem = c.t_unknown
                }
            }
            arg.rtype = type_to_node(elem)// codegen reads this for sizeof(T)
            return ty_ptr(elem)
        }
        // dynamic array append: `xs.push(v)`
        if (callee.field == "push") {
            Type* recv = ck_expr(c, callee.a)
            if (recv.cat == TcDynArray) {
                if (e.items.len != 1) { ck_error(c, e.line, e.col, "push takes exactly one argument"); }
                else {
                    Type* at = ck_expr(c, e.items[0])
                    if (recv.elem != null && !ck_assignable(recv.elem, at)) { ck_error(c, e.items[0].line, e.items[0].col, "push expects " + t_str(recv.elem) + ", got " + t_str(at)); }
                }
            } else {
                if (!t_is_unknown(recv)) { ck_error(c, e.line, e.col, "push is only valid on a dynamic array, got " + t_str(recv)); }
                for i in 0..e.items.len { ck_expr(c, e.items[i]); }
            }
            return c.t_void
        }
        // other method-style calls: not resolved yet (UFCS/methods are backlog).
        ck_expr(c, callee.a)
        for i in 0..e.items.len { ck_expr(c, e.items[i]); }
        return c.t_unknown
    }

    if (callee.kind == ExName) {
        string name = callee.text

        // arena() -> a fresh arena (the region memory root)
        if (name == "arena") {
            if (e.items.len != 0) { ck_error(c, e.line, e.col, "arena() takes no arguments"); }
            return ty(TcStruct, "Arena")
        }

        // temporary built-in until the real prelude lands
        if (name == "print") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "print() takes exactly one argument"); }
            for i in 0..e.items.len { ck_expr(c, e.items[i]); }
            return c.t_void
        }

        // prelude math builtins (always in scope)
        if (name == "min" || name == "max") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, name + "(a, b) takes 2 arguments"); }
            for i in 0..e.items.len { Type* a = ck_expr(c, e.items[i]); if (!t_is_numeric(a) && !t_is_unknown(a)) { ck_error(c, e.items[i].line, e.items[i].col, name + " expects numbers, got " + t_str(a)); } }
            return c.t_float
        }
        if (name == "clamp" || name == "lerp") {
            if (e.items.len != 3) { ck_error(c, e.line, e.col, name + "() takes 3 arguments"); }
            for i in 0..e.items.len { Type* a = ck_expr(c, e.items[i]); if (!t_is_numeric(a) && !t_is_unknown(a)) { ck_error(c, e.items[i].line, e.items[i].col, name + " expects numbers, got " + t_str(a)); } }
            return c.t_float
        }

        // string + file built-ins (the same set D-- provides)
        if (name == "substr") {
            if (e.items.len != 3) { ck_error(c, e.line, e.col, "substr(s, start, len) takes 3 arguments"); }
            else {
                Type* s = ck_expr(c, e.items[0])
                Type* a = ck_expr(c, e.items[1])
                Type* n = ck_expr(c, e.items[2])
                if (s.cat != TcStr && !t_is_unknown(s)) { ck_error(c, e.items[0].line, e.items[0].col, "substr expects a string, got " + t_str(s)); }
                if (!t_is_integer(a) && !t_is_unknown(a)) { ck_error(c, e.items[1].line, e.items[1].col, "substr start must be an integer, got " + t_str(a)); }
                if (!t_is_integer(n) && !t_is_unknown(n)) { ck_error(c, e.items[2].line, e.items[2].col, "substr length must be an integer, got " + t_str(n)); }
            }
            return c.t_str_
        }
        if (name == "int_to_str") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "int_to_str(n) takes 1 argument"); }
            else {
                Type* n = ck_expr(c, e.items[0])
                if (!t_is_integer(n) && !t_is_unknown(n)) { ck_error(c, e.items[0].line, e.items[0].col, "int_to_str expects an integer, got " + t_str(n)); }
            }
            return c.t_str_
        }
        if (name == "read_file" || name == "cstr") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, name + "() takes 1 argument"); }
            else {
                Type* p = ck_expr(c, e.items[0])
                if (p.cat != TcStr && !t_is_unknown(p)) { ck_error(c, e.items[0].line, e.items[0].col, name + " expects a string, got " + t_str(p)); }
            }
            return c.t_str_
        }
        if (name == "args") {
            if (e.items.len != 0) { ck_error(c, e.line, e.col, "args() takes no arguments"); }
            return ty_dynarr(c.t_str_)
        }
        if (name == "write_file") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, "write_file(path, data) takes 2 arguments"); }
            else {
                for i in 0..2 {
                    Type* a = ck_expr(c, e.items[i])
                    if (a.cat != TcStr && !t_is_unknown(a)) { ck_error(c, e.items[i].line, e.items[i].col, "write_file expects strings, got " + t_str(a)); }
                }
            }
            return c.t_bool
        }

        // alloc(value) -> boxes any value in the global heap, returns a pointer to it
        if (name == "alloc") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "alloc(value) takes exactly one argument"); return c.t_unknown; }
            Type* vt = ck_expr(c, e.items[0])
            return ty_ptr(vt)
        }

        // vector constructors: vecN(components...) or vecN(scalar) to splat
        if (name == "vec2" || name == "vec3" || name == "vec4") {
            int n = 2
            if (name == "vec3") { n = 3; }
            if (name == "vec4") { n = 4; }
            if (e.items.len != n && e.items.len != 1) {
                ck_error(c, e.line, e.col, name + "() takes " + int_to_str(n) + " components (or 1 to splat)")
            }
            for i in 0..e.items.len {
                Type* at = ck_expr(c, e.items[i])
                if (!t_is_numeric(at) && !t_is_unknown(at)) { ck_error(c, e.items[i].line, e.items[i].col, name + " components must be numeric, got " + t_str(at)); }
            }
            return ty(TcVec, name)
        }
        // vector math builtins
        if (name == "dot") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, "dot(a, b) takes 2 arguments"); }
            else {
                Type* a = ck_expr(c, e.items[0])
                Type* b = ck_expr(c, e.items[1])
                if ((a.cat != TcVec || b.cat != TcVec || a.name != b.name) && !t_is_unknown(a) && !t_is_unknown(b)) { ck_error(c, e.line, e.col, "dot expects two vectors of the same size"); }
            }
            return c.t_float
        }
        if (name == "length" || name == "normalize") {
            Type* r = c.t_float
            if (e.items.len != 1) { ck_error(c, e.line, e.col, name + "(v) takes 1 argument"); }
            else {
                Type* a = ck_expr(c, e.items[0])
                if (a.cat != TcVec && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, name + " expects a vector, got " + t_str(a)); }
                if (name == "normalize") { r = a; }
            }
            return r
        }
        if (name == "cross") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, "cross(a, b) takes 2 arguments"); }
            else {
                Type* a = ck_expr(c, e.items[0])
                Type* b = ck_expr(c, e.items[1])
                if ((a.name != "vec3" || b.name != "vec3") && !t_is_unknown(a) && !t_is_unknown(b)) { ck_error(c, e.line, e.col, "cross expects two vec3"); }
            }
            return ty(TcVec, "vec3")
        }

        // matrix / quaternion builtins - names match smath.h, so codegen just calls them.
        if (name == "mat4_identity" || name == "quat_identity") {
            if (e.items.len != 0) { ck_error(c, e.line, e.col, name + "() takes no arguments"); }
            if (name == "quat_identity") { return ty(TcQuat, "quat"); }
            return ty(TcMat, "mat4")
        }
        if (name == "mat4_translate" || name == "mat4_scale") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, name + "(v) takes 1 argument"); }
            else { Type* a = ck_expr(c, e.items[0]); if (a.name != "vec3" && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, name + " expects a vec3"); } }
            return ty(TcMat, "mat4")
        }
        if (name == "mat4_rotate" || name == "quat_axis_angle") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, name + "(axis, angle) takes 2 arguments"); }
            else {
                Type* a = ck_expr(c, e.items[0])
                Type* b = ck_expr(c, e.items[1])
                if (a.name != "vec3" && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, name + " axis must be a vec3"); }
                if (!t_is_numeric(b) && !t_is_unknown(b)) { ck_error(c, e.items[1].line, e.items[1].col, name + " angle must be numeric"); }
            }
            if (name == "quat_axis_angle") { return ty(TcQuat, "quat"); }
            return ty(TcMat, "mat4")
        }
        if (name == "mat4_perspective") {
            if (e.items.len != 4) { ck_error(c, e.line, e.col, "mat4_perspective(fovy, aspect, near, far) takes 4 arguments"); }
            for i in 0..e.items.len { Type* a = ck_expr(c, e.items[i]); if (!t_is_numeric(a) && !t_is_unknown(a)) { ck_error(c, e.items[i].line, e.items[i].col, "mat4_perspective arguments must be numeric"); } }
            return ty(TcMat, "mat4")
        }
        if (name == "mat4_look_at") {
            if (e.items.len != 3) { ck_error(c, e.line, e.col, "mat4_look_at(eye, center, up) takes 3 arguments"); }
            for i in 0..e.items.len { Type* a = ck_expr(c, e.items[i]); if (a.name != "vec3" && !t_is_unknown(a)) { ck_error(c, e.items[i].line, e.items[i].col, "mat4_look_at arguments must be vec3"); } }
            return ty(TcMat, "mat4")
        }
        if (name == "quat_normalize") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "quat_normalize(q) takes 1 argument"); }
            else { Type* a = ck_expr(c, e.items[0]); if (a.cat != TcQuat && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, "quat_normalize expects a quat"); } }
            return ty(TcQuat, "quat")
        }
        if (name == "quat_to_mat4") {
            if (e.items.len != 1) { ck_error(c, e.line, e.col, "quat_to_mat4(q) takes 1 argument"); }
            else { Type* a = ck_expr(c, e.items[0]); if (a.cat != TcQuat && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, "quat_to_mat4 expects a quat"); } }
            return ty(TcMat, "mat4")
        }
        if (name == "quat_rotate") {
            if (e.items.len != 2) { ck_error(c, e.line, e.col, "quat_rotate(q, v) takes 2 arguments"); }
            else {
                Type* a = ck_expr(c, e.items[0])
                Type* b = ck_expr(c, e.items[1])
                if (a.cat != TcQuat && !t_is_unknown(a)) { ck_error(c, e.items[0].line, e.items[0].col, "quat_rotate expects a quat"); }
                if (b.name != "vec3" && !t_is_unknown(b)) { ck_error(c, e.items[1].line, e.items[1].col, "quat_rotate expects a vec3"); }
            }
            return ty(TcVec, "vec3")
        }

        int fi = ck_func_index(c, name)
        if (fi >= 0) {
            callee.text = c.funcs[fi].cname   // codegen emits the C name
            int np = c.funcs[fi].params.len
            if (e.items.len != np) { ck_error(c, e.line, e.col, "function '" + name + "' expects " + int_to_str(np) + " argument(s), got " + int_to_str(e.items.len)); }
            int k = e.items.len
            if (np < k) { k = np; }
            for i in 0..k {
                Type* at = ck_expr_as(c, e.items[i], c.funcs[fi].params[i])
                if (!ck_assignable(c.funcs[fi].params[i], at)) {
                    ck_error(c, e.items[i].line, e.items[i].col, "argument " + int_to_str(i + 1) + " to '" + name + "' expects " + t_str(c.funcs[fi].params[i]) + ", got " + t_str(at))
                }
            }
            for i in k..e.items.len { ck_expr(c, e.items[i]); }
            return c.funcs[fi].ret
        }

        // a Strata function this file can't see (even with C headers imported, it must not
        // silently resolve to another module's private function)
        string why = ck_hidden(c, name)
        if why != "" {
            ck_error(c, e.line, e.col, why)
            for i in 0..e.items.len { ck_expr(c, e.items[i]); }
            return c.t_unknown
        }
        // unknown name: treat as an external C function if a header was imported; else error.
        if (!c.has_foreign) { ck_error(c, e.line, e.col, "call to undeclared function '" + name + "'"); }
        for i in 0..e.items.len { ck_expr(c, e.items[i]); }
        return c.t_unknown
    }

    for i in 0..e.items.len { ck_expr(c, e.items[i]); }
    return c.t_unknown
}

// ---- statements --------------------------------------------------------

void ck_block(Checker* c, Stmt* b) {
    ck_push(c)
    for i in 0..b.stmts.len { ck_stmt(c, b.stmts[i]); }
    ck_pop(c)
}

void ck_stmt(Checker* c, Stmt* s) {
    switch (s.kind) {
        case StBlock:
            ck_block(c, s)
        case StVar:
            {
                Type* declared = c.t_unknown
                if (s.type != null) { declared = ck_type(c, s.type); }
                if (s.init != null) {
                    Type* vt = ck_expr_as(c, s.init, declared)
                    if (s.type == null) {
                        declared = vt
                        s.type = type_to_node(vt)// write inference back for codegen
                    } else {
                        if (!ck_assignable(declared, vt)) {
                            ck_error(c, s.line, s.col, "cannot initialize '" + s.name + "' of type " + t_str(declared) + " with a value of type " + t_str(vt))
                        }
                    }
                } else {
                    if (s.type == null) { ck_error(c, s.line, s.col, "'var' requires an initializer"); }
                }
                ck_declare(c, s.name, declared, s.is_const, s.line, s.col)
            }
        case StReturn:
            {
                if (s.expr != null) {
                    Type* vt = ck_expr_as(c, s.expr, c.cur_ret)
                    if (c.cur_ret.cat == TcVoid) { ck_error(c, s.line, s.col, "returning a value from a void function"); }
                    else if (!ck_assignable(c.cur_ret, vt)) { ck_error(c, s.line, s.col, "returning " + t_str(vt) + " from a function declared to return " + t_str(c.cur_ret)); }
                } else {
                    if (c.cur_ret.cat != TcVoid) { ck_error(c, s.line, s.col, "missing return value; function returns " + t_str(c.cur_ret)); }
                }
            }
        case StExprStmt:
            ck_expr(c, s.expr)
        case StAssign:
            {
                LvalueResult lv = ck_lvalue(c, s.target)
                if (!lv.ok) { ck_error(c, s.line, s.col, "left side of '" + s.op + "' is not assignable"); }
                else if (lv.is_const) { ck_error(c, s.line, s.col, "cannot assign to a const variable"); }
                Type* tt = ck_expr(c, s.target)
                Type* vt = ck_expr_as(c, s.value, tt)
                if (tt.cat == TcVec && s.op != "=") {
                    // vector compound-assign: += / -= need a matching vector; *= a vector or scalar
                    if (s.op == "+=" || s.op == "-=") {
                        if (!(vt.cat == TcVec && vt.name == tt.name) && !t_is_unknown(vt)) { ck_error(c, s.line, s.col, "'" + s.op + "' on " + tt.name + " requires a " + tt.name); }
                    } else if (s.op == "*=") {
                        if (!((vt.cat == TcVec && vt.name == tt.name) || t_is_numeric(vt)) && !t_is_unknown(vt)) { ck_error(c, s.line, s.col, "'*=' on a vector requires a matching vector or a scalar"); }
                    } else {
                        ck_error(c, s.line, s.col, "'" + s.op + "' is not defined for vectors")
                    }
                } else {
                    if (s.op != "=" && !t_is_numeric(tt) && !t_is_unknown(tt)) { ck_error(c, s.line, s.col, "'" + s.op + "' requires a numeric operand, got " + t_str(tt)); }
                    if (!ck_assignable(tt, vt)) { ck_error(c, s.line, s.col, "cannot assign " + t_str(vt) + " to " + t_str(tt)); }
                }
            }
        case StIf:
            {
                Type* cd = ck_expr(c, s.cond)
                if (cd.cat != TcBool && !t_is_unknown(cd)) { ck_error(c, s.line, s.col, "if condition must be bool, got " + t_str(cd)); }
                ck_block(c, s.then_block)
                if (s.else_branch != null) { ck_stmt(c, s.else_branch); }
            }
        case StWhile:
            {
                Type* cd = ck_expr(c, s.cond)
                if (cd.cat != TcBool && !t_is_unknown(cd)) { ck_error(c, s.line, s.col, "while condition must be bool, got " + t_str(cd)); }
                c.loop_depth += 1
                ck_block(c, s.body)
                c.loop_depth -= 1
            }
        case StForIn:
            {
                // for-in over an integer range `lo..hi` (loop var int), or over an array
                // (loop var = element type).
                Type* elemT = c.t_int
                if (s.iter != null && s.iter.kind == ExBinary && s.iter.text == "..") {
                    Type* lo = ck_expr(c, s.iter.a)
                    Type* hi = ck_expr(c, s.iter.b)
                    if (!t_is_integer(lo) && !t_is_unknown(lo)) { ck_error(c, s.iter.line, s.iter.col, "range start must be an integer, got " + t_str(lo)); }
                    if (!t_is_integer(hi) && !t_is_unknown(hi)) { ck_error(c, s.iter.line, s.iter.col, "range end must be an integer, got " + t_str(hi)); }
                } else if (s.iter != null) {
                    Type* it = ck_expr(c, s.iter)
                    if (it.cat == TcDynArray || it.cat == TcArray) {
                        if (it.elem != null) { elemT = it.elem; } else { elemT = c.t_unknown; }
                    } else if (!t_is_unknown(it)) {
                        ck_error(c, s.line, s.col, "for-in needs an integer range or an array, got " + t_str(it))
                    } else {
                        elemT = c.t_unknown
                    }
                } else {
                    ck_error(c, s.line, s.col, "for-in needs an iterable")
                }
                ck_push(c)
                ck_declare(c, s.name, elemT, false, s.line, s.col)
                c.loop_depth += 1
                ck_block(c, s.body)
                c.loop_depth -= 1
                ck_pop(c)
            }
        case StRegion:
            {
                ck_push(c)
                if (s.name.len > 0) { ck_declare(c, s.name, ty(TcStruct, "Arena"), false, s.line, s.col); }
                ck_block(c, s.body)
                ck_pop(c)
            }
        case StSwitch:
            {
                Type* st = ck_expr(c, s.subject)
                if (!t_is_integer(st) && st.cat != TcChar && !t_is_unknown(st)) {
                    ck_error(c, s.line, s.col, "switch subject must be an integer, char, or enum, got " + t_str(st))
                }
                for i in 0..s.cases.len {
                    SwitchCase sc = s.cases[i]
                    for j in 0..sc.values.len {
                        Type* vt = ck_expr(c, sc.values[j])
                        if (!t_is_integer(vt) && vt.cat != TcChar && !t_is_unknown(vt)) {
                            ck_error(c, sc.values[j].line, sc.values[j].col, "switch case value must be an integer, char, or enum, got " + t_str(vt))
                        }
                    }
                    ck_block(c, sc.body)
                }
            }
        case StBreak, StContinue:
            {
                if c.loop_depth == 0 {
                    string word = "break"
                    if s.kind == StContinue { word = "continue" }
                    ck_error(c, s.line, s.col, "'" + word + "' is only allowed inside a loop")
                }
            }
        default:
            {
            }
    }
}

// Check a function body. Uses the signature resolved in pass 1d (the TypeNodes already
// carry C names by then, so they must not be resolved a second time).
void ck_func(Checker* c, Decl* f, int fi) {
    c.cur_ret = c.funcs[fi].ret
    c.loop_depth = 0
    ck_push(c)
    for i in 0..f.params.len {
        ck_declare(c, f.params[i].name, c.funcs[fi].params[i], false, f.line, f.col)
    }
    ck_block(c, f.body)
    ck_pop(c)
}

// ---- module-level names --------------------------------------------------

int ck_own_struct(Checker* c, string name, int module) {
    int found = 0 - 1
    int k = idx_first(&c.struct_idx, name)
    while k >= 0 {
        if c.structs[k].name == name && c.structs[k].module == module { found = k }
        k = idx_next(&c.struct_idx, k)
    }
    return found
}
int ck_own_func(Checker* c, string name, int module) {
    int found = 0 - 1
    int k = idx_first(&c.func_idx, name)
    while k >= 0 {
        if c.funcs[k].name == name && c.funcs[k].module == module { found = k }
        k = idx_next(&c.func_idx, k)
    }
    return found
}
int ck_own_enum(Checker* c, string name, int module) {
    int found = 0 - 1
    int k = idx_first(&c.enum_idx, name)
    while k >= 0 {
        if c.enums[k].name == name && c.enums[k].module == module { found = k }
        k = idx_next(&c.enum_idx, k)
    }
    return found
}
int ck_own_member(Checker* c, string name, int module) {
    int found = 0 - 1
    int k = idx_first(&c.member_idx, name)
    while k >= 0 {
        if c.enum_members[k].member == name && c.enum_members[k].module == module { found = k }
        k = idx_next(&c.member_idx, k)
    }
    return found
}

// A module name as a C identifier prefix: `gfx.Renderer` -> `gfx_Renderer`.
string ck_c_ident(string s) {
    string r = ""
    for i in 0..s.len {
        char ch = s[i]
        if (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_' { r = r + substr(s, i, 1) }
        else { r = r + "_" }
    }
    return r
}

// The C name for a top-level declaration: private names that another module also
// declares get the module prefix; everything else keeps its source name.
string ck_cname(Checker* c, string name, int module, bool exported) {
    if exported { return name }
    int k = idx_first(&c.name_idx, name)
    while k >= 0 {
        if c.names[k].name == name && c.names[k].module != module {
            return ck_c_ident(c.mods[module].name) + "__" + name
        }
        k = idx_next(&c.name_idx, k)
    }
    return name
}

void ck_note_name(Checker* c, string name, int module, bool exported, int line, int col) {
    idx_add(&c.name_idx, name, c.names.len)
    c.names.push(NameEntry{ name, module, exported, line, col })
}

// Exported names must be unique program-wide (they are C symbols), and a module's own
// declaration can't share a name with an export it can see.
void ck_name_conflicts(Checker* c) {
    for j in 0..c.names.len {
        NameEntry b = c.names[j]
        c.cur = b.module
        // earlier entries exporting the same name (reported oldest first)
        int[dynamic] dups = []
        int conflict = 0 - 1
        int k = idx_first(&c.name_idx, b.name)
        while k >= 0 {
            NameEntry o = c.names[k]
            if o.name == b.name && o.module != b.module && o.exported {
                if k < j && b.exported { dups.push(k) }
                if !b.exported && ck_sees(c, o.module, true) { conflict = k }   // keeps the earliest
            }
            k = idx_next(&c.name_idx, k)
        }
        int d = dups.len - 1
        while d >= 0 {
            ck_error(c, b.line, b.col, "'" + b.name + "' is also exported by " + c.mods[c.names[dups[d]].module].file + " (exported names must be unique across the program)")
            d -= 1
        }
        if conflict >= 0 {
            ck_error(c, b.line, b.col, "'" + b.name + "' conflicts with the '" + b.name + "' exported by " + c.mods[c.names[conflict].module].file + ", which this file imports")
        }
    }
}

// ---- program -----------------------------------------------------------

export bool ck_check(Checker* c, Program prog) {
    // modules: a Program built without the loader (a single parsed file) is one module
    c.mods = prog.modules
    if c.mods.len == 0 { c.mods.push(new_module(c.file, c.file, c.file)) }
    ck_visibility(c)

    // pass 0: note whether any C header is imported (enables external C calls)
    for i in 0..prog.decls.len { if (prog.decls[i].kind == DcInclude) { c.has_foreign = true; } }

    // size the name indexes (so they never need to grow)
    int n_all = 0
    for i in 0..prog.decls.len { n_all = n_all + 1 + prog.decls[i].members.len }
    c.struct_idx = new_idx(n_all)
    c.func_idx = new_idx(n_all)
    c.enum_idx = new_idx(n_all)
    c.member_idx = new_idx(n_all)
    c.name_idx = new_idx(n_all)
    c.node_idx = new_idx(n_all)
    c.global_idx = new_idx(n_all)

    // pass 1a: register every top-level name (enums + members, structs, functions);
    // duplicates are errors within one module, and allowed (if private) across modules
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        c.cur = d.module
        if d.kind == DcEnum {
            if ck_own_enum(c, d.name, d.module) >= 0 { ck_error(c, d.line, d.col, "enum '" + d.name + "' is already defined") }
            idx_add(&c.enum_idx, d.name, c.enums.len)
            c.enums.push(EnumInfo{ d.name, d.module, d.is_exported, d.name })
            ck_note_name(c, d.name, d.module, d.is_exported, d.line, d.col)
            for m in 0..d.members.len {
                string mem = d.members[m]
                if ck_own_member(c, mem, d.module) >= 0 { ck_error(c, d.line, d.col, "enum member '" + mem + "' is already defined") }
                idx_add(&c.member_idx, mem, c.enum_members.len)
                c.enum_members.push(EnumMember{ mem, d.name, d.module, d.is_exported, mem })
                ck_note_name(c, mem, d.module, d.is_exported, d.line, d.col)
            }
        } else if d.kind == DcStruct {
            if ck_own_struct(c, d.name, d.module) >= 0 { ck_error(c, d.line, d.col, "struct '" + d.name + "' is already defined") }
            FieldInfo[dynamic] ff = []
            idx_add(&c.struct_idx, d.name, c.structs.len)
            c.structs.push(StructInfo{ d.name, ff, d.module, d.is_exported, d.name })
            ck_note_name(c, d.name, d.module, d.is_exported, d.line, d.col)
        } else if d.kind == DcGlobal {
            if ck_own_global(c, d.name, d.module) >= 0 { ck_error(c, d.line, d.col, "global '" + d.name + "' is already defined") }
            idx_add(&c.global_idx, d.name, c.globals.len)
            c.globals.push(GlobalInfo{ d.name, c.t_unknown, d.module, d.is_exported, d.name })
            ck_note_name(c, d.name, d.module, d.is_exported, d.line, d.col)
        } else if d.kind == DcFunc {
            if ck_own_func(c, d.name, d.module) >= 0 { ck_error(c, d.line, d.col, "function '" + d.name + "' is already defined") }
            Type*[dynamic] ps = []
            idx_add(&c.func_idx, d.name, c.funcs.len)
            c.funcs.push(FuncInfo{ d.name, ps, c.t_void, d.module, d.is_exported, d.name })
            ck_note_name(c, d.name, d.module, d.is_exported, d.line, d.col)
        }
    }

    // pass 1b: C names (a private name declared in several modules gets a prefix),
    // then the module-level name rules
    for i in 0..c.enums.len { c.enums[i].cname = ck_cname(c, c.enums[i].name, c.enums[i].module, c.enums[i].exported) }
    for i in 0..c.enum_members.len {
        EnumMember m = c.enum_members[i]
        c.enum_members[i].cname = ck_cname(c, m.member, m.module, m.exported)
        c.enum_members[i].enum_name = c.enums[ck_own_enum(c, m.enum_name, m.module)].cname
    }
    for i in 0..c.structs.len { c.structs[i].cname = ck_cname(c, c.structs[i].name, c.structs[i].module, c.structs[i].exported) }
    c.cname_idx = new_idx(c.structs.len)
    for i in 0..c.structs.len { idx_add(&c.cname_idx, c.structs[i].cname, i) }
    for i in 0..c.funcs.len { c.funcs[i].cname = ck_cname(c, c.funcs[i].name, c.funcs[i].module, c.funcs[i].exported) }
    for i in 0..c.globals.len { c.globals[i].cname = ck_cname(c, c.globals[i].name, c.globals[i].module, c.globals[i].exported) }
    // a foreign function is the symbol it names: never renamed
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.kind == DcFunc && d.is_foreign { c.funcs[ck_own_func(c, d.name, d.module)].cname = d.name }
    }
    ck_name_conflicts(c)

    // pass 1c: struct fields
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcStruct) {
            c.cur = d.module
            int si = ck_own_struct(c, d.name, d.module)
            for fld in 0..d.fields.len {
                c.structs[si].fields.push(FieldInfo{ d.fields[fld].name, ck_type(c, d.fields[fld].type) })
            }
        }
    }
    // pass 1d: function signatures
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcFunc) {
            c.cur = d.module
            int fi = ck_own_func(c, d.name, d.module)
            for pi in 0..d.params.len { c.funcs[fi].params.push(ck_type(c, d.params[pi].type)); }
            c.funcs[fi].ret = ck_type(c, d.ret)
        }
    }
    // pass 1e: globals - their types and constant initializers
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.kind == DcGlobal {
            c.cur = d.module
            int gi = ck_own_global(c, d.name, d.module)
            Type* declared = c.t_unknown
            if d.ret != null { declared = ck_type(c, d.ret) }
            if d.init != null {
                if !ck_is_constant(d.init) { ck_error(c, d.line, d.col, "a global's initial value must be a constant (a number, char, bool, string or null)") }
                Type* vt = ck_expr_as(c, d.init, declared)
                if d.ret == null { declared = vt; d.ret = type_to_node(vt) }
                else if !ck_assignable(declared, vt) { ck_error(c, d.line, d.col, "cannot initialize global '" + d.name + "' of type " + t_str(declared) + " with a value of type " + t_str(vt)) }
            } else if d.ret == null {
                ck_error(c, d.line, d.col, "'global var' needs an initial value")
            }
            c.globals[gi].type = declared
        }
    }
    // pass 2: function bodies
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if (d.kind == DcFunc && !d.is_foreign) {
            c.cur = d.module
            ck_func(c, d, ck_own_func(c, d.name, d.module))
        }
    }
    // pass 3: top-level code (the implicit main) - the root module's
    c.cur = 0
    c.cur_ret = c.t_void
    ck_push(c)
    for i in 0..prog.main.len { ck_stmt(c, prog.main[i]); }
    ck_pop(c)

    // finally: declarations take their C names (codegen emits d.name / d.members)
    for i in 0..prog.decls.len {
        Decl* d = prog.decls[i]
        if d.kind == DcFunc   { d.name = c.funcs[ck_own_func(c, d.name, d.module)].cname }
        if d.kind == DcGlobal { d.name = c.globals[ck_own_global(c, d.name, d.module)].cname }
        if d.kind == DcStruct { d.name = c.structs[ck_own_struct(c, d.name, d.module)].cname }
        if d.kind == DcEnum {
            for m in 0..d.members.len { d.members[m] = c.enum_members[ck_own_member(c, d.members[m], d.module)].cname }
            d.name = c.enums[ck_own_enum(c, d.name, d.module)].cname
        }
    }
    return !c.had_error
}

export Checker* new_checker(string file) {
    StructInfo[dynamic] ss = []
    FuncInfo[dynamic]   fs = []
    EnumInfo[dynamic]   es = []
    EnumMember[dynamic] ems = []
    GlobalInfo[dynamic] gls = []
    Module[dynamic]     mods = []
    NameEntry[dynamic]  names = []
    TypeNode*[dynamic]  nodes = []
    return alloc(Checker{ file, false, false, ss, fs, es, ems, gls, new_idx(0), null, ty(TcVoid, "void"), mods, 0, names,
                          new_idx(0), new_idx(0), new_idx(0), new_idx(0), new_idx(0), new_idx(0), nodes, new_idx(0), 0,
                          ty(TcInt, "int"), ty(TcBool, "bool"), ty(TcFloat, "float"), ty(TcStr, "string"),
                          ty(TcVoid, "void"), ty(TcUnknown, "?"), ty(TcChar, "char") })
}
