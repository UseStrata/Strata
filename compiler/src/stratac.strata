// src/stratac.strata - the Strata compiler driver (front-end #1: the CLI, `stratac`).
// Thin: CLI + orchestration only (ARCHITECTURE.md rule #4). Pulls in the shared
// renderer (dump.strata), which pulls in the whole core (incl. codegen).
//
//   stratac tokens <file.strata>   print the token stream
//   stratac ast    <file.strata>   parse and print the AST
//   stratac emit   <file.strata>   print the generated C
//   stratac build  <file.strata>   compile to a native executable
//   stratac run    <file.strata>   compile and run

import core   // the compiler (every phase, re-exported)
import dump   // print_tokens / print_program
import project   // strata.toml
import build     // the build pipeline + cache, targets
import version   // stratac_version
import <stdlib.h>   // exit()  (C header, passed through to the generated C)
import "strata_host.h"   // strata_exe_path, strata_make_dirs, strata_run_argv


// ---- paths -------------------------------------------------------------
// (stem_of / basename_of / dirname_of live in the core's module loader)

bool file_exists(string p) { return read_file(p).len > 0; }

// Find the runtime lib/ (arena.h, ...) relative to the stratac executable: next to it
// (an install), or one level up (the repo: bin/../lib). The OS knows where the exe is,
// even when it was started from PATH; argv[0] and the current folder are fallbacks.
string resolve_libdir(string argv0) {
    string exe = strata_exe_path()
    if exe != "" {
        string edir = dirname_of(exe)
        if (file_exists(edir + "/lib/arena.h"))    { return edir + "/lib"; }
        if (file_exists(edir + "/../lib/arena.h")) { return edir + "/../lib"; }
    }
    string dir = dirname_of(argv0)
    if (file_exists(dir + "/lib/arena.h"))    { return dir + "/lib"; }
    if (file_exists(dir + "/../lib/arena.h")) { return dir + "/../lib"; }
    if (file_exists("lib/arena.h"))           { return "lib"; }
    if (file_exists("../lib/arena.h"))        { return "../lib"; }
    return dir + "/lib"
}

// ---- pipeline helpers --------------------------------------------------

int cmd_tokens(string path) {
    print_tokens(lex(read_file(path)))
    return 0
}

// `ast` shows ONE file as parsed (imports appear as nodes; nothing is loaded).
int cmd_ast(string path) {
    Parser p = new_parser(lex(read_file(path)))
    Program prog = parse_program(&p)
    if p.had_error {
        print(basename_of(path) + ":" + int_to_str(p.err_line) + ":" + int_to_str(p.err_col) + ": parse error: " + p.err_msg)
        return 1
    }
    print_program(prog)
    return 0
}

int cmd_check(string path) {
    LoadResult lr = load_program(path)
    if (!lr.ok) { return 1; }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(path))
    ck_check(ck, prog)
    if (ck.had_error) { return 1; }
    print("no type errors")
    return 0
}

int cmd_emit(string path) {
    LoadResult lr = load_program(path)
    if (!lr.ok) { return 1; }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(path))
    ck_check(ck, prog)
    if (ck.had_error) { return 1; }
    Codegen cg = new_codegen()
    string out = generate(&cg, prog)
    if (cg.had_error) { print("codegen: program uses features not supported yet"); return 1; }
    printf(cstr("%s"), cstr(out))// verbatim, like fputs
    return 0
}

// `stratac asm` / `stratac ir`: the native backend's output (`opt`: optimized)
int cmd_native(string path, bool show_ir, bool opt) {
    LoadResult lr = load_program(path)
    if (!lr.ok) { return 1; }
    Program prog = lr.prog
    Checker* ck = new_checker(basename_of(path))
    ck_check(ck, prog)
    if (ck.had_error) { return 1; }
    NativeResult nr = native_compile(prog, true, opt)
    if !nr.ok { print(basename_of(path) + ": error: can't compile natively: " + nr.why); return 1 }
    if show_ir { printf(cstr("%s"), cstr(nr.ir)) } else { printf(cstr("%s"), cstr(nr.asm_text)) }
    return 0
}

// `stratac assemble file.s [out.o]`: Strata's x86-64 assembler on its own (GNU-as AT&T
// syntax, the subset the native backend writes) -> a Windows COFF object file.
int cmd_assemble(string path, string out) {
    string src = read_file(path)
    if src.len == 0 { print("error: cannot read " + path); return 1 }
    ObjFile ob = assemble_x64(src)
    if !ob.ok { print(basename_of(path) + ": error: " + ob.err); return 1 }
    if out == "" { out = stem_of(path) + ".o" }
    if !write_coff(out, &ob) { print("error: cannot write " + out); return 1 }
    return 0
}

BuildSpec cli_spec(Target t, bool release, bool force, bool quiet, string backend) {
    BuildSpec s = target_spec(t, stratac_version(), release, force, quiet)
    s.backend = backend
    return s
}

// ---- build / run / new --------------------------------------------------------

int cmd_build(Target t, string libdir, bool release, bool force, string backend) {
    if run_build(cli_spec(t, release, force, false, backend), libdir) { return 0 }
    return 1
}

int cmd_run(Target t, string libdir, bool release, bool force, string backend, string[dynamic] prog_args) {
    BuildSpec spec = cli_spec(t, release, force, true, backend)
    if spec.dll { print("error: this project builds a dll; there's nothing to run"); return 1 }
    if !run_build(spec, libdir) { return 1 }
    // a bare `prog` would be searched for on PATH, not in the current folder
    string exe = spec.out_bin
    if dirname_of(exe) == "." { exe = "./" + exe }
    if host_os() == "windows" { exe = win_path(exe) }
    string[dynamic] argv = []
    argv.push(exe)
    for i in 0..prog_args.len { argv.push(prog_args[i]) }
    return strata_run_argv(&argv)
}

// stratac new <name>: a project folder with a strata.toml and src/main.strata
int cmd_new(string name) {
    if file_exists(name + "/strata.toml") { print("error: " + name + "/strata.toml already exists"); return 1 }
    if !strata_make_dirs(name + "/src") { print("error: could not create " + name + "/src"); return 1 }
    string pname = basename_of(name)
    string toml = "# " + pname + " - a Strata project. Build: stratac build   Run: stratac run\n" +
                  "[project]\n" +
                  "name    = \"" + pname + "\"\n" +
                  "version = \"0.1.0\"\n" +
                  "entry   = \"src/main.strata\"\n" +
                  "output  = \"exe\"          # or \"dll\"\n" +
                  "\n" +
                  "[build]\n" +
                  "libs = []                # C libraries for every platform, e.g. [\"raylib\"]\n" +
                  "\n" +
                  "[windows]\n" +
                  "libs = []                # e.g. [\"user32\"]\n" +
                  "\n" +
                  "[linux]\n" +
                  "libs = []                # e.g. [\"X11\"]\n" +
                  "\n" +
                  "[macos]\n" +
                  "frameworks = []          # e.g. [\"Cocoa\"]\n"
    bool ok = write_file(name + "/strata.toml", toml)
    ok = ok && write_file(name + "/src/main.strata", "// " + pname + " - the entry point. Other files in this folder are modules: `import name`.\nprint(\"hello from " + pname + "\")\n")
    ok = ok && write_file(name + "/.gitignore", "build/\n")
    if !ok { print("error: could not write the project files in " + name); return 1 }
    print("created " + name + "/strata.toml and " + name + "/src/main.strata")
    print("next:  cd " + name + "  then  stratac run")
    return 0
}

int usage() {
    print("stratac - the Strata compiler")
    print("usage:")
    print("  stratac new    <name>            create a project (strata.toml + src/main.strata)")
    print("  stratac run    [target] [--release] [--force] [--backend b] [-- args]   build and run")
    print("  stratac build  [target] [--release] [--force] [--backend b]             build an exe or dll")
    print("  stratac check  [target]          type-check only")
    print("  stratac emit   [target]          print the generated C")
    print("  stratac asm    [target] [--release]   print the generated assembly (native backend)")
    print("  stratac ir     [target] [--release]   print the native backend's IR")
    print("  stratac assemble <file.s> [out.o]     assemble x86-64 (AT&T) into an object file")
    print("  stratac ast    <file.strata>     parse and print the AST")
    print("  stratac tokens <file.strata>     print the token stream")
    print("")
    print("target: a .strata file, a project folder, a strata.toml, or nothing (the project")
    print("in the current folder). Projects are cached: unchanged builds skip the C compiler.")
    print("")
    print("backend: native (Strata's own x86-64 code; --release optimizes it), c (C, then gcc),")
    print("or auto (the default: native when it can build the program, else c).")
    return 2
}

int dmm_main(string[dynamic] args) {
    if (args.len == 2 && (args[1] == "version" || args[1] == "--version")) {
        print("stratac " + stratac_version() + " - the Strata compiler")
        return 0
    }
    if (args.len < 2) { return usage(); }

    // stratac <cmd> [target] [--release] [--force] [program args...] [-- program args...]
    string cmd = args[1]
    string target = ""
    bool have_target = false
    bool release = false
    bool force = false
    bool rest_mode = false
    string backend = "auto"
    bool backend_next = false
    string[dynamic] prog_args = []
    for i in 2..args.len {
        string a = args[i]
        if rest_mode { prog_args.push(a) }
        else if backend_next { backend = a; backend_next = false }
        else if a == "--" { rest_mode = true }
        else if a == "--backend" { backend_next = true }
        else if a == "--release" { release = true }
        else if a == "--force" { force = true }
        else if !have_target { target = a; have_target = true }
        else { prog_args.push(a) }
    }
    string libdir = resolve_libdir(args[0])
    if backend_next || (backend != "auto" && backend != "native" && backend != "c") {
        print("error: --backend takes native, c or auto")
        return 2
    }

    if cmd == "new" {
        if !have_target { print("usage: stratac new <name>"); return 2 }
        return cmd_new(target)
    }
    if cmd == "assemble" {
        if !have_target { print("usage: stratac assemble <file.s> [out.o]"); return 2 }
        string out = ""
        if prog_args.len > 0 { out = prog_args[0] }
        return cmd_assemble(target, out)
    }
    if cmd == "tokens" || cmd == "ast" {
        if !have_target { return usage() }
        if cmd == "tokens" { return cmd_tokens(target) }
        return cmd_ast(target)
    }
    if cmd != "check" && cmd != "emit" && cmd != "asm" && cmd != "ir" && cmd != "build" && cmd != "run" { return usage() }

    Target t = resolve_target(target)
    if !t.ok { return 1 }
    if cmd == "check" { return cmd_check(t.file) }
    if cmd == "emit"  { return cmd_emit(t.file) }
    if cmd == "asm"   { return cmd_native(t.file, false, release) }
    if cmd == "ir"    { return cmd_native(t.file, true, release) }
    if cmd == "build" { return cmd_build(t, libdir, release, force, backend) }
    return cmd_run(t, libdir, release, force, backend, prog_args)
}

// entry point (translated from D--'s `int main(str[] args)`)
import <stdlib.h>
exit(dmm_main(args()))
