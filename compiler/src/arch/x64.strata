// Copyright © 2026 Connor Rutberg
//
// src/arch/x64.strata - everything about the x86-64 CPU. CORE.
//
//   * IR -> x86-64 assembly (GNU as, AT&T syntax), for Windows x64 (below);
//   * the encoder: assembly -> machine code, one instruction at a time, for asm.strata
//     (x64_instruction, x64_fixup) - moves and sign / zero extensions, integer ALU,
//     multiply / divide, shifts, compares and setcc, jumps and calls, push / pop, SSE
//     scalar float arithmetic, compares and conversions. Jumps and calls always take a
//     32-bit displacement (sizes never depend on label positions: one pass + fixups);
//     immediates take 8 bits when they fit.
//
//
// The first native target. Each function gets a frame:
//
//     [rbp + 16 ...]   incoming arguments 5+ (above the caller's 32-byte shadow space)
//     [rbp + 8]        return address
//     [rbp]            the caller's rbp
//     [rbp - ...]      saved callee-saved registers, vregs the register allocator left in
//                      memory, stack slots
//     [rsp ...]        outgoing arguments (32 bytes of shadow space, then arguments 5+)
//
// Registers: the allocator (opt.strata, `alloc_regs`) may give a vreg one of the
// callee-saved registers (rbx, rsi, rdi, r12-r15 / xmm6-xmm15), which calls leave alone,
// or - if it doesn't live across a call - r10, xmm4 or xmm5; the rest live in memory.
// rax, rcx, rdx, r8, r11 and xmm0-xmm1 are the emitter's own scratch.
//
// Some vregs never need a home at all ("lazy"): a single-definition integer constant that
// fits in 32 bits is used as an immediate; the address of a stack slot or of data is
// folded into the memory operand that uses it (or made with `lea` where it's needed).
// Every read of an integer vreg therefore goes through `src` / `get`, never `opnd`.
//
// A comparison whose only use is the branch right after it becomes compare + jump.
//
// The Windows x64 convention: arguments 1-4 in rcx, rdx, r8, r9 (or xmm0-3 for floats, by
// position), the rest on the stack; results in rax / xmm0; the stack 16-byte aligned at
// every call; a frame bigger than a page touches each page in order (the guard page).

import ir
import opt     // RegSet
import host   // strata_join
import asm    // the assembler this file encodes for: Asm, asm_byte, asm_fix, ...

export struct X64 {
    bool            direct      // build machine code straight into `as`; else assembly text in `out`
    Asm             as
    string[dynamic] out
    string[dynamic] data        // read-only data, as assembly lines (float constants)
    int             floats      // float constants handed out
    int             fnum        // the function being emitted (for local label names)
    int             loops       // copy loops handed out
    // the function being emitted
    int[dynamic]    loc         // per vreg: its rbp offset (negative), or its register number
    int[dynamic]    isreg       // per vreg: 1 if `loc` is a register
    int[dynamic]    lazy        // per vreg: 0 normal, 1 immediate, 2 slot address, 3 data address
    int[dynamic]    lval        // per lazy vreg: the immediate / the slot number
    string[dynamic] lsym        // per lazy vreg: the data symbol
    int[dynamic]    nuse        // per vreg: how many operands read it
    int[dynamic]    slot_off    // per slot: its rbp offset
    int[dynamic]    saved       // callee-saved registers this function uses (register numbers)
    int             save_base   // rbp offset of the xmm save area
}

// `direct`: machine code (the normal way: x64_finish_object); else assembly text
// (x64_finish: `stratac asm`). `size_hint`: about how many instructions there will be.
export X64 new_x64(bool direct, int size_hint) {
    string[dynamic] o = []
    string[dynamic] d = []
    int[dynamic] a = []
    int[dynamic] r = []
    int[dynamic] lz = []
    int[dynamic] lv = []
    string[dynamic] ls = []
    int[dynamic] nu = []
    int[dynamic] b = []
    int[dynamic] c = []
    return X64{ direct, asm_new("x64", size_hint), o, d, 0, 0, 0, a, r, lz, lv, ls, nu, b, c, 0 }
}

int align_to(int n, int a) { return (n + a - 1) / a * a }

// ---- operands -----------------------------------------------------------------------------
// Hardware register numbers: 0 rax, 1 rcx, 2 rdx, 3 rbx, 4 rsp, 5 rbp, 6 rsi, 7 rdi,
// 8-15 r8-r15; xmm0-15 the same numbers with size 16.

Opnd hw(int r, int size) { return Opnd{ 1, r, size, 0, 0, "" } }
Opnd rax() { return hw(0, 8) }
Opnd rcx() { return hw(1, 8) }
Opnd rdx() { return hw(2, 8) }
Opnd rsp() { return hw(4, 8) }
Opnd rbp() { return hw(5, 8) }
Opnd r8() { return hw(8, 8) }
Opnd r11() { return hw(11, 8) }
Opnd xmm(int n) { return Opnd{ 1, n, 16, 0, 0, "" } }
Opnd imm(int v) { return Opnd{ 2, 0, 0, v, 0, "" } }
Opnd mem(int base, int disp) { return Opnd{ 3, 0, 0, disp, base, "" } }   // disp(%base)
Opnd rip(string sym, int off) { return Opnd{ 3, 0, 0, off, 0 - 1, sym } }  // sym+off(%rip)
Opnd target(string name) { return Opnd{ 4, 0, 0, 0, 0, name } }            // a jump / call target

// register r as its `size`-byte self (%rax -> %eax / %ax / %al)
Opnd sized(Opnd r, int size) { return Opnd{ r.kind, r.reg, size, r.imm, r.base, r.sym } }

bool same(Opnd a, Opnd b) {
    return a.kind == b.kind && a.reg == b.reg && a.size == b.size && a.imm == b.imm && a.base == b.base && a.sym == b.sym
}

// ---- writing instructions ---------------------------------------------------------------------
// Each goes straight to the encoder (machine code), or out as a line of AT&T text.

string reg_text(int r, int size) {
    if size == 16 { return "%xmm" + int_to_str(r) }
    if r >= 8 {
        if size == 4 { return "%r" + int_to_str(r) + "d" }
        if size == 2 { return "%r" + int_to_str(r) + "w" }
        if size == 1 { return "%r" + int_to_str(r) + "b" }
        return "%r" + int_to_str(r)
    }
    string[dynamic] names = ["ax", "cx", "dx", "bx", "sp", "bp", "si", "di"]
    string n = names[r]
    if size == 8 { return "%r" + n }
    if size == 4 { return "%e" + n }
    if size == 2 { return "%" + n }
    if r < 4 { return "%" + substr(n, 0, 1) + "l" }   // al cl dl bl
    return "%" + n + "l"                              // spl bpl sil dil
}

string opnd_text(Opnd o) {
    if o.kind == 1 { return reg_text(o.reg, o.size) }
    if o.kind == 2 { return "$" + int_to_str(o.imm) }
    if o.kind == 4 { return o.sym }
    if o.base < 0 {
        string s = o.sym
        if o.imm > 0 { s = s + "+" + int_to_str(o.imm) } else if o.imm < 0 { s = s + int_to_str(o.imm) }
        return s + "(%rip)"
    }
    return int_to_str(o.imm) + "(" + reg_text(o.base, 8) + ")"
}

void ins2(X64* x, string mn, Opnd s, Opnd d) {
    if x.direct { x64_encode(&x.as, mn, 2, s, d) }
    else { x.out.push("\t" + mn + " " + opnd_text(s) + ", " + opnd_text(d) + "\n") }
}
void ins1(X64* x, string mn, Opnd o) {
    if x.direct { x64_encode(&x.as, mn, 1, o, no_opnd()) }
    else { x.out.push("\t" + mn + " " + opnd_text(o) + "\n") }
}
void ins0(X64* x, string mn) {
    if x.direct { x64_encode(&x.as, mn, 0, no_opnd(), no_opnd()) }
    else { x.out.push("\t" + mn + "\n") }
}
void label(X64* x, string name) {
    if x.direct { asm_label_here(&x.as, name) }
    else { x.out.push(name + ":\n") }
}
// a directive (.text, .globl f, .p2align 4, .quad 7, ...)
void dline(X64* x, string s) {
    if x.direct { asm_line(&x.as, s) }
    else { x.out.push("\t" + s + "\n") }
}

// ---- registers --------------------------------------------------------------------------
// Allocatable registers are numbered (see RegSet): 0-6 integer callee-saved, 7-16
// xmm6-xmm15 (callee-saved), 17 r10, 18-19 xmm4-xmm5 (both scratch).

export RegSet x64_regs() { return RegSet{ 7, 10, 1, 2 } }
int x64_int_regs() { return 7 }
int x64_saved_regs() { return 17 }   // registers below this number must be saved if used

// allocatable register k as an operand
Opnd alloc_reg(int k) {
    if k == 17 { return hw(10, 8) }      // r10
    if k == 18 { return xmm(4) }
    if k == 19 { return xmm(5) }
    if k == 0 { return hw(3, 8) }        // rbx
    if k == 1 { return hw(6, 8) }        // rsi
    if k == 2 { return hw(7, 8) }        // rdi
    if k <= 6 { return hw(k + 9, 8) }    // r12-r15
    return xmm(k - 7 + 6)                // xmm6-xmm15
}

bool in_reg(X64* x, int v) { return x.isreg[v] == 1 }
int reg_of(X64* x, int v) { return x.loc[v] }

// A vreg's home: its register or its memory (for writing it, and for float reads).
Opnd opnd(X64* x, int v) {
    if in_reg(x, v) { return alloc_reg(reg_of(x, v)) }
    return mem(5, x.loc[v])
}

string fsuf(int ty) { if ty == KF64 { return "sd" } return "ss" }

// ---- reading and writing vregs -------------------------------------------------------------

Opnd slot_mem(X64* x, int slot, int off) { return mem(5, x.slot_off[slot] + off) }

// An integer vreg as an instruction's SOURCE operand: an immediate, its register or memory.
// (A lazy address is made in %r11.)
Opnd src(X64* x, int v) {
    int lz = x.lazy[v]
    if lz == 1 { return imm(x.lval[v]) }
    if lz == 2 { ins2(x, "leaq", slot_mem(x, x.lval[v], 0), r11()); return r11() }
    if lz == 3 { ins2(x, "leaq", rip(x.lsym[v], 0), r11()); return r11() }
    return opnd(x, v)
}

// integer vreg v -> register r
void get(X64* x, int v, Opnd r) {
    int lz = x.lazy[v]
    if lz == 1 {
        if x.lval[v] == 0 { ins2(x, "xorl", sized(r, 4), sized(r, 4)) }
        else { ins2(x, "movq", imm(x.lval[v]), r) }
    } else if lz == 2 { ins2(x, "leaq", slot_mem(x, x.lval[v], 0), r) }
    else if lz == 3 { ins2(x, "leaq", rip(x.lsym[v], 0), r) }
    else if !same(opnd(x, v), r) { ins2(x, "movq", opnd(x, v), r) }
}
// register r -> integer vreg v
void put(X64* x, Opnd r, int v) {
    Opnd o = opnd(x, v)
    if !same(o, r) { ins2(x, "movq", r, o) }
}
// float vreg v <-> xmm register r
void fget(X64* x, int ty, int v, Opnd r) {
    if in_reg(x, v) { if !same(opnd(x, v), r) { ins2(x, "movaps", opnd(x, v), r) } }
    else { ins2(x, "mov" + fsuf(ty), opnd(x, v), r) }
}
void fput(X64* x, int ty, Opnd r, int v) {
    if in_reg(x, v) { if !same(opnd(x, v), r) { ins2(x, "movaps", r, opnd(x, v)) } }
    else { ins2(x, "mov" + fsuf(ty), r, opnd(x, v)) }
}

// The memory at address-vreg a + off, as an operand (uses %rax if a must be loaded).
Opnd mem_at(X64* x, int a, int off) {
    int lz = x.lazy[a]
    if lz == 2 { return slot_mem(x, x.lval[a], off) }
    if lz == 3 { return rip(x.lsym[a], off) }
    if in_reg(x, a) { return mem(alloc_reg(reg_of(x, a)).reg, off) }
    get(x, a, rax())
    return mem(0, off)
}

// The register to compute an integer result in: dst's own, unless operand b sits there.
Opnd work(X64* x, Ins i) {
    if in_reg(x, i.dst) && !(i.b >= 0 && in_reg(x, i.b) && reg_of(x, i.b) == reg_of(x, i.dst)) {
        return alloc_reg(reg_of(x, i.dst))
    }
    return rax()
}

// Re-establish the invariant (sign / zero extension to 64 bits) for type ty in register r.
void norm(X64* x, int ty, Opnd r) {
    if ty == KI8 { ins2(x, "movsbq", sized(r, 1), r) }
    else if ty == KU8 { ins2(x, "movzbl", sized(r, 1), sized(r, 4)) }
    else if ty == KI16 { ins2(x, "movswq", sized(r, 2), r) }
    else if ty == KU16 { ins2(x, "movzwl", sized(r, 2), sized(r, 4)) }
    else if ty == KI32 { ins2(x, "movslq", sized(r, 4), r) }
    else if ty == KU32 { ins2(x, "movl", sized(r, 4), sized(r, 4)) }
}

bool fits32(int v) { return v >= 0 - 2147483648 && v <= 2147483647 }

// ---- data -----------------------------------------------------------------------------------

string float_const(X64* x, int ty, string text) {
    string name = ".LCf" + int_to_str(x.floats)
    x.floats += 1
    if ty == KF64 { x.data.push(".p2align 3"); x.data.push(name + ":"); x.data.push(".double " + text) }
    else { x.data.push(".p2align 2"); x.data.push(name + ":"); x.data.push(".float " + text) }
    return name
}

// Strata string-literal text (as written) -> GNU as .ascii text: the same escapes, except
// `\0` must be octal and `\'` needs no escape.
string as_text(string s) {
    string[dynamic] p = []
    int i = 0
    int n = s.len
    while i < n {
        if s[i] == '\\' && i + 1 < n {
            if s[i + 1] == '0' { p.push("\\000") }
            else if s[i + 1] == '\'' { p.push("'") }
            else { p.push(substr(s, i, 2)) }
            i += 2
        } else {
            p.push(substr(s, i, 1))
            i += 1
        }
    }
    return strata_join(&p)
}

// ---- instructions ------------------------------------------------------------------------------

string lbl(X64* x, int n) { return ".L" + int_to_str(x.fnum) + "_" + int_to_str(n) }

Opnd int_reg_arg(int i) {
    if i == 0 { return rcx() }
    if i == 1 { return rdx() }
    if i == 2 { return r8() }
    return hw(9, 8)                      // r9
}

string cc_of(int cond, bool is_unsigned) {
    if cond == CEq { return "e" }
    if cond == CNe { return "ne" }
    if is_unsigned {
        if cond == CLt { return "b" }
        if cond == CLe { return "be" }
        if cond == CGt { return "a" }
        return "ae"
    }
    if cond == CLt { return "l" }
    if cond == CLe { return "le" }
    if cond == CGt { return "g" }
    return "ge"
}

int invert(int cond) {
    if cond == CEq { return CNe }
    if cond == CNe { return CEq }
    if cond == CLt { return CGe }
    if cond == CLe { return CGt }
    if cond == CGt { return CLe }
    return CLt
}

// memory copy / zero of `size` bytes: unrolled when small, a loop when large
void copy_bytes(X64* x, int size, bool zero) {
    // rax = destination, rcx = source (unless zero); rdx is the data
    int off = 0
    if zero { ins2(x, "xorl", sized(rdx(), 4), sized(rdx(), 4)) }
    if size > 128 {
        int words = size / 8
        string l = ".Lm" + int_to_str(x.fnum) + "_" + int_to_str(x.loops)
        x.loops += 1
        ins2(x, "movq", imm(words), r8())
        label(x, l)
        if !zero { ins2(x, "movq", mem(1, 0), rdx()); ins2(x, "addq", imm(8), rcx()) }
        ins2(x, "movq", rdx(), mem(0, 0))
        ins2(x, "addq", imm(8), rax())
        ins1(x, "decq", r8())
        ins1(x, "jnz", target(l))
        size = size - words * 8
    }
    while off + 8 <= size {
        if !zero { ins2(x, "movq", mem(1, off), rdx()) }
        ins2(x, "movq", rdx(), mem(0, off))
        off += 8
    }
    if off + 4 <= size {
        if !zero { ins2(x, "movl", mem(1, off), sized(rdx(), 4)) }
        ins2(x, "movl", sized(rdx(), 4), mem(0, off))
        off += 4
    }
    if off + 2 <= size {
        if !zero { ins2(x, "movw", mem(1, off), sized(rdx(), 2)) }
        ins2(x, "movw", sized(rdx(), 2), mem(0, off))
        off += 2
    }
    if off < size {
        if !zero { ins2(x, "movb", mem(1, off), sized(rdx(), 1)) }
        ins2(x, "movb", sized(rdx(), 1), mem(0, off))
    }
}

string load_insn(int ty) {
    if ty == KI8 { return "movsbq" }
    if ty == KU8 { return "movzbq" }
    if ty == KI16 { return "movswq" }
    if ty == KU16 { return "movzwq" }
    if ty == KI32 { return "movslq" }
    return "movq"
}

// Jump to `t` if the flags say `cc`, else to `e` - leaving out a jump to the next label.
void branch_cc(X64* x, string cc, string ncc, int t, int e, int next) {
    if e == next { ins1(x, "j" + cc, target(lbl(x, t))) }
    else if t == next && ncc != "" { ins1(x, "j" + ncc, target(lbl(x, e))) }
    else { ins1(x, "j" + cc, target(lbl(x, t))); ins1(x, "jmp", target(lbl(x, e))) }
}

// Compare a and b (comparison i), then jump to t if it holds, else to e.
void cmp_branch(X64* x, Ins i, int t, int e, int next) {
    int ty = i.ty
    int c = i.ty2
    if ir_is_float(ty) {
        string s = fsuf(ty)
        if c == CLt || c == CLe {          // a < b  <=>  b > a  (false if either is NaN)
            fget(x, ty, i.b, xmm(0))
            fget(x, ty, i.a, xmm(1))
        } else {
            fget(x, ty, i.a, xmm(0))
            fget(x, ty, i.b, xmm(1))
        }
        ins2(x, "ucomi" + s, xmm(1), xmm(0))
        if c == CGt || c == CLt { branch_cc(x, "a", "", t, e, next) }
        else if c == CGe || c == CLe { branch_cc(x, "ae", "", t, e, next) }
        else if c == CEq { ins1(x, "jp", target(lbl(x, e))); branch_cc(x, "e", "ne", t, e, next) }
        else { ins1(x, "jp", target(lbl(x, t))); branch_cc(x, "ne", "e", t, e, next) }
        return
    }
    Opnd a = rax()
    if in_reg(x, i.a) && x.lazy[i.a] == 0 { a = opnd(x, i.a) } else { get(x, i.a, rax()) }
    Opnd b = src(x, i.b)
    ins2(x, "cmpq", b, a)
    bool u = ir_is_unsigned(ty)
    branch_cc(x, cc_of(c, u), cc_of(invert(c), u), t, e, next)
}

void emit_ins(X64* x, IrFunc* f, int k, string epilogue) {
    Ins i = f.code[k]
    int t = i.ty
    int next = 0 - 1   // the label right after this instruction, if any
    if k + 1 < f.code.len && f.code[k + 1].op == OLabel { next = f.code[k + 1].imm }
    if i.dst >= 0 && x.lazy[i.dst] != 0 { return }   // lazy: used where it's needed
    switch i.op {
        case OConst:
            {
                int v = ir_norm_imm(t, i.imm)
                if fits32(v) {
                    if in_reg(x, i.dst) && v == 0 { Opnd r = opnd(x, i.dst); ins2(x, "xorl", sized(r, 4), sized(r, 4)) }
                    else { ins2(x, "movq", imm(v), opnd(x, i.dst)) }
                } else {
                    ins2(x, "movabsq", imm(v), rax())
                    put(x, rax(), i.dst)
                }
            }
        case OFConst:
            {
                string c = float_const(x, t, i.sym)
                if in_reg(x, i.dst) { ins2(x, "mov" + fsuf(t), rip(c, 0), opnd(x, i.dst)) }
                else { ins2(x, "mov" + fsuf(t), rip(c, 0), xmm(0)); fput(x, t, xmm(0), i.dst) }
            }
        case OCopy:
            if ir_is_float(t) { fget(x, t, i.a, xmm(0)); fput(x, t, xmm(0), i.dst) }
            else if in_reg(x, i.dst) { get(x, i.a, opnd(x, i.dst)) }
            else if x.lazy[i.a] == 1 { ins2(x, "movq", src(x, i.a), opnd(x, i.dst)) }
            else { get(x, i.a, rax()); put(x, rax(), i.dst) }
        case OAdd, OSub, OMul, OAnd, OOr, OXor:
            if ir_is_float(t) {
                string fop = "add"
                if i.op == OSub { fop = "sub" } else if i.op == OMul { fop = "mul" }
                float_op(x, i, fop)
            } else {
                string op = "addq"
                if i.op == OSub { op = "subq" } else if i.op == OMul { op = "imulq" }
                else if i.op == OAnd { op = "andq" } else if i.op == OOr { op = "orq" } else if i.op == OXor { op = "xorq" }
                Opnd w = work(x, i)
                get(x, i.a, w)
                Opnd b = src(x, i.b)
                ins2(x, op, b, w)
                norm(x, t, w)
                put(x, w, i.dst)
            }
        case ODiv, OMod:
            if ir_is_float(t) {
                float_op(x, i, "div")
            } else {
                get(x, i.a, rax())
                get(x, i.b, rcx())
                if ir_is_unsigned(t) { ins2(x, "xorl", sized(rdx(), 4), sized(rdx(), 4)); ins1(x, "divq", rcx()) }
                else { ins0(x, "cqto"); ins1(x, "idivq", rcx()) }
                Opnd r = rax()
                if i.op == OMod { r = rdx() }
                norm(x, t, r)
                put(x, r, i.dst)
            }
        case OShl, OShr:
            {
                Opnd w = work(x, i)
                get(x, i.a, w)
                string op = "shlq"
                if i.op == OShr { if ir_is_unsigned(t) { op = "shrq" } else { op = "sarq" } }
                if x.lazy[i.b] == 1 { ins2(x, op, src(x, i.b), w) }
                else { get(x, i.b, rcx()); ins2(x, op, sized(rcx(), 1), w) }
                norm(x, t, w)
                put(x, w, i.dst)
            }
        case ONeg:
            if t == KF32 {
                fget(x, t, i.a, xmm(0))
                ins2(x, "movd", xmm(0), sized(rax(), 4))
                ins2(x, "xorl", imm(2147483648), sized(rax(), 4))   // flip the sign bit
                ins2(x, "movd", sized(rax(), 4), xmm(0))
                fput(x, t, xmm(0), i.dst)
            } else if t == KF64 {
                fget(x, t, i.a, xmm(0))
                ins2(x, "movq", xmm(0), rax())
                ins2(x, "btcq", imm(63), rax())
                ins2(x, "movq", rax(), xmm(0))
                fput(x, t, xmm(0), i.dst)
            } else { Opnd w = work(x, i); get(x, i.a, w); ins1(x, "negq", w); norm(x, t, w); put(x, w, i.dst) }
        case ONot:
            {
                Opnd w = work(x, i)
                get(x, i.a, w)
                ins1(x, "notq", w)
                norm(x, t, w)
                put(x, w, i.dst)
            }
        case OSqrt:
            fget(x, t, i.a, xmm(1))
            ins2(x, "sqrt" + fsuf(t), xmm(1), xmm(0))
            fput(x, t, xmm(0), i.dst)
        case OCmp:
            {
                // the branch right after, if it is this result's only use: compare + jump
                if k + 1 < f.code.len && f.code[k + 1].op == OBr && f.code[k + 1].a == i.dst && x.nuse[i.dst] == 1 {
                    int nx = 0 - 1
                    if k + 2 < f.code.len && f.code[k + 2].op == OLabel { nx = f.code[k + 2].imm }
                    cmp_branch(x, i, f.code[k + 1].imm, f.code[k + 1].imm2, nx)
                } else {
                    emit_cmp(x, i)
                }
            }
        case OConv: emit_conv(x, i)
        case OLoad:
            if ir_is_float(t) {
                Opnd m = mem_at(x, i.a, i.imm)
                if in_reg(x, i.dst) { ins2(x, "mov" + fsuf(t), m, opnd(x, i.dst)) }
                else { ins2(x, "mov" + fsuf(t), m, xmm(0)); fput(x, t, xmm(0), i.dst) }
            } else {
                Opnd m = mem_at(x, i.a, i.imm)
                Opnd w = rax()
                if in_reg(x, i.dst) { w = opnd(x, i.dst) }
                if t == KU32 { ins2(x, "movl", m, sized(w, 4)) }
                else { ins2(x, load_insn(t), m, w) }
                put(x, w, i.dst)
            }
        case OStore:
            {
                Opnd m = mem_at(x, i.a, i.imm)
                if ir_is_float(t) {
                    if in_reg(x, i.b) { ins2(x, "mov" + fsuf(t), opnd(x, i.b), m) }
                    else { fget(x, t, i.b, xmm(0)); ins2(x, "mov" + fsuf(t), xmm(0), m) }
                } else {
                    int sz = ir_size(t)
                    string mv = "movq"
                    if sz == 1 { mv = "movb" } else if sz == 2 { mv = "movw" } else if sz == 4 { mv = "movl" }
                    if x.lazy[i.b] == 1 { ins2(x, mv, src(x, i.b), m) }
                    else if in_reg(x, i.b) && x.lazy[i.b] == 0 { ins2(x, mv, sized(opnd(x, i.b), sz), m) }
                    else { get(x, i.b, rcx()); ins2(x, mv, sized(rcx(), sz), m) }
                }
            }
        case OSlotAddr:
            ins2(x, "leaq", slot_mem(x, i.imm, 0), rax())
            put(x, rax(), i.dst)
        case OSymAddr:
            ins2(x, "leaq", rip(i.sym, 0), rax())
            put(x, rax(), i.dst)
        case OCopyMem:
            get(x, i.a, rax())
            get(x, i.b, rcx())
            copy_bytes(x, i.imm, false)
        case OZeroMem:
            get(x, i.a, rax())
            copy_bytes(x, i.imm, true)
        case OParam: emit_param(x, i)
        case OCall: emit_call(x, f, i)
        case ORet:
            if i.a >= 0 {
                int rt = f.ret_ty
                if ir_is_float(rt) { fget(x, rt, i.a, xmm(0)) } else { get(x, i.a, rax()) }
            }
            if k + 1 < f.code.len { ins1(x, "jmp", target(epilogue)) }
        case OLabel: label(x, lbl(x, i.imm))
        case OJmp: if i.imm != next { ins1(x, "jmp", target(lbl(x, i.imm))) }
        case OBr:
            if x.lazy[i.a] == 1 {
                if x.lval[i.a] != 0 { ins1(x, "jmp", target(lbl(x, i.imm))) } else { ins1(x, "jmp", target(lbl(x, i.imm2))) }
            } else {
                ins2(x, "cmpq", imm(0), opnd(x, i.a))
                branch_cc(x, "ne", "e", i.imm, i.imm2, next)
            }
        case ONop: {}
    }
}

// dst = a op b for floats, computed in dst's own register when it can be
void float_op(X64* x, Ins i, string fop) {
    int t = i.ty
    Opnd w = xmm(0)
    if in_reg(x, i.dst) && !(in_reg(x, i.b) && reg_of(x, i.b) == reg_of(x, i.dst)) { w = opnd(x, i.dst) }
    fget(x, t, i.a, w)
    ins2(x, fop + fsuf(t), opnd(x, i.b), w)
    fput(x, t, w, i.dst)
}

void emit_cmp(X64* x, Ins i) {
    int t = i.ty
    Opnd al = sized(rax(), 1)
    Opnd cl = sized(rcx(), 1)
    if ir_is_float(t) {
        string s = fsuf(t)
        int c = i.ty2
        if c == CLt || c == CLe {          // a < b  <=>  b > a  (false if either is NaN)
            fget(x, t, i.b, xmm(0))
            fget(x, t, i.a, xmm(1))
            ins2(x, "ucomi" + s, xmm(1), xmm(0))
            if c == CLt { ins1(x, "seta", al) } else { ins1(x, "setae", al) }
        } else {
            fget(x, t, i.a, xmm(0))
            fget(x, t, i.b, xmm(1))
            ins2(x, "ucomi" + s, xmm(1), xmm(0))
            if c == CGt { ins1(x, "seta", al) }
            else if c == CGe { ins1(x, "setae", al) }
            else if c == CEq { ins1(x, "sete", al); ins1(x, "setnp", cl); ins2(x, "andb", cl, al) }
            else { ins1(x, "setne", al); ins1(x, "setp", cl); ins2(x, "orb", cl, al) }
        }
    } else {
        Opnd a = rax()
        if in_reg(x, i.a) && x.lazy[i.a] == 0 { a = opnd(x, i.a) } else { get(x, i.a, rax()) }
        Opnd b = src(x, i.b)
        ins2(x, "cmpq", b, a)
        ins1(x, "set" + cc_of(i.ty2, ir_is_unsigned(t)), al)
    }
    ins2(x, "movzbl", al, sized(rax(), 4))
    put(x, rax(), i.dst)
}

void emit_conv(X64* x, Ins i) {
    int to = i.ty
    int from = i.ty2
    if ir_is_float(from) && ir_is_float(to) {
        fget(x, from, i.a, xmm(1))
        ins2(x, "cvt" + fsuf(from) + "2" + fsuf(to), xmm(1), xmm(0))
        fput(x, to, xmm(0), i.dst)
    } else if ir_is_float(to) {
        get(x, i.a, rax())
        ins2(x, "cvtsi2" + fsuf(to) + "q", rax(), xmm(0))
        fput(x, to, xmm(0), i.dst)
    } else if ir_is_float(from) {
        fget(x, from, i.a, xmm(0))
        ins2(x, "cvtt" + fsuf(from) + "2siq", xmm(0), rax())
        norm(x, to, rax())
        put(x, rax(), i.dst)
    } else {
        Opnd w = rax()
        if in_reg(x, i.dst) { w = opnd(x, i.dst) }
        get(x, i.a, w)
        norm(x, to, w)
        put(x, w, i.dst)
    }
}

void emit_param(X64* x, Ins i) {
    int t = i.ty
    int k = i.imm
    if k < 4 {
        if ir_is_float(t) { fput(x, t, xmm(k), i.dst) }
        else {
            Opnd r = int_reg_arg(k)
            norm(x, t, r)
            put(x, r, i.dst)
        }
    } else {
        Opnd m = mem(5, 16 + 8 * k)
        if ir_is_float(t) { ins2(x, "mov" + fsuf(t), m, xmm(0)); fput(x, t, xmm(0), i.dst) }
        else { ins2(x, "movq", m, rax()); norm(x, t, rax()); put(x, rax(), i.dst) }
    }
}

void emit_call(X64* x, IrFunc* f, Ins i) {
    int n = i.args.len
    // arguments 5+ go on the stack, above the shadow space
    for k in 4..n {
        int a = i.args[k]
        int at = f.vtypes[a]
        if ir_is_float(at) { fget(x, at, a, xmm(0)); ins2(x, "mov" + fsuf(at), xmm(0), mem(4, 8 * k)) }
        else if x.lazy[a] == 1 { ins2(x, "movq", src(x, a), mem(4, 8 * k)) }
        else { get(x, a, rax()); ins2(x, "movq", rax(), mem(4, 8 * k)) }
    }
    for k in 0..n {
        if k < 4 {
            int a = i.args[k]
            int at = f.vtypes[a]
            if ir_is_float(at) { fget(x, at, a, xmm(k)) }
            else { get(x, a, int_reg_arg(k)) }
        }
    }
    ins1(x, "call", target(i.sym))
    if i.dst >= 0 {
        if ir_is_float(i.ty) { fput(x, i.ty, xmm(0), i.dst) }
        else { norm(x, i.ty, rax()); put(x, rax(), i.dst) }
    }
}

// ---- functions ---------------------------------------------------------------------------------

// Which vregs need no home (see the top): single-definition constants that fit in 32 bits,
// slot and data addresses.
void find_lazy(X64* x, IrFunc* f) {
    int nv = f.vtypes.len
    int[dynamic] ndef = []
    int[dynamic] nuse = []
    int[dynamic] lz = []
    int[dynamic] lv = []
    string[dynamic] ls = []
    for v in 0..nv { ndef.push(0); nuse.push(0); lz.push(0); lv.push(0); ls.push("") }
    for k in 0..f.code.len {
        Ins i = f.code[k]
        if i.op != ONop {
            if i.dst >= 0 { ndef[i.dst] = ndef[i.dst] + 1 }
            if i.a >= 0 { nuse[i.a] = nuse[i.a] + 1 }
            if i.b >= 0 { nuse[i.b] = nuse[i.b] + 1 }
            for j in 0..i.args.len { nuse[i.args[j]] = nuse[i.args[j]] + 1 }
        }
    }
    for k in 0..f.code.len {
        Ins i = f.code[k]
        if i.dst >= 0 && ndef[i.dst] == 1 {
            if i.op == OConst && fits32(ir_norm_imm(i.ty, i.imm)) { lz[i.dst] = 1; lv[i.dst] = ir_norm_imm(i.ty, i.imm) }
            else if i.op == OSlotAddr { lz[i.dst] = 2; lv[i.dst] = i.imm }
            else if i.op == OSymAddr { lz[i.dst] = 3; ls[i.dst] = i.sym }
        }
    }
    x.lazy = lz
    x.lval = lv
    x.lsym = ls
    x.nuse = nuse
}

// Per vreg: 1 if it needs no home (see find_lazy) - for the register allocator.
export int[dynamic] x64_lazy(IrFunc* f) {
    X64 x = new_x64(false, 1)
    find_lazy(&x, f)
    int[dynamic] r = []
    for v in 0..x.lazy.len { if x.lazy[v] != 0 { r.push(1) } else { r.push(0) } }
    return r
}

// `regs`: per vreg, the register the allocator chose (-1: memory). Empty: all in memory.
export void x64_function(X64* x, IrFunc* f, int[dynamic] regs) {
    int nv = f.vtypes.len
    find_lazy(x, f)
    // callee-saved registers used
    int[dynamic] used = []
    for k in 0..x64_saved_regs() { used.push(0) }
    int nregs = regs.len
    if nregs > nv { nregs = nv }                 // (after them: shared spill slots, below)
    for v in 0..nregs { if regs[v] >= 0 && regs[v] < x64_saved_regs() && x.lazy[v] == 0 { used[regs[v]] = 1 } }
    int[dynamic] saved = []
    for k in 0..used.len { if used[k] == 1 { saved.push(k) } }
    x.saved = saved

    // the frame: save area, vregs in memory, slots
    int nint = 0
    int nflt = 0
    for k in 0..saved.len { if saved[k] < x64_int_regs() { nint += 1 } else { nflt += 1 } }
    int cur = 8 * nint                   // the integer pushes sit right below rbp
    cur = align_to(cur + 16 * nflt, 16)
    x.save_base = 0 - cur
    int[dynamic] loc = []
    int[dynamic] isreg = []
    // vregs in memory: the allocator's shared spill slots (8 bytes each), if it gave them;
    // else one each
    bool shared = regs.len >= 2 * nv
    int spill_base = cur
    if shared {
        int top = 0 - 1
        for v in 0..nv { if regs[nv + v] > top { top = regs[nv + v] } }
        cur += 8 * (top + 1)
    }
    for v in 0..nv {
        if x.lazy[v] != 0 { loc.push(0); isreg.push(0) }
        else if v < nregs && regs[v] >= 0 { loc.push(regs[v]); isreg.push(1) }
        else if shared && regs[nv + v] >= 0 { loc.push(0 - (spill_base + 8 * (regs[nv + v] + 1))); isreg.push(0) }
        else if shared { loc.push(0); isreg.push(0) }     // never referenced (optimized away): no slot
        else { cur += 8; loc.push(0 - cur); isreg.push(0) }
    }
    x.loc = loc
    x.isreg = isreg
    int[dynamic] so = []
    for s in 0..f.slots.len {
        int al = f.slots[s].align
        if al > 16 { al = 16 }
        cur = align_to(cur + f.slots[s].size, al)
        so.push(0 - cur)
    }
    x.slot_off = so
    int outgoing = 32
    for k in 0..f.code.len {
        if f.code[k].op == OCall && 8 * f.code[k].args.len > outgoing { outgoing = 8 * f.code[k].args.len }
    }
    // everything below rbp (pushes + frame) is a multiple of 16: rsp stays aligned
    int frame = align_to(cur + outgoing, 16) - 8 * nint

    dline(x, ".p2align 4")
    if f.global { dline(x, ".globl " + f.name) }
    label(x, f.name)
    ins1(x, "pushq", rbp())
    ins2(x, "movq", rsp(), rbp())
    for k in 0..saved.len { if saved[k] < x64_int_regs() { ins1(x, "pushq", alloc_reg(saved[k])) } }
    // touch each page of a big frame in order (Windows grows the stack one guard page at a time)
    int left = frame
    while left > 4096 {
        ins2(x, "subq", imm(4096), rsp())
        ins2(x, "orq", imm(0), mem(4, 0))
        left = left - 4096
    }
    if left > 0 { ins2(x, "subq", imm(left), rsp()) }
    int fs = 0
    for k in 0..saved.len {
        if saved[k] >= x64_int_regs() {
            ins2(x, "movups", alloc_reg(saved[k]), mem(5, x.save_base + 16 * fs))
            fs += 1
        }
    }

    string epilogue = ".Lret" + int_to_str(x.fnum)
    int k = 0
    while k < f.code.len {
        emit_ins(x, f, k, epilogue)
        // a compare fused with its branch consumed the branch too
        if f.code[k].op == OCmp && k + 1 < f.code.len && f.code[k + 1].op == OBr && f.code[k + 1].a == f.code[k].dst && x.nuse[f.code[k].dst] == 1 && x.lazy[f.code[k].dst] == 0 { k += 1 }
        k += 1
    }

    label(x, epilogue)
    fs = 0
    for k2 in 0..saved.len {
        if saved[k2] >= x64_int_regs() {
            ins2(x, "movups", mem(5, x.save_base + 16 * fs), alloc_reg(saved[k2]))
            fs += 1
        }
    }
    if nint > 0 {
        ins2(x, "leaq", mem(5, 0 - 8 * nint), rsp())
        int r = saved.len - 1
        while r >= 0 {
            if saved[r] < x64_int_regs() { ins1(x, "popq", alloc_reg(saved[r])) }
            r -= 1
        }
        ins1(x, "popq", rbp())
    } else {
        ins0(x, "leave")
    }
    ins0(x, "ret")
    x.fnum += 1
}

export void x64_begin(X64* x) {
    if !x.direct { x.out.push("# Generated by stratac (x86-64, Windows). Do not edit.\n") }
    dline(x, ".text")
}

// GNU as directives for a global's bytes
void x64_global(X64* x, IrGlobal g) {
    int p = 0
    int a = 1
    while a < g.align { a = a * 2; p += 1 }
    dline(x, ".p2align " + int_to_str(p))
    if g.global { dline(x, ".globl " + g.sym) }
    label(x, g.sym)
    if g.kind == 1 {
        string d = ".quad "
        if g.size == 4 { d = ".long " } else if g.size == 2 { d = ".short " } else if g.size == 1 { d = ".byte " }
        dline(x, d + int_to_str(g.ival))
    } else if g.kind == 2 {
        if g.ty == KF64 { dline(x, ".double " + g.text) } else { dline(x, ".float " + g.text) }
    } else if g.kind == 3 {
        dline(x, ".quad " + g.text)
    } else if g.kind == 4 {
        dline(x, ".zero 24")
        dline(x, ".quad " + int_to_str(g.ival))
    } else {
        dline(x, ".zero " + int_to_str(g.size))
    }
}

// the data after every function went through x64_function: globals, strings, constants
void x64_data(X64* x, IrProgram* prog) {
    if prog.globals.len > 0 {
        dline(x, ".data")
        for k in 0..prog.globals.len { x64_global(x, prog.globals[k]) }
    }
    if prog.strings.len > 0 || x.data.len > 0 {
        dline(x, ".section .rdata,\"dr\"")
        for k in 0..prog.strings.len {
            label(x, prog.strings[k].sym)
            dline(x, ".asciz \"" + as_text(prog.strings[k].text) + "\"")
        }
        for k in 0..x.data.len {
            string d = x.data[k]
            if d[d.len - 1] == ':' { label(x, substr(d, 0, d.len - 1)) } else { dline(x, d) }
        }
    }
}

// The whole program as assembly text (an X64 made with direct = false).
export string x64_finish(X64* x, IrProgram* prog) {
    x64_data(x, prog)
    return strata_join(&x.out)
}

// The whole program as machine code (an X64 made with direct = true).
export ObjFile x64_finish_object(X64* x, IrProgram* prog) {
    x64_data(x, prog)
    return asm_finish(&x.as)
}

// ======== the encoder (for asm.strata) ========================================================

// ---- operands -----------------------------------------------------------------------------

// kind: 1 register, 2 immediate, 3 memory, 4 a bare symbol (a jump / call target)
export struct Opnd {
    int    kind
    int    reg       // register number 0-15
    int    size      // register size in bytes (16 for xmm)
    int    imm       // immediate / displacement
    int    base      // memory: base register (-1: %rip)
    string sym       // memory / bare: symbol name ("" if none)
}

Opnd no_opnd() { return Opnd{ 0, 0, 0, 0, 0, "" } }

// ---- registers --------------------------------------------------------------------------------

// a legacy register name -> size * 16 + number (-1: not one)
int legacy_reg(string s) {
    if s == "rax" { return 128 } if s == "rcx" { return 129 } if s == "rdx" { return 130 } if s == "rbx" { return 131 }
    if s == "rsp" { return 132 } if s == "rbp" { return 133 } if s == "rsi" { return 134 } if s == "rdi" { return 135 }
    if s == "eax" { return 64 } if s == "ecx" { return 65 } if s == "edx" { return 66 } if s == "ebx" { return 67 }
    if s == "esp" { return 68 } if s == "ebp" { return 69 } if s == "esi" { return 70 } if s == "edi" { return 71 }
    if s == "ax" { return 32 } if s == "cx" { return 33 } if s == "dx" { return 34 } if s == "bx" { return 35 }
    if s == "sp" { return 36 } if s == "bp" { return 37 } if s == "si" { return 38 } if s == "di" { return 39 }
    if s == "al" { return 16 } if s == "cl" { return 17 } if s == "dl" { return 18 } if s == "bl" { return 19 }
    if s == "spl" { return 20 } if s == "bpl" { return 21 } if s == "sil" { return 22 } if s == "dil" { return 23 }
    return 0 - 1
}

// "rax" -> register 0, size 8; "r12d" -> 12, size 4; "xmm3" -> 3, size 16. False if unknown.
bool parse_reg(string name, Opnd* o) {
    int n = name.len
    if n > 3 && substr(name, 0, 3) == "xmm" {
        int v = 0
        for i in 3..n { v = v * 10 + (cast<int>(name[i]) - cast<int>('0')) }
        o.kind = 1
        o.reg = v
        o.size = 16
        return v >= 0 && v < 16
    }
    if n >= 2 && name[0] == 'r' && asm_digit(name[1]) {
        int k = 1
        int v = 0
        while k < n && asm_digit(name[k]) { v = v * 10 + (cast<int>(name[k]) - cast<int>('0')); k += 1 }
        string suf = substr(name, k, n - k)
        int size = 0
        if suf == "" { size = 8 } else if suf == "d" { size = 4 } else if suf == "w" { size = 2 } else if suf == "b" { size = 1 }
        o.kind = 1
        o.reg = v
        o.size = size
        return size > 0 && v >= 8 && v <= 15
    }
    int c = legacy_reg(name)
    if c < 0 { return false }
    o.kind = 1
    o.reg = c % 16
    o.size = c / 16
    return true
}

// ---- parsing ------------------------------------------------------------------------------------

Opnd parse_opnd(Asm* a, string s) {
    Opnd o = no_opnd()
    if s.len == 0 { asm_fail(a, "missing operand"); return o }
    if s[0] == '%' {
        if !parse_reg(substr(s, 1, s.len - 1), &o) { asm_fail(a, "unknown register " + s) }
        return o
    }
    if s[0] == '$' {
        o.kind = 2
        o.imm = asm_num(a, substr(s, 1, s.len - 1))
        return o
    }
    int p = 0 - 1
    for i in 0..s.len { if p < 0 && s[i] == '(' { p = i } }
    if p < 0 {
        o.kind = 4
        o.sym = s
        return o
    }
    // memory: [disp | sym[+-off]](%base)
    o.kind = 3
    if s[s.len - 1] != ')' { asm_fail(a, "bad memory operand " + s); return o }
    string inner = substr(s, p + 1, s.len - p - 2)
    if inner == "%rip" { o.base = 0 - 1 }
    else {
        Opnd r = no_opnd()
        if inner.len < 2 || !parse_reg(substr(inner, 1, inner.len - 1), &r) || r.size != 8 { asm_fail(a, "bad base register " + inner); return o }
        o.base = r.reg
    }
    string d = substr(s, 0, p)
    if d.len > 0 {
        if asm_digit(d[0]) || d[0] == '-' || d[0] == '+' { o.imm = asm_num(a, d) }
        else {
            // sym, sym+off, sym-off
            int q = 0 - 1
            for i in 1..d.len { if q < 0 && (d[i] == '+' || d[i] == '-') { q = i } }
            if q < 0 { o.sym = d }
            else { o.sym = substr(d, 0, q); o.imm = asm_num(a, substr(d, q, d.len - q)) }
        }
    }
    return o
}

// ---- encoding -------------------------------------------------------------------------------------

bool fits8(int v) { return v >= 0 - 128 && v <= 127 }
bool fits32s(int v) { return v >= 0 - 2147483648 && v <= 2147483647 }

// A register needs REX to be its 8-bit self (spl, bpl, sil, dil - else they'd be ah..bh)
bool byte_needs_rex(Opnd o) { return o.kind == 1 && o.size == 1 && o.reg >= 4 && o.reg < 8 }

// One instruction with a ModRM byte:
//   [legacy prefix] [REX] opcode... ModRM [SIB] [disp] [immediate]
// `prefix`: 0, or 0x66 / 0xF2 / 0xF3 (it must precede REX); `op1`..`op3`: the opcode
// bytes (-1: none); `regf`: the ModRM reg field (a register number or an opcode digit);
// `regb`: whether regf is an 8-bit register; `rm`: the register or memory operand;
// `isz` / `imm`: the immediate's size in bytes (0: none) and value.
void enc(Asm* a, int prefix, bool w, int op1, int op2, int op3, int regf, bool regb, Opnd rm, int isz, int imm) {
    if prefix != 0 { asm_byte(a, prefix) }
    int rex = 0
    if w { rex = rex | 8 }
    if regf >= 8 { rex = rex | 4 }
    if rm.kind == 1 && rm.reg >= 8 { rex = rex | 1 }
    if rm.kind == 3 && rm.base >= 8 { rex = rex | 1 }
    bool need = rex != 0 || byte_needs_rex(rm) || (regb && regf >= 4 && regf < 8)
    if need { asm_byte(a, 64 | rex) }
    asm_byte(a, op1)
    if op2 >= 0 { asm_byte(a, op2) }
    if op3 >= 0 { asm_byte(a, op3) }
    int r = (regf & 7) * 8
    if rm.kind == 1 {
        asm_byte(a, 192 | r | (rm.reg & 7))
    } else if rm.kind == 3 && rm.base < 0 {
        // RIP-relative: disp32, against a symbol (a fixup) or plain
        asm_byte(a, 5 | r)
        if rm.sym != "" {
            asm_fix(a, rm.sym, rm.imm, isz)
            asm_bytes(a, 0, 4)
        } else {
            asm_bytes(a, rm.imm, 4)
        }
    } else if rm.kind == 3 {
        if rm.sym != "" { asm_fail(a, "a symbol needs %rip") }
        int b7 = rm.base & 7
        int d = rm.imm
        int mode = 2
        if d == 0 && b7 != 5 { mode = 0 } else if fits8(d) { mode = 1 }
        int low = b7
        if b7 == 4 { low = 4 }
        asm_byte(a, mode * 64 | r | low)
        if b7 == 4 { asm_byte(a, 36) }   // SIB: no index, base rsp / r12
        if mode == 1 { asm_byte(a, d) } else if mode == 2 { asm_bytes(a, d, 4) }
    } else {
        asm_fail(a, "expected a register or memory operand")
    }
    if isz > 0 { asm_bytes(a, imm, isz) }
}

// a rel32 to `label`, after the opcode bytes already emitted
void rel32(Asm* a, string label) {
    asm_fix(a, label, 0, 0)
    asm_bytes(a, 0, 4)
}

// ---- instructions ------------------------------------------------------------------------------------

int cc_code(string c) {
    if c == "o" { return 0 }
    if c == "no" { return 1 }
    if c == "b" || c == "c" || c == "nae" { return 2 }
    if c == "ae" || c == "nb" || c == "nc" { return 3 }
    if c == "e" || c == "z" { return 4 }
    if c == "ne" || c == "nz" { return 5 }
    if c == "be" || c == "na" { return 6 }
    if c == "a" || c == "nbe" { return 7 }
    if c == "s" { return 8 }
    if c == "ns" { return 9 }
    if c == "p" || c == "pe" { return 10 }
    if c == "np" || c == "po" { return 11 }
    if c == "l" || c == "nge" { return 12 }
    if c == "ge" || c == "nl" { return 13 }
    if c == "le" || c == "ng" { return 14 }
    if c == "g" || c == "nle" { return 15 }
    return 0 - 1
}

int size_of(char c) {
    if c == 'q' { return 8 }
    if c == 'l' { return 4 }
    if c == 'w' { return 2 }
    if c == 'b' { return 1 }
    return 0
}

// add/or/and/sub/xor/cmp (opcode digit d) of `size` bytes: src -> dst
void alu(Asm* a, int d, int size, Opnd src, Opnd dst) {
    bool w = size == 8
    int pre = 0
    if size == 2 { pre = 102 }
    if src.kind == 2 {
        if size == 1 { enc(a, pre, false, 128, 0 - 1, 0 - 1, d, false, dst, 1, src.imm) }
        else if fits8(src.imm) { enc(a, pre, w, 131, 0 - 1, 0 - 1, d, false, dst, 1, src.imm) }
        else {
            int isz = 4
            if size == 2 { isz = 2 }
            if size == 8 && !fits32s(src.imm) { asm_fail(a, "immediate too large") }
            enc(a, pre, w, 129, 0 - 1, 0 - 1, d, false, dst, isz, src.imm)
        }
    } else if src.kind == 1 {
        int op = d * 8 + 1
        if size == 1 { op = d * 8 }
        enc(a, pre, w, op, 0 - 1, 0 - 1, src.reg, size == 1, dst, 0, 0)
    } else if src.kind == 3 && dst.kind == 1 {
        int op = d * 8 + 3
        if size == 1 { op = d * 8 + 2 }
        enc(a, pre, w, op, 0 - 1, 0 - 1, dst.reg, size == 1, src, 0, 0)
    } else {
        asm_fail(a, "unsupported operands")
    }
}

// mov of `size` bytes (integer registers / memory / immediates)
void mov(Asm* a, int size, Opnd src, Opnd dst) {
    bool w = size == 8
    int pre = 0
    if size == 2 { pre = 102 }
    // movq between an xmm register and a general one
    if size == 8 && src.kind == 1 && src.size == 16 { enc(a, 102, true, 15, 126, 0 - 1, src.reg, false, dst, 0, 0); return }
    if size == 8 && dst.kind == 1 && dst.size == 16 { enc(a, 102, true, 15, 110, 0 - 1, dst.reg, false, src, 0, 0); return }
    if src.kind == 2 {
        int isz = 4
        if size == 2 { isz = 2 } else if size == 1 { isz = 1 }
        if size == 8 && !fits32s(src.imm) { asm_fail(a, "immediate too large (movabsq)") }
        int op = 199
        if size == 1 { op = 198 }
        enc(a, pre, w, op, 0 - 1, 0 - 1, 0, false, dst, isz, src.imm)
    } else if src.kind == 1 {
        int op = 137
        if size == 1 { op = 136 }
        enc(a, pre, w, op, 0 - 1, 0 - 1, src.reg, size == 1, dst, 0, 0)
    } else if src.kind == 3 && dst.kind == 1 {
        int op = 139
        if size == 1 { op = 138 }
        enc(a, pre, w, op, 0 - 1, 0 - 1, dst.reg, size == 1, src, 0, 0)
    } else {
        asm_fail(a, "unsupported mov")
    }
}

void need(Asm* a, int have, int n) {
    if have != n { asm_fail(a, "expected " + int_to_str(n) + " operand(s)") }
}

// One instruction line (from asm.strata): its mnemonic and operands, as text.
export void x64_instruction(Asm* a, string mn, string[dynamic] ops) {
    int n = ops.len
    Opnd x = no_opnd()
    Opnd y = no_opnd()
    if n > 0 { x = parse_opnd(a, ops[0]) }
    if n > 1 { y = parse_opnd(a, ops[1]) }
    if n > 2 { asm_fail(a, "too many operands") }
    if !a.o.ok { return }
    x64_encode(a, mn, n, x, y)
}

// Encode one instruction: mnemonic `mn` (AT&T: source first), `n` operands x, y.
export void x64_encode(Asm* a, string mn, int n, Opnd x, Opnd y) {
    int ml = mn.len
    char last = mn[ml - 1]

    // no operands
    if mn == "ret" { asm_byte(a, 195); return }
    if mn == "leave" { asm_byte(a, 201); return }
    if mn == "cqto" { asm_byte(a, 72); asm_byte(a, 153); return }
    if mn == "syscall" { asm_byte(a, 15); asm_byte(a, 5); return }   // Linux: into the kernel

    // jumps and calls
    if mn == "jmp" { need(a, n, 1); asm_byte(a, 233); rel32(a, x.sym); return }
    if mn == "call" { need(a, n, 1); asm_byte(a, 232); rel32(a, x.sym); return }
    if ml >= 2 && mn[0] == 'j' {
        int cc = cc_code(substr(mn, 1, ml - 1))
        if cc >= 0 && n == 1 && x.kind == 4 { asm_byte(a, 15); asm_byte(a, 128 + cc); rel32(a, x.sym); return }
    }
    if ml >= 4 && substr(mn, 0, 3) == "set" {
        int cc = cc_code(substr(mn, 3, ml - 3))
        if cc >= 0 && n == 1 { enc(a, 0, false, 15, 144 + cc, 0 - 1, 0, false, x, 0, 0); return }
    }

    // push / pop
    if mn == "pushq" || mn == "popq" {
        need(a, n, 1)
        if x.reg >= 8 { asm_byte(a, 65) }
        if mn == "pushq" { asm_byte(a, 80 + (x.reg & 7)) } else { asm_byte(a, 88 + (x.reg & 7)) }
        return
    }

    // integer ALU: add / or / and / sub / xor / cmp + size
    if ml >= 3 && ml <= 5 {
        string base = substr(mn, 0, ml - 1)
        int sz = size_of(last)
        int d = 0 - 1
        if base == "add" { d = 0 } else if base == "or" { d = 1 } else if base == "and" { d = 4 }
        else if base == "sub" { d = 5 } else if base == "xor" { d = 6 } else if base == "cmp" { d = 7 }
        if d >= 0 && sz > 0 { need(a, n, 2); alu(a, d, sz, x, y); return }
    }

    // moves
    if mn == "movq" || mn == "movl" || mn == "movw" || mn == "movb" { need(a, n, 2); mov(a, size_of(last), x, y); return }
    if mn == "movabsq" {
        need(a, n, 2)
        if y.reg >= 8 { asm_byte(a, 73) } else { asm_byte(a, 72) }
        asm_byte(a, 184 + (y.reg & 7))
        asm_bytes(a, x.imm, 8)
        return
    }
    if mn == "movsbq" { enc(a, 0, true, 15, 190, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movswq" { enc(a, 0, true, 15, 191, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movzbq" { enc(a, 0, true, 15, 182, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movzwq" { enc(a, 0, true, 15, 183, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movzbl" { enc(a, 0, false, 15, 182, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movzwl" { enc(a, 0, false, 15, 183, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movslq" { enc(a, 0, true, 99, 0 - 1, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "leaq" { need(a, n, 2); enc(a, 0, true, 141, 0 - 1, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movd" {
        need(a, n, 2)
        if x.size == 16 { enc(a, 102, false, 15, 126, 0 - 1, x.reg, false, y, 0, 0) }   // xmm -> r32
        else { enc(a, 102, false, 15, 110, 0 - 1, y.reg, false, x, 0, 0) }               // r32 -> xmm
        return
    }

    // multiply, divide, unary
    if mn == "imulq" {
        need(a, n, 2)
        if x.kind == 2 {
            if fits8(x.imm) { enc(a, 0, true, 107, 0 - 1, 0 - 1, y.reg, false, y, 1, x.imm) }
            else { enc(a, 0, true, 105, 0 - 1, 0 - 1, y.reg, false, y, 4, x.imm) }
        } else {
            enc(a, 0, true, 15, 175, 0 - 1, y.reg, false, x, 0, 0)
        }
        return
    }
    if mn == "idivq" { enc(a, 0, true, 247, 0 - 1, 0 - 1, 7, false, x, 0, 0); return }
    if mn == "divq" { enc(a, 0, true, 247, 0 - 1, 0 - 1, 6, false, x, 0, 0); return }
    if mn == "negq" { enc(a, 0, true, 247, 0 - 1, 0 - 1, 3, false, x, 0, 0); return }
    if mn == "notq" { enc(a, 0, true, 247, 0 - 1, 0 - 1, 2, false, x, 0, 0); return }
    if mn == "decq" { enc(a, 0, true, 255, 0 - 1, 0 - 1, 1, false, x, 0, 0); return }
    if mn == "shlq" || mn == "shrq" || mn == "sarq" {
        need(a, n, 2)
        int d = 4
        if mn == "shrq" { d = 5 } else if mn == "sarq" { d = 7 }
        if x.kind == 2 { enc(a, 0, true, 193, 0 - 1, 0 - 1, d, false, y, 1, x.imm) }
        else if x.kind == 1 && x.reg == 1 && x.size == 1 { enc(a, 0, true, 211, 0 - 1, 0 - 1, d, false, y, 0, 0) }
        else { asm_fail(a, "a shift count must be $imm or %cl") }
        return
    }
    if mn == "btcq" { need(a, n, 2); enc(a, 0, true, 15, 186, 0 - 1, 7, false, y, 1, x.imm); return }

    // SSE scalar
    int pre = 0
    if ml > 2 && substr(mn, ml - 2, 2) == "ss" { pre = 243 }
    if ml > 2 && substr(mn, ml - 2, 2) == "sd" { pre = 242 }
    if mn == "movss" || mn == "movsd" {
        need(a, n, 2)
        if y.kind == 1 { enc(a, pre, false, 15, 16, 0 - 1, y.reg, false, x, 0, 0) }
        else { enc(a, pre, false, 15, 17, 0 - 1, x.reg, false, y, 0, 0) }
        return
    }
    if mn == "movaps" { need(a, n, 2); enc(a, 0, false, 15, 40, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "movups" {
        need(a, n, 2)
        if y.kind == 1 { enc(a, 0, false, 15, 16, 0 - 1, y.reg, false, x, 0, 0) }
        else { enc(a, 0, false, 15, 17, 0 - 1, x.reg, false, y, 0, 0) }
        return
    }
    if pre != 0 && ml == 5 {
        string base = substr(mn, 0, 3)
        int op = 0 - 1
        if base == "add" { op = 88 } else if base == "mul" { op = 89 } else if base == "sub" { op = 92 } else if base == "div" { op = 94 }
        if op >= 0 { need(a, n, 2); enc(a, pre, false, 15, op, 0 - 1, y.reg, false, x, 0, 0); return }
    }
    if mn == "sqrtss" || mn == "sqrtsd" { need(a, n, 2); enc(a, pre, false, 15, 81, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "ucomiss" { need(a, n, 2); enc(a, 0, false, 15, 46, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "ucomisd" { need(a, n, 2); enc(a, 102, false, 15, 46, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvtsi2ssq" { need(a, n, 2); enc(a, 243, true, 15, 42, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvtsi2sdq" { need(a, n, 2); enc(a, 242, true, 15, 42, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvttss2siq" { need(a, n, 2); enc(a, 243, true, 15, 44, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvttsd2siq" { need(a, n, 2); enc(a, 242, true, 15, 44, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvtss2sd" { need(a, n, 2); enc(a, 243, false, 15, 90, 0 - 1, y.reg, false, x, 0, 0); return }
    if mn == "cvtsd2ss" { need(a, n, 2); enc(a, 242, false, 15, 90, 0 - 1, y.reg, false, x, 0, 0); return }

    asm_fail(a, "unknown instruction " + mn)
}

// A fixup in .text (asm.strata): a rel32 to a label in .text is resolved here; one to
// another section or to a symbol defined elsewhere becomes a relocation.
export void x64_fixup(Asm* a, Fix f, int li) {
    if li >= 0 && a.lsec[li] == 1 {
        asm_patch(a, f.pos, a.loff[li] + f.addend - (f.pos + 4 + f.after), 4)
    } else if li >= 0 {
        asm_patch(a, f.pos, a.loff[li] + f.addend, 4)
        a.o.relocs.push(ObjReloc{ 1, f.pos, 0 - a.lsec[li], f.after, 0 })
    } else {
        asm_patch(a, f.pos, f.addend, 4)
        a.o.relocs.push(ObjReloc{ 1, f.pos, asm_symbol(a, f.label, 0, 0), f.after, 0 })
    }
}

// what .text is padded with: nop
export int x64_nop() { return 144 }
