//
// src/host.strata - what the compiler needs from whatever hosts it: where messages go,
// the operating system (files, folders, running programs), raw bytes, memory resets.
// Declared here once, as a foreign block, for every compiler module that needs it
// (`import host`). The C backend gets them from strata_host.h (beside this file, through
// lib/crossplatform.h); see that file for what each one does.

export foreign "strata_host.h" {
    // messages: printed, or captured for a host (libstrata)
    void   strata_report(string msg)
    void   strata_print_raw(string text)   // to stdout as is (no newline added)
    void   strata_capture_begin()
    void   strata_capture_end()
    string strata_capture_text()

    // strings: join a string[dynamic] in one pass
    string strata_join(string[dynamic]* parts)

    // the operating system
    string strata_host_os()
    string strata_host_arch()
    string strata_cc()
    string strata_exe_path()
    string strata_getenv(string name)
    bool   strata_file_exists(string path)
    bool   strata_make_dirs(string path)
    int    strata_cpu_count()
    int    strata_run_argv(string[dynamic]* argv)
    int    strata_run_cc_parallel(string[dynamic]* rsp_files, int jobs)

    // binary files and float bits (the native backend's assembler and linker)
    bool        strata_write_bytes(string path, u8[dynamic]* bytes)
    u8[dynamic] strata_read_bytes(string path)
    string      strata_bytes_cstr(u8[dynamic]* b, int at, int max)
    int         strata_f32_bits(string text)
    int         strata_f64_bits(string text)

    // memory: free one dynamic array now (pass cast<u8*>(&array)); free everything
    void   strata_array_free(u8* array)
    void   strata_host_reset()

    // the runtime lib/ folder
    void   strata_host_set_libdir(string dir)
    string strata_host_libdir()
}
