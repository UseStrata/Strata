//
// src/console.strata - the Strata explorer console (front-end #2).
//
// A SECOND, independent executable built on the exact same core (core.strata) and the
// same renderer (dump.strata) as the `strata` CLI. Its only job is to prove the point of
// the architecture: the compiler is a reusable library, and a front-end is a thin
// shell over it. This one shows a file's tokens AND its AST together in one view - a
// tiny "compiler explorer" for eyeballing what the core produced.
//
//   console <file.strata>

// print_tokens / print_program (+ the core)
import core   // the compiler (every phase, re-exported)
import dump

int dmm_main(string[dynamic] args) {
    if (args.len < 2) {
        print("strata console - show a program's tokens and AST");
        print("usage: console <file.strata>")
        return 2
    }
    string path = args[1]
    string src  = read_file(path)

    print("=== TOKENS ===")
    Token[dynamic] toks = lex(src)
    print_tokens(toks)

    print("")
    print("=== AST ===")
    Parser p = new_parser(toks)
    Program prog = parse_program(&p)
    if (p.had_error) { print("(parse error)"); return 1; }
    print_program(prog)
    return 0
}

// entry point (translated from D--'s `int main(str[] args)`)
foreign <stdlib.h> { void exit(i32 code) }
exit(dmm_main(args()))
