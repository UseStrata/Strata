//
// src/lexer.strata - the Strata lexer, written in Strata (originally ported from D--; a MODULE, no main).
//
// Milestone 1, step 1. `lex(src)` turns Strata source text into a Token[].
// Imported by the parser.
//
// Structure mirrors D--'s proven lexer. Strata-specific behaviour:
//   * `..` range operator.
//   * significant NEWLINE: statements end at a newline, not `;`. We emit a NEWLINE
//     token only when the previous token can END a statement (identifier, literal,
//     `)`, `]`, `}`, `return`, `true`, `false`). After an operator, comma, or an open
//     bracket the newline is swallowed, so multi-line expressions continue naturally
//     (the same rule Go uses for automatic semicolons). And inside an open `(` or `[`
//     no NEWLINE is emitted at all, so a wrapped condition or argument list continues
//     (Python's rule).

// TokKind + Token
import token
import hashidx                  // NameIdx, for interning
import host   // strata_array_free

struct Lexer {
    string  src
    int  pos
    int  line
    int  col
    int  start// index of the current token's first char
    int  start_line
    int  start_col
    bool had_error
    bool saw_newline// did the trivia we just skipped cross a line?
    // identifier/number texts seen so far, one copy each (see intern)
    string[dynamic] names
    NameIdx names_idx
}

// ---- character classes -------------------------------------------------

bool is_digit(char c) { return c >= '0' && c <= '9'; }
bool is_hex(char c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}
bool is_ident_start(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'; }
bool is_ident_part(char c)  { return is_ident_start(c) || is_digit(c); }

// ---- cursor ------------------------------------------------------------

bool at_end(Lexer* l) { return l.pos >= l.src.len; }

char advance(Lexer* l) {
    char c = l.src[l.pos]
    l.pos += 1
    if (c == '\n') { l.line += 1; l.col = 1; }
    else           { l.col += 1; }
    return c
}

char peek(Lexer* l) {
    if (at_end(l)) { return '\0'; }
    return l.src[l.pos]
}
char peek_next(Lexer* l) {
    if (l.pos + 1 >= l.src.len) { return '\0'; }
    return l.src[l.pos + 1]
}

bool match(Lexer* l, char expected) {
    if (at_end(l)) { return false; }
    if (l.src[l.pos] != expected) { return false; }
    advance(l)
    return true
}

// ---- token construction ------------------------------------------------

// Is s[start .. start+n) the same text as w?
bool same_slice(string s, int start, int n, string w) {
    if w.len != n { return false }
    for i in 0..n { if s[start + i] != w[i] { return false } }
    return true
}

// Identifiers and numbers repeat a lot (i, x, self, 0, 1, ...): each file keeps one copy
// of each distinct text, and every token with that text shares it.
string intern(Lexer* l, int start, int n) {
    int k = l.names_idx.head[slice_hash(l.src, start, n, l.names_idx.mask)] - 1
    while k >= 0 {
        if same_slice(l.src, start, n, l.names[k]) { return l.names[k] }
        k = idx_next(&l.names_idx, k)
    }
    string w = substr(l.src, start, n)
    idx_add(&l.names_idx, w, l.names.len)
    l.names.push(w)
    return w
}

Token make(Lexer* l, TokKind kind) {
    // Only identifiers and numbers need their source text (interned). Every other token's
    // text is fixed ("+", "var", ...), so they share kind_name's constant string.
    if kind == TkIdent || kind == TkInt || kind == TkFloat {
        return Token{ kind, intern(l, l.start, l.pos - l.start), l.start_line, l.start_col }
    }
    return Token{ kind, kind_name(kind), l.start_line, l.start_col }
}
Token make_text(Lexer* l, TokKind kind, string text) {
    return Token{ kind, text, l.start_line, l.start_col }
}
Token fail(Lexer* l) {
    l.had_error = true
    return Token{ TkError, "", l.start_line, l.start_col }
}

// ---- trivia (whitespace + comments; note: sets saw_newline) ------------

void skip_trivia(Lexer* l) {
    while (true) {
        char c = peek(l)
        if (c == '\n') { l.saw_newline = true; advance(l); }
        else if (c == ' ' || c == '\t' || c == '\r') {
            advance(l)
        } else if (c == '/' && peek_next(l) == '/') {
            while (!at_end(l) && peek(l) != '\n') { advance(l); }
        } else if (c == '/' && peek_next(l) == '*') {
            advance(l); advance(l)
            int depth = 1
            while (!at_end(l) && depth > 0) {
                if (peek(l) == '/' && peek_next(l) == '*')      { advance(l); advance(l); depth += 1; }
                else if (peek(l) == '*' && peek_next(l) == '/') { advance(l); advance(l); depth -= 1; }
                else                                            { advance(l); }
            }
            if (depth > 0) { l.had_error = true; }
        } else {
            return
        }
    }
}

// ---- literals ----------------------------------------------------------
// A string/char token's text is the literal AS WRITTEN between the quotes, escapes
// included (`a\nb`, not a decoded newline). The escapes are validated here; every
// Strata escape (\n \t \r \0 \\ \" \') is also a C escape, so codegen emits the text
// as-is. Keeping it raw means the compiler never holds a NUL inside a string, which
// matters once it runs as Strata (NUL-terminated strings).

bool valid_escape(char e, char quote) {
    return e == 'n' || e == 't' || e == 'r' || e == '0' || e == '\\' || e == quote
}

// the raw text between the quotes of the token just scanned
string literal_body(Lexer* l) { return substr(l.src, l.start + 1, l.pos - l.start - 2); }

Token string_lit(Lexer* l) {
    while (!at_end(l) && peek(l) != '"') {
        char c = peek(l)
        if (c == '\n') { return fail(l); }
        if (c == '\\') {
            advance(l)
            if (at_end(l) || !valid_escape(advance(l), '"')) { return fail(l); }
        } else {
            advance(l)
        }
    }
    if (at_end(l)) { return fail(l); }
    advance(l)// closing quote
    return make_text(l, TkString, literal_body(l))
}

Token char_lit(Lexer* l) {
    if (at_end(l)) { return fail(l); }
    char c = advance(l)
    if (c == '\\') {
        if (at_end(l) || !valid_escape(advance(l), '\'')) { return fail(l); }
    }
    if (!match(l, '\'')) { return fail(l); }
    return make_text(l, TkChar, literal_body(l))
}

Token number(Lexer* l) {
    char first = l.src[l.start]
    if (first == '0' && (peek(l) == 'x' || peek(l) == 'X')) {
        advance(l)
        while (is_hex(peek(l)) || peek(l) == '_') { advance(l); }
        return make(l, TkInt)
    }
    if (first == '0' && (peek(l) == 'b' || peek(l) == 'B')) {
        advance(l)
        while (peek(l) == '0' || peek(l) == '1' || peek(l) == '_') { advance(l); }
        return make(l, TkInt)
    }
    while (is_digit(peek(l)) || peek(l) == '_') { advance(l); }
    bool is_float = false
    // `1.5` is a float; `0..60` is NOT (a `.` followed by another `.` is the range op).
    if (peek(l) == '.' && is_digit(peek_next(l))) {
        is_float = true
        advance(l)
        while (is_digit(peek(l)) || peek(l) == '_') { advance(l); }
    }
    if (peek(l) == 'e' || peek(l) == 'E') {
        is_float = true
        advance(l)
        if (peek(l) == '+' || peek(l) == '-') { advance(l); }
        while (is_digit(peek(l))) { advance(l); }
    }
    if (is_float) { return make(l, TkFloat); }
    return make(l, TkInt)
}

TokKind keyword_kind(string w) {
    if (w == "var")    { return TkKwVar; }
    if (w == "const")  { return TkKwConst; }
    if (w == "struct") { return TkKwStruct; }
    if (w == "enum")   { return TkKwEnum; }
    if (w == "if")     { return TkKwIf; }
    if (w == "else")   { return TkKwElse; }
    if (w == "while")  { return TkKwWhile; }
    if (w == "for")    { return TkKwFor; }
    if (w == "in")     { return TkKwIn; }
    if (w == "return") { return TkKwReturn; }
    if (w == "true")   { return TkKwTrue; }
    if (w == "false")  { return TkKwFalse; }
    if (w == "region") { return TkKwRegion; }
    if (w == "import")  { return TkKwImport; }
    if (w == "link")    { return TkKwLink; }
    if (w == "switch")  { return TkKwSwitch; }
    if (w == "case")    { return TkKwCase; }
    if (w == "default") { return TkKwDefault; }
    if (w == "export")  { return TkKwExport; }
    if (w == "cast")    { return TkKwCast; }
    if (w == "sizeof")  { return TkKwSizeof; }
    if w == "break"     { return TkKwBreak }
    if w == "continue"  { return TkKwContinue }
    return TkIdent
}

Token identifier(Lexer* l) {
    while (is_ident_part(peek(l))) { advance(l); }
    string word = substr(l.src, l.start, l.pos - l.start)
    return make(l, keyword_kind(word))
}

// ---- one token ---------------------------------------------------------

Token scan_token(Lexer* l) {
    char c = advance(l)
    switch (c) {
        case '(': return make(l, TkLParen)
        case ')': return make(l, TkRParen)
        case '{': return make(l, TkLBrace)
        case '}': return make(l, TkRBrace)
        case '[': return make(l, TkLBracket)
        case ']': return make(l, TkRBracket)
        case ',': return make(l, TkComma)
        case ';': return make(l, TkSemicolon)
        case ':': return make(l, TkColon)
        case '.':
            if (match(l, '.')) { return make(l, TkDotDot); }
            return make(l, TkDot)
        case '#': return make(l, TkHash)
        case '%': return make(l, TkPercent)
        case '+': if (match(l, '=')) { return make(l, TkPlusEq); }  return make(l, TkPlus)
        case '-': if (match(l, '=')) { return make(l, TkMinusEq); } return make(l, TkMinus)
        case '*': if (match(l, '=')) { return make(l, TkStarEq); }  return make(l, TkStar)
        case '/': if (match(l, '=')) { return make(l, TkSlashEq); } return make(l, TkSlash)
        case '=': if (match(l, '=')) { return make(l, TkEqEq); }    return make(l, TkAssign)
        case '!': if (match(l, '=')) { return make(l, TkBangEq); }  return make(l, TkBang)
        case '<':
            if (match(l, '<')) { if (match(l, '=')) { return make(l, TkShlEq); } return make(l, TkShl); }
            if (match(l, '=')) { return make(l, TkLtEq); }
            return make(l, TkLt)
        case '>':
            if (match(l, '>')) { if (match(l, '=')) { return make(l, TkShrEq); } return make(l, TkShr); }
            if (match(l, '=')) { return make(l, TkGtEq); }
            return make(l, TkGt)
        case '&':
            if (match(l, '&')) { return make(l, TkAmpAmp); }
            if (match(l, '=')) { return make(l, TkAmpEq); }
            return make(l, TkAmp)
        case '|':
            if (match(l, '|')) { return make(l, TkPipePipe); }
            if (match(l, '=')) { return make(l, TkPipeEq); }
            return make(l, TkPipe)
        case '^': if (match(l, '=')) { return make(l, TkCaretEq); } return make(l, TkCaret)
        case '~': return make(l, TkTilde)
        case '"':  return string_lit(l);
        case '\'': return char_lit(l);
        default:
            if (is_digit(c))       { return number(l); }
            if (is_ident_start(c)) { return identifier(l); }
            return fail(l)
    }
    return fail(l)
}

// A statement can END on these tokens, so a following newline terminates it.
// After anything else (operators, `,`, `(`, `{`, ...) a newline is swallowed and the
// expression/line continues.
bool ends_statement(TokKind k) {
    switch (k) {
        case TkIdent, TkInt, TkFloat, TkString, TkChar,
             TkKwTrue, TkKwFalse, TkKwReturn, TkKwBreak, TkKwContinue,
             TkRParen, TkRBracket, TkRBrace:
            return true
        default:
            return false
    }
    return false
}

export Token[dynamic] lex(string src) {
    Token[dynamic] tokens = []
    string[dynamic] names = []
    Lexer lx = Lexer{ src, 0, 1, 1, 0, 1, 1, false, false, names, new_idx(src.len / 32) }
    TokKind last = TkError
    bool have_last = false
    int  nest = 0// open ( and [ : newlines inside them never end a statement

    lx.saw_newline = false
    skip_trivia(&lx)
    while (!at_end(&lx)) {
        // Insert a NEWLINE terminator if the skipped trivia crossed a line and the
        // previous real token can end a statement.
        if (lx.saw_newline && have_last && nest == 0 && ends_statement(last)) {
            tokens.push(Token{ TkNewline, "", lx.line, lx.col })
        }
        lx.saw_newline = false

        lx.start = lx.pos
        lx.start_line = lx.line
        lx.start_col = lx.col
        Token t = scan_token(&lx)
        tokens.push(t)
        last = t.kind
        if (t.kind == TkLParen || t.kind == TkLBracket) { nest += 1; }
        else if ((t.kind == TkRParen || t.kind == TkRBracket) && nest > 0) { nest -= 1; }
        have_last = true
        skip_trivia(&lx)
    }
    // Close the final statement (trailing newline at EOF).
    if (lx.saw_newline && have_last && ends_statement(last)) {
        tokens.push(Token{ TkNewline, "", lx.line, lx.col })
    }
    tokens.push(Token{ TkEof, "", lx.line, lx.col })
    // the intern table itself is done (the strings it handed out live on in the tokens)
    strata_array_free(cast<u8*>(&lx.names))
    strata_array_free(cast<u8*>(&lx.names_idx.head))
    strata_array_free(cast<u8*>(&lx.names_idx.next))
    return tokens
}

// kind_name = the printable name of a token kind, used by the `tokens` dump and
// (later) by parser error messages.
export string kind_name(TokKind k) {
    switch (k) {
        case TkIdent:     return "Ident"
        case TkInt:       return "Int"
        case TkFloat:     return "Float"
        case TkString:    return "String"
        case TkChar:      return "Char"
        case TkKwVar:     return "var"
        case TkKwConst:   return "const"
        case TkKwStruct:  return "struct"
        case TkKwEnum:    return "enum"
        case TkKwIf:      return "if"
        case TkKwElse:    return "else"
        case TkKwWhile:   return "while"
        case TkKwFor:     return "for"
        case TkKwIn:      return "in"
        case TkKwReturn:  return "return"
        case TkKwTrue:    return "true"
        case TkKwFalse:   return "false"
        case TkKwRegion:  return "region"
        case TkKwImport:  return "import"
        case TkKwLink:    return "link"
        case TkKwSwitch:  return "switch"
        case TkKwCase:    return "case"
        case TkKwDefault: return "default"
        case TkKwExport:  return "export"
        case TkKwCast:    return "cast"
        case TkKwSizeof:  return "sizeof"
        case TkKwBreak:   return "break"
        case TkKwContinue: return "continue"
        case TkLParen:    return "("
        case TkRParen:    return ")"
        case TkLBrace:    return "{"
        case TkRBrace:    return "}"
        case TkLBracket:  return "["
        case TkRBracket:  return "]"
        case TkComma:     return ","
        case TkSemicolon: return ";"
        case TkColon:     return ":"
        case TkDot:       return "."
        case TkDotDot:    return ".."
        case TkHash:      return "#"
        case TkAssign:    return "="
        case TkPlus:      return "+"
        case TkMinus:     return "-"
        case TkStar:      return "*"
        case TkSlash:     return "/"
        case TkPercent:   return "%"
        case TkPlusEq:    return "+="
        case TkMinusEq:   return "-="
        case TkStarEq:    return "*="
        case TkSlashEq:   return "/="
        case TkEqEq:      return "=="
        case TkBangEq:    return "!="
        case TkLt:        return "<"
        case TkLtEq:      return "<="
        case TkGt:        return ">"
        case TkGtEq:      return ">="
        case TkAmpAmp:    return "&&"
        case TkPipePipe:  return "||"
        case TkBang:      return "!"
        case TkAmp:       return "&"
        case TkPipe:      return "|"
        case TkCaret:     return "^"
        case TkTilde:     return "~"
        case TkShl:       return "<<"
        case TkShr:       return ">>"
        case TkPipeEq:    return "|="
        case TkAmpEq:     return "&="
        case TkCaretEq:   return "^="
        case TkShlEq:     return "<<="
        case TkShrEq:     return ">>="
        case TkNewline:   return "NEWLINE"
        case TkEof:       return "EOF"
        default:          return "Error"
    }
    return "Error"
}
