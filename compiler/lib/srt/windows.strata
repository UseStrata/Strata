// Copyright © 2026 Connor Rutberg
// lib/srt/windows.strata - the native runtime's Windows layer: what lib/srt.strata needs
// from the OS, on Windows.
//
//   * the C runtime every Windows has (msvcrt.dll): memory, strings, stdio, sinf / cosf /
//     tanf, getenv - exported as they are (a foreign block), so srt.strata calls them
//     directly;
//   * srt_os_*: the rest - paths, folders, starting programs - on msvcrt and kernel32.
//
// lib/srt.strata imports it when building for Windows (`when target_os == "windows"`).
// Another OS = another file with the same names (lib/srt/linux.strata).
//
// Part of the Strata RUNTIME (compiler/lib): GPL-3.0 WITH the runtime linking exception
// (see ../../../LICENSE-RUNTIME.md) - programs built with Strata are not covered by the GPL.

export foreign {   // msvcrt.dll
    u8* malloc(int size)
    u8* realloc(u8* p, int size)
    void free(u8* p)
    u8* memcpy(u8* dst, u8* src, int n)
    u8* memset(u8* dst, i32 c, int n)
    int strlen(string s)
    i32 strcmp(string a, string b)
    i32 puts(string s)
    u8* fopen(string path, string mode)
    i32 fclose(u8* f)
    i32 fseek(u8* f, i32 offset, i32 whence)     // `long` is 32 bits on Windows
    i32 ftell(u8* f)
    int fread(u8* buf, int size, int n, u8* f)
    int fwrite(u8* buf, int size, int n, u8* f)
    float sinf(float x)
    float cosf(float x)
    float tanf(float x)
    string getenv(string name)
}

foreign {          // msvcrt.dll, for this file only
    i32 fflush(u8* f)
    u8* __iob_func()
    i32 _mkdir(string path)
    int _spawnvp(i32 mode, string cmd, string* argv)
    int _cwait(i32* status, int process, i32 action)
}

foreign {          // kernel32.dll
    u32 GetFileAttributesA(string path)
    u32 GetModuleFileNameA(u8* module, u8* buf, u32 size)
    i32 GetModuleHandleExA(u32 flags, u8* address, u8** module)
}

export string srt_os_name() { return "windows" }
export string srt_os_arch() { return "x86_64" }
export string srt_os_default_cc() { return "gcc" }      // MinGW's

export void srt_os_init(i32 argc, string* argv) {}           // (msvcrt keeps the environment)

// ---- output -------------------------------------------------------------------------------

// stdout: msvcrt's FILE array, entry 1 (a FILE is 48 bytes)
u8* stdout_file() { return cast<u8*>(cast<int>(__iob_func()) + 48) }

// n bytes to stdout as they are, in order with puts
export void srt_os_print_raw(u8* text, int n) { if n > 0 { fwrite(text, 1, n, stdout_file()) } }

// ---- paths --------------------------------------------------------------------------------

// The path of this program's file / of the module (exe or dll) this runtime is in, into
// buf (size bytes): its length, 0 if unknown.
export int srt_os_exe_path(u8* buf, int size) { return path_of(null, buf, size) }

global int anchor          // something in this module, to find it by

export int srt_os_module_path(u8* buf, int size) {
    u8* m = null
    // 4 | 2: GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | ..._UNCHANGED_REFCOUNT
    if GetModuleHandleExA(cast<u32>(6), cast<u8*>(&anchor), &m) == 0 { return 0 }
    return path_of(m, buf, size)
}

int path_of(u8* module, u8* buf, int size) {
    u32 n = GetModuleFileNameA(module, buf, cast<u32>(size))
    if n == cast<u32>(0) || cast<int>(n) >= size { return 0 }
    return cast<int>(n)
}

export int srt_os_cpu_count() {
    string n = getenv("NUMBER_OF_PROCESSORS")
    int v = 0
    if cast<u8*>(n) != null {
        u8* b = cast<u8*>(n)
        int i = 0
        while b[i] >= cast<u8>('0') && b[i] <= cast<u8>('9') {
            v = v * 10 + (cast<int>(b[i]) - cast<int>('0'))
            i += 1
        }
    }
    if v > 0 { return v }
    return 1
}

// ---- files and folders ----------------------------------------------------------------------

// 0: nothing there, 1: a file, 2: a folder
export int srt_os_path_kind(string path) {
    if strlen(path) == 0 { return 0 }
    u32 a = GetFileAttributesA(path)
    if a == cast<u32>(4294967295) { return 0 }                       // INVALID_FILE_ATTRIBUTES
    if (a & cast<u32>(16)) != cast<u32>(0) { return 2 }              // FILE_ATTRIBUTE_DIRECTORY
    return 1
}

// make one folder (its parent must exist): true if it exists afterwards
export bool srt_os_mkdir(string path) {
    _mkdir(path)
    return srt_os_path_kind(path) == 2
}

bool is_sep(u8 c) { return c == cast<u8>('/') || c == cast<u8>('\\') }

// how much of a path names its root, not a folder: "C:" (2), "\\server\share\" (to it)
export int srt_os_path_root(string path) {
    int n = strlen(path)
    u8* p = cast<u8*>(path)
    if n >= 2 && p[1] == cast<u8>(':') { return 2 }
    if n >= 2 && is_sep(p[0]) && is_sep(p[1]) {
        int seps = 0
        int i = 2
        while i < n && seps < 2 {
            if is_sep(p[i]) { seps += 1 }
            i += 1
        }
        return i
    }
    return 0
}

// ---- running programs -------------------------------------------------------------------------
// msvcrt's _spawnvp joins argv into one command line WITHOUT quoting, and the program
// splits it again; so each argument is quoted the way the C runtime parses it back.

// a quoted copy of `a` (malloc'd), or `a` itself if it needs no quotes
string quote_arg(string a) {
    int n = strlen(a)
    u8* s = cast<u8*>(a)
    bool needs = n == 0
    for i in 0..n {
        u8 c = s[i]
        if c == cast<u8>(' ') || c == cast<u8>(9) || c == cast<u8>(10) || c == cast<u8>(11) || c == cast<u8>('"') { needs = true }
    }
    if !needs { return a }
    u8* q = malloc(n * 2 + 3)
    int o = 0
    int slashes = 0
    q[o] = cast<u8>('"'); o += 1
    for i in 0..n {
        u8 c = s[i]
        if c == cast<u8>('\\') {
            slashes += 1
            q[o] = c; o += 1
        } else {
            if c == cast<u8>('"') {          // double the backslashes, escape the quote
                for k in 0..slashes { q[o] = cast<u8>('\\'); o += 1 }
                q[o] = cast<u8>('\\'); o += 1
            }
            slashes = 0
            q[o] = c; o += 1
        }
    }
    for k in 0..slashes { q[o] = cast<u8>('\\'); o += 1 }    // backslashes before the closing quote
    q[o] = cast<u8>('"'); o += 1
    q[o] = cast<u8>(0)
    return cast<string>(q)
}

// start argv[0..n) without waiting: a handle, 0 if it couldn't be started
export int srt_os_start(string* argv, int n) {
    if n < 1 { return 0 }
    string* quoted = cast<string*>(malloc(8 * (n + 1)))
    for i in 0..n { quoted[i] = quote_arg(argv[i]) }
    quoted[n] = cast<string>(null)
    fflush(null)
    int h = _spawnvp(1, argv[0], quoted)      // _P_NOWAIT
    for i in 0..n { if cast<u8*>(quoted[i]) != cast<u8*>(argv[i]) { free(cast<u8*>(quoted[i])) } }
    free(cast<u8*>(quoted))
    if h == 0 - 1 { return 0 }
    return h
}

// wait for a started program: its exit code, -1 if that failed
export int srt_os_wait(int h) {
    if h == 0 { return 0 - 1 }
    i32 status = 0
    if _cwait(&status, h, 0) == 0 - 1 { return 0 - 1 }
    return cast<int>(status)
}
