// Copyright © 2026 Connor Rutberg
// lib/srt.strata - the runtime of natively compiled programs, written in Strata.
//
// Natively compiled code (src/lower.strata) does its own arithmetic, control flow and
// vector math, and calls these `srt_*` functions for the rest: printing, arenas, strings,
// dynamic arrays, files, matrices and quaternions. They behave exactly like the C
// runtime (lib/*.h) the C backend uses, so both backends print the same.
//
// build.ps1 compiles this file with Strata's own native backend (`stratac object`) into
// lib/srt.o, which Strata's linker links into every native program. What it needs from
// outside is in the `foreign` block: functions of the C runtime that ships with Windows
// (msvcrt.dll). Structs travel by pointer (results through the first argument).
//
// Part of the Strata RUNTIME (compiler/lib): GPL-3.0 WITH the runtime linking exception
// (see ../../LICENSE-RUNTIME.md) - programs built with Strata are not covered by the GPL.

foreign {
    u8* malloc(int size)
    u8* realloc(u8* p, int size)
    void free(u8* p)
    u8* memcpy(u8* dst, u8* src, int n)
    u8* memset(u8* dst, i32 c, int n)
    int strlen(string s)
    i32 strcmp(string a, string b)
    i32 puts(string s)
    u8* fopen(string path, string mode)
    i32 fclose(u8* f)
    i32 fseek(u8* f, i32 offset, i32 whence)     // `long` is 32 bits on Windows
    i32 ftell(u8* f)
    int fread(u8* buf, int size, int n, u8* f)
    int fwrite(u8* buf, int size, int n, u8* f)
    float sinf(float x)
    float cosf(float x)
    float tanf(float x)
    // for the host functions (the end of this file)
    i32 fflush(u8* f)
    u8* __iob_func()
    string getenv(string name)
    i32 _mkdir(string path)
    int _spawnvp(i32 mode, string cmd, string* argv)
    int _cwait(i32* status, int process, i32 action)
}
foreign {   // kernel32.dll
    u32 GetFileAttributesA(string path)
    u32 GetModuleFileNameA(u8* module, u8* buf, u32 size)
    i32 GetModuleHandleExA(u32 flags, u8* address, u8** module)
}

// ---- arenas -------------------------------------------------------------------------------
// The layout of lib/arena.h: an arena is the newest of a chain of blocks; a block is this
// 24-byte header followed by its bytes. Allocations are 16-byte rounded and zeroed.

struct Block { Block* next; int used; int cap }
struct Pool { Block* head }

global Pool heap      // alloc(value)
global Pool strs      // strings: concatenation, substr, read_file, int_to_str

u8* pool_alloc(Pool* a, int size) {
    int sz = (size + 15) & ~15
    if a.head == null || a.head.used + sz > a.head.cap {
        int cap = 65536
        while cap < sz { cap = cap * 2 }
        Block* b = cast<Block*>(malloc(24 + cap))
        b.next = a.head
        b.used = 0
        b.cap = cap
        a.head = b
    }
    u8* p = cast<u8*>(cast<int>(a.head) + 24 + a.head.used)
    a.head.used = a.head.used + sz
    memset(p, 0, size)
    return p
}

export u8* srt_arena_alloc(Pool* a, int size) { return pool_alloc(a, size) }

export void srt_arena_free(Pool* a) {
    Block* b = a.head
    while b != null {
        Block* n = b.next
        free(cast<u8*>(b))
        b = n
    }
    a.head = null
}

export u8* srt_heap_alloc(int size) { return pool_alloc(&heap, size) }

// ---- strings ------------------------------------------------------------------------------

u8* bytes(string s) { return cast<u8*>(s) }

// Long strings the runtime makes have their length remembered (lib/sstr.h does the same),
// so `.len` and substr on them are O(1): a program walking a big file with s[i] / s.len
// stays linear. An open-addressing table keyed by the string's address; any other string
// (a literal, a buffer from C) is measured with strlen.
global u64* len_keys
global int* len_vals
global int len_cap      // a power of two
global int len_count

int len_min() { return 128 }   // shorter strings are cheap to measure

int len_slot(u64 p, int cap) {
    u64 x = p
    x = x ^ (x >> cast<u64>(29))
    x = x * cast<u64>(0 - 4658895280553007687)    // 0xBF58476D1CE4E5B9
    x = x ^ (x >> cast<u64>(32))
    return cast<int>(x & cast<u64>(cap - 1))
}

void len_put(u8* s, int len) {
    if len < len_min() { return }
    if (len_count + 1) * 2 > len_cap {        // keep the load at most 1/2
        int ncap = 1024
        if len_cap > 0 { ncap = len_cap * 2 }
        u64* nk = cast<u64*>(malloc(8 * ncap))
        int* nv = cast<int*>(malloc(8 * ncap))
        memset(cast<u8*>(nk), 0, 8 * ncap)
        for i in 0..len_cap {
            if len_keys[i] != cast<u64>(0) {
                int j = len_slot(len_keys[i], ncap)
                while nk[j] != cast<u64>(0) { j = (j + 1) & (ncap - 1) }
                nk[j] = len_keys[i]
                nv[j] = len_vals[i]
            }
        }
        if len_cap > 0 { free(cast<u8*>(len_keys)); free(cast<u8*>(len_vals)) }
        len_keys = nk
        len_vals = nv
        len_cap = ncap
    }
    u64 key = cast<u64>(cast<int>(s))
    int j = len_slot(key, len_cap)
    while len_keys[j] != cast<u64>(0) && len_keys[j] != key { j = (j + 1) & (len_cap - 1) }
    if len_keys[j] == cast<u64>(0) { len_count += 1 }
    len_keys[j] = key
    len_vals[j] = len
}

// strlen, unless the runtime remembers this string's length
int str_length(string s) {
    if len_cap > 0 {
        u64 key = cast<u64>(cast<int>(cast<u8*>(s)))
        int j = len_slot(key, len_cap)
        while len_keys[j] != cast<u64>(0) {
            if len_keys[j] == key { return len_vals[j] }
            j = (j + 1) & (len_cap - 1)
        }
    }
    return strlen(s)
}

export string srt_str_concat(string x, string y) {
    int lx = str_length(x)
    int ly = str_length(y)
    u8* r = pool_alloc(&strs, lx + ly + 1)
    memcpy(r, bytes(x), lx)
    memcpy(&r[lx], bytes(y), ly)
    len_put(r, lx + ly)
    return cast<string>(r)
}

export i32 srt_str_eq(string x, string y) {
    if strcmp(x, y) == 0 { return 1 }
    return 0
}

export int srt_str_len(string s) { return str_length(s) }

// substr(s, start, n): n bytes from `start`, clamped to the string's bounds
export string srt_str_sub(string s, int start, int n) {
    int len = str_length(s)
    if start < 0 { start = 0 }
    if start > len { start = len }
    if n < 0 { n = 0 }
    if start + n > len { n = len - start }
    u8* r = pool_alloc(&strs, n + 1)
    u8* sb = bytes(s)
    memcpy(r, &sb[start], n)
    len_put(r, n)
    return cast<string>(r)
}

// v in decimal into buf; returns the length
int fmt_int(u8* buf, int v) {
    u64 u = cast<u64>(v)
    if v < 0 { u = cast<u64>(0) - u }
    int n = 0
    u64 t = u
    bool more = true
    while more {             // count the digits
        n += 1
        t = t / cast<u64>(10)
        more = t != cast<u64>(0)
    }
    int at = 0
    if v < 0 { buf[0] = cast<u8>('-'); at = 1 }
    int k = at + n - 1
    more = true
    while more {
        buf[k] = cast<u8>(cast<int>('0') + cast<int>(u % cast<u64>(10)))
        u = u / cast<u64>(10)
        k -= 1
        more = u != cast<u64>(0)
    }
    buf[at + n] = cast<u8>(0)
    return at + n
}

export string srt_str_from_int(int v) {
    u8* tmp = scratch()
    int n = fmt_int(tmp, v)
    u8* r = pool_alloc(&strs, n + 1)
    memcpy(r, tmp, n)
    return cast<string>(r)
}

// ---- printing -------------------------------------------------------------------------------

global u8* fmt_buf    // one buffer for formatting, made on first use

u8* scratch() {
    if fmt_buf == null { fmt_buf = malloc(128) }
    return fmt_buf
}

export void srt_print_str(string s) { puts(s) }

export void srt_print_i64(int v) {
    u8* b = scratch()
    fmt_int(b, v)
    puts(cast<string>(b))
}

int put(u8* b, int at, char c) {
    b[at] = cast<u8>(c)
    return at + 1
}

// ---- exact float digits ------------------------------------------------------------------
// printf rounds a double's EXACT value; msvcrt's own conversions round a 17-digit
// approximation of it (so e.g. 0.1234565, stored as 0.12345649999..., came out 0.123457).
// So the digits are computed here exactly, with small big integers: limbs of 32 bits in
// u64s, in buffers made once.

global u64* big_n
global u64* big_d
global u64* big_t

int BIG() { return 48 }

u64 lo32() { return cast<u64>(4294967295) }

int big_trim(u64* a, int n) {
    while n > 1 && a[n - 1] == cast<u64>(0) { n -= 1 }
    return n
}

int big_set(u64* a, u64 v) {
    a[0] = v & lo32()
    a[1] = v >> cast<u64>(32)
    return big_trim(a, 2)
}

int big_mul_small(u64* a, int n, u64 k) {
    u64 carry = cast<u64>(0)
    for i in 0..n {
        u64 x = a[i] * k + carry
        a[i] = x & lo32()
        carry = x >> cast<u64>(32)
    }
    if carry != cast<u64>(0) { a[n] = carry; n += 1 }
    return n
}

int big_shl(u64* a, int n, int bits) {
    int words = bits / 32
    int r = bits % 32
    if r > 0 {
        u64 carry = cast<u64>(0)
        for i in 0..n {
            u64 x = (a[i] << cast<u64>(r)) | carry
            carry = a[i] >> cast<u64>(32 - r)
            a[i] = x & lo32()
        }
        if carry != cast<u64>(0) { a[n] = carry; n += 1 }
    }
    if words > 0 {
        int k = n - 1
        while k >= 0 { a[k + words] = a[k]; k -= 1 }
        for i in 0..words { a[i] = cast<u64>(0) }
        n += words
    }
    return big_trim(a, n)
}

int big_cmp(u64* a, int an, u64* b, int bn) {
    if an != bn { if an > bn { return 1 } return 0 - 1 }
    int k = an - 1
    int r = 0
    while k >= 0 && r == 0 {
        if a[k] > b[k] { r = 1 } else if a[k] < b[k] { r = 0 - 1 }
        k -= 1
    }
    return r
}

// a -= b (a >= b)
int big_sub(u64* a, int an, u64* b, int bn) {
    u64 borrow = cast<u64>(0)
    for i in 0..an {
        u64 bi = cast<u64>(0)
        if i < bn { bi = b[i] }
        u64 sub = bi + borrow
        if a[i] >= sub { a[i] = a[i] - sub; borrow = cast<u64>(0) }
        else { a[i] = a[i] + (lo32() + cast<u64>(1)) - sub; borrow = cast<u64>(1) }
    }
    return big_trim(a, an)
}

int big_pow10(u64* a, int n, int s) {
    while s >= 9 { n = big_mul_small(a, n, cast<u64>(1000000000)); s -= 9 }
    while s > 0 { n = big_mul_small(a, n, cast<u64>(10)); s -= 1 }
    return n
}

int floor_div(int a, int b) {
    int q = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) { q -= 1 }
    return q
}

// v > 0 (finite) rounded to 6 significant digits, exactly, ties to even: writes the 6
// digits to `dig` and returns the decimal exponent of the first one.
int exact_digits(f64 v, u8* dig) {
    if big_n == null { big_n = cast<u64*>(malloc(8 * BIG())); big_d = cast<u64*>(malloc(8 * BIG())); big_t = cast<u64*>(malloc(8 * BIG())) }
    f64 vv = v
    u64 bits = cast<u64>(0)
    memcpy(cast<u8*>(&bits), cast<u8*>(&vv), 8)
    u64 one = cast<u64>(1)
    int ex = cast<int>((bits >> cast<u64>(52)) & cast<u64>(2047))
    u64 m = bits & ((one << cast<u64>(52)) - one)
    int e = 0 - 1074
    if ex != 0 { m = m | (one << cast<u64>(52)); e = ex - 1075 }
    // v = m * 2^e; its decimal exponent, estimated from its bit length (off by 1 at most)
    int bl = 0
    u64 t = m
    while t != cast<u64>(0) { bl += 1; t = t >> one }
    int x = floor_div((e + bl - 1) * 30103, 100000)
    int q = 0
    int nl = 0
    int dl = 0
    int tries = 0
    bool done = false
    while !done && tries < 4 {
        // q = floor(v * 10^(5 - x)), and the remainder, as N / D
        int s = 5 - x
        nl = big_set(big_n, m)
        dl = big_set(big_d, one)
        if e >= 0 { nl = big_shl(big_n, nl, e) } else { dl = big_shl(big_d, dl, 0 - e) }
        if s >= 0 { nl = big_pow10(big_n, nl, s) } else { dl = big_pow10(big_d, dl, 0 - s) }
        q = 0
        int b = 20
        while b >= 0 {
            for i in 0..dl { big_t[i] = big_d[i] }
            int tl = big_shl(big_t, dl, b)
            if big_cmp(big_n, nl, big_t, tl) >= 0 {
                nl = big_sub(big_n, nl, big_t, tl)
                q += 1 << b
            }
            b -= 1
        }
        if q < 100000 { x -= 1 } else if q >= 1000000 { x += 1 } else { done = true }
        tries += 1
    }
    // round: compare the remainder (times 2) with D; a tie goes to the even neighbour
    nl = big_shl(big_n, nl, 1)
    int c = big_cmp(big_n, nl, big_d, dl)
    if c > 0 || (c == 0 && q % 2 == 1) { q += 1 }
    if q == 1000000 { q = 100000; x += 1 }
    int k = 5
    while k >= 0 {
        dig[k] = cast<u8>(cast<int>('0') + q % 10)
        q = q / 10
        k -= 1
    }
    dig[6] = cast<u8>(0)
    return x
}

// v as C's printf "%g" writes it: 6 significant digits (exactly rounded, above), the
// shorter of fixed and exponent notation, trailing zeros dropped, an exponent of 2 digits
// at least.
export void srt_print_f64(f64 v) {
    u8* b = scratch()
    int o = 0
    f64 zero = 0.0
    if v != v {
        o = put(b, o, 'n'); o = put(b, o, 'a'); o = put(b, o, 'n')
    } else {
        bool neg = v < zero || (v == zero && 1.0 / v < zero)
        if neg { o = put(b, o, '-'); v = zero - v }
        if v - v != zero {
            o = put(b, o, 'i'); o = put(b, o, 'n'); o = put(b, o, 'f')
        } else if v == zero {
            o = put(b, o, '0')
        } else {
            u8* digbuf = &b[64]   // (the digits live in the buffer's far end)
            int x = exact_digits(v, digbuf)
            string dig = cast<string>(digbuf)
            int nd = 6
            while nd > 1 && dig[nd - 1] == '0' { nd -= 1 }
            if x < 0 - 4 || x >= 6 {
                o = put(b, o, dig[0])
                if nd > 1 {
                    o = put(b, o, '.')
                    for i in 1..nd { o = put(b, o, dig[i]) }
                }
                o = put(b, o, 'e')
                if x < 0 { o = put(b, o, '-'); x = 0 - x } else { o = put(b, o, '+') }
                if x < 10 { o = put(b, o, '0') }
                o = o + fmt_int(&b[o], x)
            } else if x >= 0 {
                for i in 0..(x + 1) {
                    if i < nd { o = put(b, o, dig[i]) } else { o = put(b, o, '0') }
                }
                if nd > x + 1 {
                    o = put(b, o, '.')
                    for i in (x + 1)..nd { o = put(b, o, dig[i]) }
                }
            } else {
                o = put(b, o, '0')
                o = put(b, o, '.')
                for i in 0..(0 - x - 1) { o = put(b, o, '0') }
                for i in 0..nd { o = put(b, o, dig[i]) }
            }
        }
    }
    b[o] = cast<u8>(0)
    puts(cast<string>(b))
}

// ---- files and arguments -------------------------------------------------------------------

export string srt_read_file(string path) {
    u8* f = fopen(path, "rb")
    if f == null { return "" }
    fseek(f, 0, 2)
    i32 size = ftell(f)
    fseek(f, 0, 0)
    if size < 0 { fclose(f); return "" }
    u8* buf = pool_alloc(&strs, cast<int>(size) + 1)
    int got = fread(buf, 1, cast<int>(size), f)
    fclose(f)
    buf[got] = cast<u8>(0)
    len_put(buf, got)
    return cast<string>(buf)
}

export bool srt_write_file(string path, string data) {
    u8* f = fopen(path, "wb")
    if f == null { return false }
    int len = str_length(data)
    int wrote = 0
    if len > 0 { wrote = fwrite(bytes(data), 1, len, f) }
    fclose(f)
    return wrote == len
}

global i32 argc_v
global string* argv_v

export void srt_set_args(i32 argc, string* argv) {
    argc_v = argc
    argv_v = argv
}

// ---- dynamic arrays -----------------------------------------------------------------------------
// The layout of lib/sarr.h: data, len, cap, element size.

struct ArrayRep { u8* data; int len; int cap; int elem }

// Every array buffer is tracked (lib/sarr.h does the same): a 16-byte link before its
// bytes, in one ring, so a host resetting the compiler (strata_host_reset) frees them all.
struct ArrLink { ArrLink* prev; ArrLink* next }

global ArrLink arr_ring     // the ring's anchor (empty: points at itself; zero: not set up)

void arr_link(ArrLink* h) {
    if arr_ring.next == null { arr_ring.next = &arr_ring; arr_ring.prev = &arr_ring }
    h.prev = &arr_ring
    h.next = arr_ring.next
    arr_ring.next.prev = h
    arr_ring.next = h
}

void arr_unlink(ArrLink* h) {
    h.prev.next = h.next
    h.next.prev = h.prev
}

ArrLink* arr_header(u8* data) { return cast<ArrLink*>(cast<int>(data) - 16) }
u8* arr_bytes(ArrLink* h) { return cast<u8*>(cast<int>(h) + 16) }

// a tracked buffer of n bytes for an array (its old buffer, if any, moved into it)
u8* arr_alloc(u8* old, int n) {
    ArrLink* h = null
    if old == null { h = cast<ArrLink*>(malloc(16 + n)) }
    else {
        ArrLink* o = arr_header(old)
        arr_unlink(o)
        h = cast<ArrLink*>(realloc(cast<u8*>(o), 16 + n))
    }
    arr_link(h)
    return arr_bytes(h)
}

export void srt_arr_push(ArrayRep* a, u8* value) {
    if a.len == a.cap {
        int nc = 8
        if a.cap > 0 { nc = a.cap * 2 }
        a.data = arr_alloc(a.data, nc * a.elem)
        a.cap = nc
    }
    memcpy(&a.data[a.len * a.elem], value, a.elem)
    a.len = a.len + 1
}

export void srt_args(ArrayRep* out) {
    out.data = null
    out.len = 0
    out.cap = 0
    out.elem = 8
    for i in 0..cast<int>(argc_v) {
        string s = argv_v[i]
        srt_arr_push(out, cast<u8*>(&s))
    }
}

// ---- matrices and quaternions ----------------------------------------------------------------
// The formulas of lib/smath.h, operation for operation (so the results are the same bits).
// A mat4 is 16 floats, column-major; these work on it as a float array.

float* fl(mat4* m) { return cast<float*>(m) }

void set_identity(float* m) {
    for i in 0..16 { m[i] = 0.0 }
    m[0] = 1.0
    m[5] = 1.0
    m[10] = 1.0
    m[15] = 1.0
}

export void srt_mat4_identity(mat4* r) {
    mat4 t
    set_identity(fl(&t))
    *r = t
}

export void srt_mat4_mul(mat4* r, mat4* a, mat4* b) {
    mat4 t
    float* x = fl(a)
    float* y = fl(b)
    float* o = fl(&t)
    for c in 0..4 {
        for row in 0..4 {
            float s = 0.0
            for k in 0..4 { s += x[k * 4 + row] * y[c * 4 + k] }
            o[c * 4 + row] = s
        }
    }
    *r = t
}

export void srt_mat4_mul_vec4(vec4* r, mat4* m, vec4* v) {
    float* a = fl(m)
    vec4 w = *v
    vec4 t
    t.x = a[0] * w.x + a[4] * w.y + a[8] * w.z + a[12] * w.w
    t.y = a[1] * w.x + a[5] * w.y + a[9] * w.z + a[13] * w.w
    t.z = a[2] * w.x + a[6] * w.y + a[10] * w.z + a[14] * w.w
    t.w = a[3] * w.x + a[7] * w.y + a[11] * w.z + a[15] * w.w
    *r = t
}

export void srt_mat4_translate(mat4* r, vec3* v) {
    mat4 t
    float* m = fl(&t)
    set_identity(m)
    m[12] = v.x
    m[13] = v.y
    m[14] = v.z
    *r = t
}

export void srt_mat4_scale(mat4* r, vec3* v) {
    mat4 t
    float* m = fl(&t)
    set_identity(m)
    m[0] = v.x
    m[5] = v.y
    m[10] = v.z
    *r = t
}

export void srt_mat4_rotate(mat4* r, vec3* axis, float angle) {
    vec3 a = normalize(*axis)
    float c = cosf(angle)
    float s = sinf(angle)
    float one = 1.0
    float t = one - c
    mat4 res
    float* m = fl(&res)
    set_identity(m)
    m[0] = t * a.x * a.x + c
    m[4] = t * a.x * a.y - s * a.z
    m[8] = t * a.x * a.z + s * a.y
    m[1] = t * a.x * a.y + s * a.z
    m[5] = t * a.y * a.y + c
    m[9] = t * a.y * a.z - s * a.x
    m[2] = t * a.x * a.z - s * a.y
    m[6] = t * a.y * a.z + s * a.x
    m[10] = t * a.z * a.z + c
    *r = res
}

export void srt_mat4_perspective(mat4* r, float fovy, float aspect, float znear, float zfar) {
    float one = 1.0
    float half = 0.5
    float two = 2.0
    float f = one / tanf(fovy * half)
    mat4 res
    float* m = fl(&res)
    m[0] = f / aspect
    m[5] = f
    m[10] = (zfar + znear) / (znear - zfar)
    m[11] = 0.0 - one
    m[14] = (two * zfar * znear) / (znear - zfar)
    *r = res
}

export void srt_mat4_look_at(mat4* r, vec3* eye, vec3* center, vec3* up) {
    vec3 e = *eye
    vec3 f = normalize(*center - e)
    vec3 s = normalize(cross(f, *up))
    vec3 u = cross(s, f)
    float zero = 0.0
    mat4 res
    float* m = fl(&res)
    set_identity(m)
    m[0] = s.x
    m[4] = s.y
    m[8] = s.z
    m[1] = u.x
    m[5] = u.y
    m[9] = u.z
    m[2] = zero - f.x
    m[6] = zero - f.y
    m[10] = zero - f.z
    m[12] = zero - dot(s, e)
    m[13] = zero - dot(u, e)
    m[14] = dot(f, e)
    *r = res
}

export void srt_quat_identity(quat* r) {
    quat q
    q.w = 1.0
    *r = q
}

export void srt_quat_mul(quat* r, quat* pa, quat* pb) {
    quat a = *pa
    quat b = *pb
    quat q
    q.x = a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y
    q.y = a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x
    q.z = a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
    q.w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    *r = q
}

export void srt_quat_axis_angle(quat* r, vec3* axis, float angle) {
    vec3 a = normalize(*axis)
    float half = 0.5
    float h = angle * half
    float s = sinf(h)
    quat q
    q.x = a.x * s
    q.y = a.y * s
    q.z = a.z * s
    q.w = cosf(h)
    *r = q
}

export void srt_quat_normalize(quat* r, quat* p) {
    quat q = *p
    float l = length(vec4(q.x, q.y, q.z, q.w))
    float zero = 0.0
    if l == zero { *r = q; return }
    quat n
    n.x = q.x / l
    n.y = q.y / l
    n.z = q.z / l
    n.w = q.w / l
    *r = n
}

export void srt_quat_rotate(vec3* r, quat* p, vec3* pv) {
    quat q = *p
    vec3 v = *pv
    vec3 u = vec3(q.x, q.y, q.z)
    float two = 2.0
    vec3 t = cross(u, v) * two
    vec3 res = (v + t * q.w) + cross(u, t)
    *r = res
}

export void srt_quat_to_mat4(mat4* r, quat* p) {
    quat q = *p
    float x = q.x
    float y = q.y
    float z = q.z
    float w = q.w
    float one = 1.0
    float two = 2.0
    mat4 res
    float* m = fl(&res)
    set_identity(m)
    m[0] = one - two * (y * y + z * z)
    m[4] = two * (x * y - w * z)
    m[8] = two * (x * z + w * y)
    m[1] = two * (x * y + w * z)
    m[5] = one - two * (x * x + z * z)
    m[9] = two * (y * z - w * x)
    m[2] = two * (x * z - w * y)
    m[6] = two * (y * z + w * x)
    m[10] = one - two * (x * x + y * y)
    *r = res
}

// ---- the host functions (the compiler's src/host.strata) ----------------------------------------
// What the compiler, built natively, asks of whatever hosts it: the `strata_*` functions
// that src/strata_host.h gives its C build, here in Strata on top of msvcrt / kernel32,
// with the same behavior (lib/crossplatform.h's Windows code, line for line).

global bool capturing
global u8* cap_buf
global int cap_len
global int cap_size

export void strata_report(string msg) {
    if !capturing { puts(msg); return }
    int n = strlen(msg)
    if cap_len + n + 2 > cap_size {
        int size = cap_size
        if size == 0 { size = 256 }
        while cap_len + n + 2 > size { size = size * 2 }
        cap_buf = realloc(cap_buf, size)
        cap_size = size
    }
    memcpy(&cap_buf[cap_len], bytes(msg), n)
    cap_len = cap_len + n
    cap_buf[cap_len] = cast<u8>(10)
    cap_len = cap_len + 1
    cap_buf[cap_len] = cast<u8>(0)
}

export void strata_capture_begin() {
    capturing = true
    cap_len = 0
    if cap_buf != null { cap_buf[0] = cast<u8>(0) }
}
export void strata_capture_end() { capturing = false }
export string strata_capture_text() {
    if cap_buf == null { return "" }
    return cast<string>(cap_buf)
}

// stdout: msvcrt's FILE array, entry 1 (a FILE is 48 bytes)
u8* stdout_file() { return cast<u8*>(cast<int>(__iob_func()) + 48) }

export void strata_print_raw(string text) {
    int n = strlen(text)
    if n > 0 { fwrite(bytes(text), 1, n, stdout_file()) }
}

export string strata_join(ArrayRep* parts) {
    string* p = cast<string*>(parts.data)
    int total = 0
    for i in 0..parts.len { total = total + str_length(p[i]) }
    u8* r = pool_alloc(&strs, total + 1)
    int at = 0
    for i in 0..parts.len {
        int n = str_length(p[i])
        memcpy(&r[at], bytes(p[i]), n)
        at = at + n
    }
    len_put(r, total)
    return cast<string>(r)
}

export string strata_host_os() { return "windows" }
export string strata_host_arch() { return "x86_64" }

export string strata_getenv(string name) {
    string v = getenv(name)
    if cast<u8*>(v) == null { return "" }
    return v
}

export string strata_cc() {
    string cc = strata_getenv("STRATA_CC")
    if cc != "" { return cc }
    return "gcc"
}

// the path of a loaded module (null: the exe), as a runtime string ("" on failure)
string module_path(u8* module) {
    u8* buf = pool_alloc(&strs, 4096)
    u32 n = GetModuleFileNameA(module, buf, cast<u32>(4096))
    if n == cast<u32>(0) || n >= cast<u32>(4096) { return "" }
    return cast<string>(buf)
}

export string strata_exe_path() { return module_path(null) }

export int strata_cpu_count() {
    string n = getenv("NUMBER_OF_PROCESSORS")
    int v = 0
    if cast<u8*>(n) != null {
        u8* b = bytes(n)
        int i = 0
        while b[i] >= cast<u8>('0') && b[i] <= cast<u8>('9') {
            v = v * 10 + (cast<int>(b[i]) - cast<int>('0'))
            i += 1
        }
    }
    if v > 0 { return v }
    return 1
}

// ---- files

u32 no_file() { return cast<u32>(4294967295) }   // INVALID_FILE_ATTRIBUTES

export bool strata_file_exists(string path) {
    if strlen(path) == 0 { return false }
    return GetFileAttributesA(path) != no_file()
}

bool is_directory(string path) {
    if strlen(path) == 0 { return false }
    u32 a = GetFileAttributesA(path)
    return a != no_file() && (a & cast<u32>(16)) != cast<u32>(0)
}

bool is_sep(u8 c) { return c == cast<u8>('/') || c == cast<u8>('\\') }

// make each parent in turn ("a", "a/b", ...), then the folder itself
export bool strata_make_dirs(string path) {
    int n = strlen(path)
    if n == 0 { return false }
    if is_directory(path) { return true }
    u8* p = pool_alloc(&strs, n + 1)
    memcpy(p, bytes(path), n)
    int start = 0
    if n >= 2 && p[1] == cast<u8>(':') { start = 2 }                 // C:\...
    else if n >= 2 && is_sep(p[0]) && is_sep(p[1]) {                  // \\server\share\...
        int seps = 0
        start = 2
        while start < n && seps < 2 {
            if is_sep(p[start]) { seps += 1 }
            start += 1
        }
    }
    bool going = true
    int i = start + 1
    while going && i <= n {
        if i == n || is_sep(p[i]) {
            u8 saved = p[i]
            p[i] = cast<u8>(0)
            if !is_directory(cast<string>(p)) && _mkdir(cast<string>(p)) != 0 && !is_directory(cast<string>(p)) { going = false }
            p[i] = saved
        }
        i += 1
    }
    return is_directory(cast<string>(p))
}

export bool strata_write_bytes(string path, ArrayRep* b) {
    u8* f = fopen(path, "wb")
    if f == null { return false }
    int w = 0
    if b.len > 0 { w = fwrite(b.data, 1, b.len, f) }
    fclose(f)
    return w == b.len
}

export u8[dynamic] strata_read_bytes(string path) {
    u8[dynamic] a = []
    u8* f = fopen(path, "rb")
    if f == null { return a }
    fseek(f, 0, 2)
    i32 size = ftell(f)
    fseek(f, 0, 0)
    if size > 0 {
        ArrayRep* r = cast<ArrayRep*>(&a)
        r.data = arr_alloc(null, cast<int>(size))
        r.cap = cast<int>(size)
        r.len = fread(r.data, 1, cast<int>(size), f)
    }
    fclose(f)
    return a
}

export string strata_bytes_cstr(ArrayRep* b, int at, int max) {
    int n = 0
    while n < max && at + n < b.len && b.data[at + n] != cast<u8>(0) { n += 1 }
    u8* r = pool_alloc(&strs, n + 1)
    if n > 0 { memcpy(r, &b.data[at], n) }
    return cast<string>(r)
}

// A decimal literal's IEEE bits, correctly rounded (ties to even), as an assembler's
// .float / .double stores them. (msvcrt's strtod isn't exact: subnormals come out wrong.)
// value = digits * 10^e10, as N / D with big integers; then the mantissa by long division.
global u64* pf_n
global u64* pf_d
global u64* pf_t

// limbs: 16,384 bits - 800 digits (any tie between two doubles has at most 767), any
// exponent that isn't plainly 0 or infinity
int PF() { return 512 }

int digit_of(u8 c) { return cast<int>(c) - cast<int>('0') }
bool is_digit(u8 c) { return c >= cast<u8>('0') && c <= cast<u8>('9') }

// a = a * k + add
int big_mul_add(u64* a, int n, u64 k, u64 add) {
    u64 carry = add
    for i in 0..n {
        u64 x = a[i] * k + carry
        a[i] = x & lo32()
        carry = x >> cast<u64>(32)
    }
    if carry != cast<u64>(0) { a[n] = carry; n += 1 }
    return n
}

// width: 64 / 32 bits; mant: mantissa bits (52 / 23); emin / emax: the exponent range
// (-1022..1023 / -126..127)
int float_bits(string text, int width, int mant, int emin, int emax) {
    if pf_n == null { pf_n = cast<u64*>(malloc(8 * PF())); pf_d = cast<u64*>(malloc(8 * PF())); pf_t = cast<u64*>(malloc(8 * PF())) }
    u8* s = bytes(text)
    u64 one = cast<u64>(1)
    int i = 0
    bool neg = false
    if s[i] == cast<u8>('-') { neg = true; i += 1 } else if s[i] == cast<u8>('+') { i += 1 }
    int expbits = width - 1 - mant               // 11 / 8: the exponent field's width
    u64 signbit = cast<u64>(0)
    if neg { signbit = one << cast<u64>(width - 1) }
    // digits (at most 800 kept; a nonzero digit beyond them is a "sticky" bit: since a
    // tie needs at most 767 digits, the truncated value rounds the same way)
    int nl = big_set(pf_n, cast<u64>(0))
    int kept = 0
    int e10 = 0
    bool sticky = false
    bool frac = false
    bool going = true
    while going {
        u8 c = s[i]
        if is_digit(c) {
            if kept < 800 {
                if kept > 0 || c != cast<u8>('0') {      // (leading zeros aren't digits)
                    nl = big_mul_add(pf_n, nl, cast<u64>(10), cast<u64>(digit_of(c)))
                    kept += 1
                }
                if frac { e10 -= 1 }
            } else {
                if c != cast<u8>('0') { sticky = true }
                if !frac { e10 += 1 }
            }
            i += 1
        } else if c == cast<u8>('.') && !frac {
            frac = true
            i += 1
        } else {
            going = false
        }
    }
    if s[i] == cast<u8>('e') || s[i] == cast<u8>('E') {
        i += 1
        bool eneg = false
        if s[i] == cast<u8>('-') { eneg = true; i += 1 } else if s[i] == cast<u8>('+') { i += 1 }
        int ev = 0
        while is_digit(s[i]) { if ev < 100000 { ev = ev * 10 + digit_of(s[i]) }; i += 1 }
        if eneg { e10 -= ev } else { e10 += ev }
    }
    u64 infbits = ((one << cast<u64>(expbits)) - one) << cast<u64>(mant)
    if kept == 0 { return cast<int>(signbit) }                       // zero
    if e10 + kept > 400 { return cast<int>(signbit | infbits) }      // overflows
    if e10 + kept < 0 - 400 { return cast<int>(signbit) }            // underflows to zero
    int dl = big_set(pf_d, one)
    if e10 >= 0 { nl = big_pow10(pf_n, nl, e10) } else { dl = big_pow10(pf_d, dl, 0 - e10) }
    // e = floor(log2(N / D)), from the bit lengths (then corrected)
    int e = big_bits(pf_n, nl) - big_bits(pf_d, dl)
    if !big_ge_shifted(pf_n, nl, pf_d, dl, e) { e -= 1 }
    if e < emin { e = emin }                                         // subnormal
    // q = floor(N / D * 2^(mant - e)): mant + 1 bits (or fewer, subnormal)
    int shift = mant - e
    if shift >= 0 { nl = big_shl(pf_n, nl, shift) } else { dl = big_shl(pf_d, dl, 0 - shift) }
    u64 q = cast<u64>(0)
    int b = mant + 1
    while b >= 0 {
        for k in 0..dl { pf_t[k] = pf_d[k] }
        int tl = big_shl(pf_t, dl, b)
        if big_cmp(pf_n, nl, pf_t, tl) >= 0 {
            nl = big_sub(pf_n, nl, pf_t, tl)
            q = q | (one << cast<u64>(b))
        }
        b -= 1
    }
    // round: the remainder times 2 against D; a tie goes to even (or up, if sticky)
    nl = big_shl(pf_n, nl, 1)
    int c = big_cmp(pf_n, nl, pf_d, dl)
    if c > 0 || (c == 0 && (sticky || (q & one) == one)) { q = q + one }
    if q == (one << cast<u64>(mant + 1)) { q = q >> one; e += 1 }
    if e > emax { return cast<int>(signbit | infbits) }
    u64 hidden = one << cast<u64>(mant)
    if q < hidden { return cast<int>(signbit | q) }                  // subnormal: exponent field 0
    u64 field = cast<u64>(e - emin + 1)
    return cast<int>(signbit | (field << cast<u64>(mant)) | (q - hidden))
}

// the number of significant bits of a big integer
int big_bits(u64* a, int n) {
    int top = n - 1
    u64 x = a[top]
    int bits = 32 * top
    while x != cast<u64>(0) { bits += 1; x = x >> cast<u64>(1) }
    return bits
}

// N >= D * 2^e ? (e may be negative: then N * 2^-e >= D)
bool big_ge_shifted(u64* n, int nl, u64* d, int dl, int e) {
    u64* t = pf_t
    if e >= 0 {
        for k in 0..dl { t[k] = d[k] }
        int tl = big_shl(t, dl, e)
        return big_cmp(n, nl, t, tl) >= 0
    }
    for k in 0..nl { t[k] = n[k] }
    int tl = big_shl(t, nl, 0 - e)
    return big_cmp(t, tl, d, dl) >= 0
}

export int strata_f32_bits(string text) { return float_bits(text, 32, 23, 0 - 126, 127) }
export int strata_f64_bits(string text) { return float_bits(text, 64, 52, 0 - 1022, 1023) }

// ---- memory

export void strata_array_free(u8* array) {
    ArrayRep* a = cast<ArrayRep*>(array)
    if a.data != null {
        ArrLink* h = arr_header(a.data)
        arr_unlink(h)
        free(cast<u8*>(h))
    }
    a.data = null
    a.len = 0
    a.cap = 0
}

export void strata_host_reset() {
    if arr_ring.next != null {           // every array buffer
        ArrLink* h = arr_ring.next
        while h != &arr_ring {
            ArrLink* n = h.next
            free(cast<u8*>(h))
            h = n
        }
        arr_ring.next = &arr_ring
        arr_ring.prev = &arr_ring
    }
    if len_cap > 0 { memset(cast<u8*>(len_keys), 0, 8 * len_cap) }
    len_count = 0
    srt_arena_free(&strs)
    srt_arena_free(&heap)
}

// ---- running programs
// msvcrt's _spawnvp joins argv into one command line WITHOUT quoting, and the program
// splits it again; so quote each argument the way the C runtime parses them back.

string quote_arg(string a) {
    int n = strlen(a)
    u8* s = bytes(a)
    bool needs = n == 0
    for i in 0..n {
        u8 c = s[i]
        if c == cast<u8>(' ') || c == cast<u8>(9) || c == cast<u8>(10) || c == cast<u8>(11) || c == cast<u8>('"') { needs = true }
    }
    if !needs { return a }
    u8* q = pool_alloc(&strs, n * 2 + 3)
    int o = 0
    int slashes = 0
    q[o] = cast<u8>('"'); o += 1
    for i in 0..n {
        u8 c = s[i]
        if c == cast<u8>('\\') {
            slashes += 1
            q[o] = c; o += 1
        } else {
            if c == cast<u8>('"') {          // double the backslashes, escape the quote
                for k in 0..slashes { q[o] = cast<u8>('\\'); o += 1 }
                q[o] = cast<u8>('\\'); o += 1
            }
            slashes = 0
            q[o] = c; o += 1
        }
    }
    for k in 0..slashes { q[o] = cast<u8>('\\'); o += 1 }    // backslashes before the closing quote
    q[o] = cast<u8>('"'); o += 1
    q[o] = cast<u8>(0)
    return cast<string>(q)
}

// start argv[0..n) (no wait); 0 if it couldn't be started
int start_process(string* argv, int n) {
    if n < 1 { return 0 }
    string* quoted = cast<string*>(malloc(8 * (n + 1)))
    for i in 0..n { quoted[i] = quote_arg(argv[i]) }
    quoted[n] = cast<string>(null)
    fflush(null)
    int h = _spawnvp(1, argv[0], quoted)      // _P_NOWAIT
    free(cast<u8*>(quoted))
    if h == 0 - 1 { return 0 }
    return h
}

int wait_process(int h) {
    if h == 0 { return 0 - 1 }
    i32 status = 0
    if _cwait(&status, h, 0) == 0 - 1 { return 0 - 1 }
    return cast<int>(status)
}

void report_no_start(string program) {
    if program == strata_cc() {
        strata_report("error: could not start the C compiler '" + program + "' (is it installed and on PATH? STRATA_CC picks another)")
    } else {
        strata_report("error: could not start '" + program + "'")
    }
}

export int strata_run_argv(ArrayRep* argv) {
    if argv.len < 1 { return 0 - 1 }
    string* a = cast<string*>(argv.data)
    int h = start_process(a, argv.len)
    if h == 0 { report_no_start(a[0]); return 0 - 1 }
    return wait_process(h)
}

// `<cc> @file` for each response file, up to `jobs` at a time; how many failed
export int strata_run_cc_parallel(ArrayRep* rsp_files, int jobs) {
    string* f = cast<string*>(rsp_files.data)
    int n = rsp_files.len
    if jobs < 1 { jobs = 1 }
    int* p = cast<int*>(malloc(8 * (n + 1)))
    int failed = 0
    int waited = 0
    bool reported = false
    string cc = strata_cc()
    for i in 0..n {
        while i - waited >= jobs {                 // window full: wait for the oldest
            if p[waited] == 0 || wait_process(p[waited]) != 0 { failed += 1 }
            waited += 1
        }
        string[dynamic] argv = [cc, "@" + f[i]]
        p[i] = start_process(cast<string*>(cast<ArrayRep*>(&argv).data), 2)
        if p[i] == 0 && !reported { report_no_start(cc); reported = true }
    }
    while waited < n {
        if p[waited] == 0 || wait_process(p[waited]) != 0 { failed += 1 }
        waited += 1
    }
    free(cast<u8*>(p))
    return failed
}

// ---- the runtime lib/ folder

global string libdir_set

export void strata_host_set_libdir(string dir) { libdir_set = dir }

// the exe or dll this code is in (the one holding this runtime's globals)
u8* this_module() {
    u8* m = null
    // 4 | 2: GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | ..._UNCHANGED_REFCOUNT
    if GetModuleHandleExA(cast<u32>(6), cast<u8*>(&libdir_set), &m) == 0 { return null }
    return m
}

// The host's choice; else lib/ next to the module this code is in (the exe, or libstrata.dll
// for an engine), or one level up (the repo layout: bin/../lib); else "lib".
export string strata_host_libdir() {
    if cast<u8*>(libdir_set) != null && libdir_set != "" { return libdir_set }
    string path = module_path(this_module())
    int cut = 0 - 1
    u8* b = bytes(path)
    for i in 0..strlen(path) { if is_sep(b[i]) { cut = i } }
    if cut >= 0 {
        string dir = srt_str_sub(path, 0, cut)
        string probe = dir + "/lib"
        if strata_file_exists(probe + "/arena.h") { libdir_set = probe; return probe }
        probe = dir + "/../lib"
        if strata_file_exists(probe + "/arena.h") { libdir_set = probe; return probe }
    }
    return "lib"
}
