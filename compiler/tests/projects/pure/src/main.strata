// pure - the native backend on a multi-module project
import geo

var bodies = [Body{ vec3(0, 0, 0), vec3(1, 2, 2), 2.0 }, Body{ vec3(5, 5, 5), vec3(0, 0, 1), 4.0 }]
for i in 0..10 {
    for k in 0..bodies.len { bodies[k] = step(bodies[k], 0.5) }
}
print(bodies[0].pos.x)
print(bodies[1].pos.z)
print(energy(bodies[0]) + energy(bodies[1]))
print(shape_name(Box) + "/" + shape_name(Ball))

int made = 0
region frame {
    for i in 0..100 {
        var b = frame.new(Body)
        b.mass = cast<float>(i)
        made += 1
    }
}
print(made)
