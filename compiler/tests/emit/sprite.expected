// Generated by stratac. Do not edit.
#define STRATA_PROGRAM 1
#include <stdint.h>
#include <stdbool.h>
#include <stdio.h>
#include <arena.h>
#include <smath.h>
#include <sstr.h>
#include <sio.h>
#include <sarr.h>
#include <sprelude.h>
#include <raylib.h>



int main(int strata_argc_, char** strata_argv_) {
    strata_set_args(strata_argc_, strata_argv_);
    InitWindow(800, 450, "Strata - move the circle (arrow keys)");
    SetTargetFPS(60);
    vec2 pos = (vec2){400, 225};
    float speed = 260.0;
    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        vec2 dir = (vec2){0, 0};
        if (IsKeyDown(KEY_RIGHT)) {
            dir = vec2_add(dir, (vec2){1, 0});
        }
        if (IsKeyDown(KEY_LEFT)) {
            dir = vec2_add(dir, (vec2){(-1), 0});
        }
        if (IsKeyDown(KEY_DOWN)) {
            dir = vec2_add(dir, (vec2){0, 1});
        }
        if (IsKeyDown(KEY_UP)) {
            dir = vec2_add(dir, (vec2){0, (-1)});
        }
        pos = vec2_add(pos, vec2_scale(vec2_scale(dir, speed), dt));
        BeginDrawing();
        ClearBackground(RAYWHITE);
        DrawCircle(pos.x, pos.y, 20.0, MAROON);
        DrawText("move with the arrow keys", 10, 10, 20, DARKGRAY);
        EndDrawing();
    }
    CloseWindow();
    return 0;
}
