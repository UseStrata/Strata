// crossplatform.strata - a native window from Strata, using lib/crossplatform.h
// (Win32 on Windows, Cocoa on macOS, X11 on Linux).
//
// import: the header's implementation switches on automatically in a Strata program,
//         and stratac links the OS library it calls into (user32 / Cocoa / X11).

import <crossplatform.h>

CreatePlatformWindow(800, 600, "Test Crossplatform Window")

var frames = 0
while PlatformPollEvents() == 1 {
    frames += 1
    if frames % 60 == 0 {
        // show the live client size in the title (it updates as you resize)
        PlatformSetWindowTitle("Strata window - " + int_to_str(PlatformGetWindowWidth()) + " x " + int_to_str(PlatformGetWindowHeight()))
    }
}
print("window closed after " + int_to_str(frames) + " frames")
