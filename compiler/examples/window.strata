// window.strata - a raylib window, written in Strata (milestone 3).
// no GC, single native binary (Strata's own backend). Build/run: stratac run window.strata
import raylib              // raylib, declared in raylib.strata

InitWindow(800, 450, "Strata - hello from a game language")
SetTargetFPS(60)

while !WindowShouldClose() {
    BeginDrawing()
    ClearBackground(RAYWHITE)
    DrawText("Hello from Strata!", 250, 200, 20, DARKGRAY)
    EndDrawing()
}

CloseWindow()
