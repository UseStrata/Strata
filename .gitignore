# --- build artifacts -------------------------------------------------------
# `stratac build/run` emit <stem>.c/.exe next to the .strata source. None of that is
# source; only the .strata files are.

# stratac output beside the compiler's own sources (build.ps1 builds src/stratac.strata)
compiler/src/*.c
compiler/src/*.exe
compiler/src/stratac
compiler/src/console

# build output of the test projects (tests/projects/*/build/)
compiler/tests/projects/*/build/
# embedding tests: host builds, the .NET project's output, the compiled test program
compiler/tests/embed/build/
compiler/tests/embed/csharp/bin/
compiler/tests/embed/csharp/obj/
compiler/tests/embed/prog/*.c
compiler/tests/embed/prog/*.s
compiler/tests/embed/prog/main

# stratac output beside example programs
compiler/examples/*.c
compiler/examples/*.exe
# (macOS / Linux programs have no extension: ignore everything but the sources)
compiler/examples/*
!compiler/examples/*.strata
!compiler/examples/*/


# build output directory (stratac.exe, console.exe, libstrata.dll, libstrata.c)
compiler/bin/
# the native backend's runtime object, compiled by build.ps1 from compiler/lib/srt.strata
compiler/lib/srt.o
# bootstrap: the cached pinned release + stage1/2 compilers (see compiler/build.ps1)
compiler/build/

# packaged release archives (uploaded to GitHub Releases, not committed)
compiler/dist/

# generic native/build leftovers
*.o
*.obj
*.dll
*.exe
*.pdb
*.ilk
*.exp
*.lib
*.so
*.dylib
*.dSYM/

# --- editor / OS -----------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*.user
Thumbs.db
.DS_Store
